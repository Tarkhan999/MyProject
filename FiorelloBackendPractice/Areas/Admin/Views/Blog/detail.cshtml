@model FiorelloBackendPractice.ViewModels.Blog.BlogDetailVM

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="card-title m-0">Blog Detayı (#@Model.Id)</h4>
            <a asp-action="Index" class="btn btn-secondary rounded-3"><i class="bi bi-arrow-left"></i> Geri Dön</a>
        </div>

        <div class="row">
            <div class="col-md-5">
                <img src="~/img/@Model.Image" class="img-fluid rounded-4 shadow-sm w-100" style="max-height:350px; object-fit:cover;" />
            </div>
            <div class="col-md-7">
                <h2 class="fw-bold text-primary mb-3">@Model.Title</h2>
                <div class="mb-3">
                    <span class="badge bg-success me-2"><i class="bi bi-calendar"></i> @Model.DateCreated.ToString("dd MMMM yyyy")</span>
                    <span class="badge bg-primary"><i class="bi bi-eye"></i> @Model.ViewsCount Okunma</span>
                </div>
                <h5 class="text-muted mb-3">Açıklama:</h5>
                <p class="fs-6 text-secondary">@Model.Description</p>

                <div class="mt-4 pt-3 border-top">
                    <p><strong>Yönlendirme Linki:</strong> <a href="@Model.Link" target="_blank" class="text-decoration-none">@Model.Link</a></p>
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning text-white rounded-3 mt-2"><i class="bi bi-pencil"></i> Bu Blogu Düzenle</a>
                </div>
            </div>
        </div>
    </div>
</div>