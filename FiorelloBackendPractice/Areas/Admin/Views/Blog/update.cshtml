@model FiorelloBackendPractice.ViewModels.Blog.BlogUpdateVM

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h4 class="card-title mb-4">Blog Düzenle</h4>

        <form asp-action="Update" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label class="d-block mb-2 text-muted small">Mevcut Görsel</label>
                <img src="~/img/@Model.Image" style="max-width:200px; border-radius:10px;" class="shadow-sm" />
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlık</label>
                <input asp-for="Title" class="form-control rounded-3" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control rounded-3" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Link" class="form-label">Link</label>
                <input asp-for="Link" class="form-control rounded-3" />
            </div>

            <div class="mb-4">
                <label asp-for="Photo" class="form-label">Yeni Görsel (Değiştirmeyecekseniz boş bırakın)</label>
                <input asp-for="Photo" class="form-control rounded-3" accept="image/*" />
                <span asp-validation-for="Photo" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-warning rounded-3 px-4 text-white">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary rounded-3 px-4 ms-2">İptal</a>
        </form>
    </div>
</div>