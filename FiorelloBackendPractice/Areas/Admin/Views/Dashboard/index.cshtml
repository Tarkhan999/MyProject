<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- Temiz ve performanslı kart efekti CSS'i -->
<style>
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
    }
</style>

<div class="container mt-5 mb-5">
    
    <!-- Karşılama Alanı (Hero Section) -->
    <div class="p-5 text-center bg-primary bg-opacity-10 rounded-4 border border-primary border-opacity-25 shadow-sm mb-5 position-relative overflow-hidden">
        <i class="bi bi-shield-lock-fill position-absolute text-primary opacity-25" style="font-size: 15rem; top: -40px; right: -20px; z-index: 0;"></i>
        
        <div class="position-relative" style="z-index: 1;">
            <div class="d-inline-block bg-white p-3 rounded-circle shadow-sm mb-3">
                <i class="bi bi-person-workspace text-primary" style="font-size: 2.5rem;"></i>
            </div>
            <h1 class="fw-bold text-dark mb-2">Admin Dashboard</h1>
            <p class="text-muted fs-5 mb-0">Welcome back! Here is what's happening with your store today.</p>
        </div>
    </div>

   <!-- Hızlı Erişim Kartları (Quick Actions) -->
    <div class="row g-4">
        
        <!-- Ürünler Yönetimi Kartı -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 px-2 py-3 transition-hover">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-4 me-3 text-success">
                        <i class="bi bi-box-seam fs-1"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Products</h4>
                        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="text-decoration-none text-muted stretched-link">
                            Manage Products <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Kategoriler Yönetimi Kartı -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 px-2 py-3 transition-hover">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-4 me-3 text-warning">
                        <i class="bi bi-tags fs-1"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Categories</h4>
                        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="text-decoration-none text-muted stretched-link">
                            Manage Categories <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Slider Yönetimi Kartı -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 px-2 py-3 transition-hover">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-4 me-3 text-danger">
                        <i class="bi bi-images fs-1"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Slider</h4>
                        <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="text-decoration-none text-muted stretched-link">
                            Manage Slider <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 px-2 py-3 transition-hover">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 p-3 rounded-4 me-3 text-info">
                        <i class="bi bi-info-square fs-1"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">About</h4>
                        <a asp-area="Admin" asp-controller="About" asp-action="Index" class="text-decoration-none text-muted stretched-link">
                            Manage About <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

      
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 px-2 py-3 transition-hover">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-secondary bg-opacity-10 p-3 rounded-4 me-3 text-secondary">
                        <i class="bi bi-person-badge fs-1"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Expert</h4>
                        <a asp-area="Admin" asp-controller="Expert" asp-action="Index" class="text-decoration-none text-muted stretched-link">
                            Manage Expert <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

       
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 px-2 py-3 transition-hover">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-4 me-3 text-primary">
                        <i class="bi bi-card-heading fs-1"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Subscribe Info</h4>
                        <a asp-area="Admin" asp-controller="SubscribeInfo" asp-action="Index" class="text-decoration-none text-muted stretched-link">
                            Manage Section <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

       
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 px-2 py-3 transition-hover">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-dark bg-opacity-10 p-3 rounded-4 me-3 text-dark">
                        <i class="bi bi-envelope-paper fs-1"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Subscribers</h4>
                        <a asp-area="Admin" asp-controller="Subscriber" asp-action="Index" class="text-decoration-none text-muted stretched-link">
                            Manage Subscribers <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>