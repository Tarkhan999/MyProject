@model IEnumerable<FiorelloBackendPractice.Models.About>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>About Bölümü Yönetimi</h2>
        <a asp-action="Create" class="btn btn-success">Yeni Ekle</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
        <tr>
            <th>Görsel</th>
            <th>Başlık</th>
            <th>Vurgulu Metin</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="~/img/@item.ImageUrl" style="width: 100px; height: 100px; object-fit: cover;" class="rounded" />
                </td>
                <td class="align-middle">@item.Title</td>
                <td class="align-middle">@item.HighlightedText</td>
                <td class="align-middle">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>