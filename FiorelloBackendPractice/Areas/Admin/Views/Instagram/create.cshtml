@model FiorelloBackendPractice.ViewModels.Instagram.InstagramCreateVM

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h4 class="card-title mb-4 fw-bold text-white">Yeni Instagram Görseli Ekle</h4>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            
            <div class="mb-4">
                <label asp-for="Photo" class="form-label text-light">Görsel Seç</label>
                <input asp-for="Photo" class="form-control rounded-3" accept="image/*" />
                <span asp-validation-for="Photo" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary rounded-3 px-4">Yükle ve Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary rounded-3 px-4 ms-2">İptal</a>
        </form>
    </div>
</div>