@model CategoryVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <!-- Detay Kartı -->
            <div class="card border-0 shadow-lg rounded-4 text-center overflow-hidden">
                
                <!-- Üst Dekorasyon Alanı -->
                <div class="bg-dark p-4">
                    <div class="bg-white d-inline-block rounded-circle p-3 shadow mt-3 mb-2">
                        <i class="bi bi-folder2-open text-dark" style="font-size: 3rem;"></i>
                    </div>
                </div>

                <!-- Bilgi Alanı -->
                <div class="card-body p-5">
                    <p class="text-uppercase tracking-wide text-muted fw-bold mb-2" style="letter-spacing: 2px; font-size: 0.85rem;">
                        Category Name
                    </p>
                    <h2 class="fw-bold text-dark mb-5">
                        @Model.Name
                    </h2>

                    <hr class="text-muted opacity-25 mb-4" />

                    <!-- Butonlar -->
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-pencil-square me-1"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            Back to List
                        </a>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>