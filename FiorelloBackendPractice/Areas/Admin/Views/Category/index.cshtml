@model IEnumerable<CategoryVM>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    
    <!-- Başlık ve Ekle Butonu Satırı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-tags me-2"></i>Categories
        </h2>
        <a class="btn btn-success rounded-pill px-4 shadow-sm" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> Add New Category
        </a>
    </div>

    <!-- Tablo Kartı -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 text-secondary">Category Name</th>
                        <th class="py-3 text-center text-secondary" style="width: 220px;">Actions</th> 
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Kategori Adı (Rozet Şeklinde) -->
                        <td class="px-4 py-3">
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 fs-6 fw-semibold">
                                <i class="bi bi-folder2-open me-2"></i>@item.Name
                            </span>
                        </td>
                        
                        <!-- Operasyonlar (İkonlu Buton Grubu) -->
                        <td class="text-center py-3">
                            <div class="btn-group shadow-sm rounded-pill" role="group">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark px-3" title="Detail">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Kategori Bulunmadığında Gösterilecektir -->
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-folder-x fs-1 mb-3 d-block text-secondary"></i>
                <h5>No categories found</h5>
                <p>Click the "Add New Category" button to create your first category.</p>
            </div>
        }
    </div>
</div>