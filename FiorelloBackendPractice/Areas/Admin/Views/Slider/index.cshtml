@model IEnumerable<SliderVM>

<div class="container mt-4">
    <h1 class="text-center">Categories</h1>
    <a class="btn btn-primary" asp-action="Create">Create</a>
    <div class="table-responsive mt-4">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Image</th>
                <th>Operations</th>
        
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="~/img/@item.Image"style="width: 150px;height: 150px"/></td>
                    <td>
                        <a asp-action="Detail"asp-route-id="@item.Id"class="btn btn-dark">Detail</a>
                        <a asp-action="Edit"asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                       
                        <button class="btn btn-danger delete-slider-btn" data-id="@item.Id">Delete</button>
                    </td>
       
                </tr>
            }

            </tbody>
        </table>
    </div>
</div>