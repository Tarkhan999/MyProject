@model SliderCreateVM


<div class="container mt-5" >
    
    <form method="post" asp-action="Create"enctype="multipart/form-data" class="forms-sample">
        <div class="form-group">
            <label >Name:</label>
            <input asp-for="UploadImage"  class="form-control" >
            <span asp-validation-for="UploadImage" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary me-2">Submit</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </form>
</div>