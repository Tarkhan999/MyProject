@model SliderCreateVM

<div class="container mt-5">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post" asp-action="Create" enctype="multipart/form-data" class="forms-sample">
        <div class="form-group mb-3">
            <label>Slider Resmi:</label>
            <input asp-for="UploadImage" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="UploadImage" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary me-2">Submit</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </form>
</div>