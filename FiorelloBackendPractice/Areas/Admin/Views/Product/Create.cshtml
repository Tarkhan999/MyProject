@model FiorelloBackendPractice.Views.Product.ProductCreateVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            
            <!-- Form Kartı -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                
                <!-- Kart Başlığı -->
                <div class="card-header bg-success bg-opacity-10 border-0 p-4 text-center">
                    <h3 class="fw-bold text-success mb-0">
                        <i class="bi bi-box-seam me-2"></i>Create New Product
                    </h3>
                </div>

                <!-- Form İçeriği -->
                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-action="Create" enctype="multipart/form-data">
                        
                        <div class="row g-4">
                            
                            <!-- Ürün Adı -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary">Product Name</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0">
                                        <i class="bi bi-tag"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="Enter product name">
                                </div>
                                <span class="text-danger small mt-1 d-block fw-semibold" asp-validation-for="Name"></span>
                            </div>

                            <!-- Fiyat -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary">Price ($)</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0">
                                        <i class="bi bi-currency-dollar"></i>
                                    </span>
                                    <!-- type="number" ve step="0.01" ile ondalıklı girişleri kolaylaştırıyoruz -->
                                    <input asp-for="Price" type="number" step="0.01" class="form-control border-start-0 ps-0" placeholder="0.00">
                                </div>
                                <span class="text-danger small mt-1 d-block fw-semibold" asp-validation-for="Price"></span>
                            </div>

                            <!-- Kategori Dropdown -->
                            <div class="col-md-12">
                                <label class="form-label fw-semibold text-secondary">Category</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0">
                                        <i class="bi bi-folder2-open"></i>
                                    </span>
                                    <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-select border-start-0 ps-0">
                                        <option value="">-- Select a Category --</option>
                                    </select>
                                </div>
                                <span class="text-danger small mt-1 d-block fw-semibold" asp-validation-for="CategoryId"></span>
                            </div>

                            <!-- Açıklama (Input yerine Textarea kullanmak çok daha şıktır) -->
                            <div class="col-md-12">
                                <label class="form-label fw-semibold text-secondary">Description</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0 align-items-start pt-2">
                                        <i class="bi bi-card-text"></i>
                                    </span>
                                    <textarea asp-for="Description" class="form-control border-start-0 ps-0" rows="4" placeholder="Enter product description..."></textarea>
                                </div>
                                <span class="text-danger small mt-1 d-block fw-semibold" asp-validation-for="Description"></span>
                            </div>

                            <!-- Resim Yükleme -->
                            <div class="col-md-12">
                                <label class="form-label fw-semibold text-secondary">Product Images</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-white text-muted border-end-0">
                                        <i class="bi bi-images"></i>
                                    </span>
                                    <!-- multiple ve accept özellikleri eklendi -->
                                    <input asp-for="Images" type="file" multiple accept="image/*" class="form-control border-start-0 ps-0">
                                </div>
                                <div class="form-text text-muted mt-2">
                                    <i class="bi bi-info-circle me-1"></i>You can select multiple images. The first image will be set as Main automatically.
                                </div>
                                <span asp-validation-for="Images" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                        </div>

                        <!-- İşlem Butonları -->
                        <div class="d-flex gap-3 mt-5">
                            <button type="submit" class="btn btn-success rounded-pill w-50 py-2 shadow-sm fw-bold">
                                <i class="bi bi-check2-circle me-1"></i> Create Product
                            </button>
                            <a asp-action="Index" class="btn btn-light rounded-pill w-50 py-2 text-dark fw-semibold border">
                                Cancel
                            </a>
                        </div>
                        
                    </form>
                </div>
                
            </div>
            
        </div>
    </div>
</div>