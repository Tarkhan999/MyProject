@model FiorelloBackendPractice.Views.Product.ProductDetailVM

<div class="container">
    <h1 class="text-center">Product Detail</h1>
    <div class="product-detail">
        <h1>@Model.Name</h1>
        <h4>@Model.Description</h4>
        <h4>@Model.Price</h4>
        <h4>@Model.CategoryName</h4>
        <div class="images">
            @foreach (var item in Model.Images)
            {
                <img class="@(item.IsMain ? "border border-success border-3":"") " src="~/img/@item.Image"  style="width: 150px; height: 150px"/>
            }
        </div>
       
    </div>
    <a asp-action="Index" class="btn btn-light">Cancel</a>
</div>