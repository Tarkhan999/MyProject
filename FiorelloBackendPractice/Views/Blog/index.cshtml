@model IEnumerable<BlogUIVM>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<section id="blog" class="py-5">
    <div class="container">

        <!-- Başlık ve Karşılama Alanı -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 fs-6 mb-3">
                    <i class="bi bi-journal-text me-1"></i> Our Journal
                </span>
                <h1 class="fw-bold text-dark display-5 mb-3">Blog Sayfasına Hoş Geldiniz</h1>
                <p class="text-muted fs-5 mb-0">En güncel haberler, tasarım fikirleri ve hikayelerimizle ilham alın.</p>
                <div class="mx-auto bg-primary rounded-pill mt-3" style="width: 60px; height: 4px;"></div>
            </div>
        </div>

        <!-- Blog Kartlarının Listelendiği Partial -->
        <partial name="_BlogPartial"/>

    </div>
</section>