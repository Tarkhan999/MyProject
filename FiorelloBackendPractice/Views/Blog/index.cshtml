@model IEnumerable<BlogUIVM>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- Sayfa Geneli Koyu Renk Kapsayıcısı -->
<div style="background-color: #0a0a0a; min-height: 100vh; padding-bottom: 5rem;">

    <!-- GÜZELLEŞTİRİLMİŞ ÜST KARŞILAMA ALANI (KOYU TEMA) -->
    <section id="blog-header" class="py-5 pt-5 position-relative overflow-hidden rounded-4 mx-3 shadow-lg" style="background-color: #161616; border: 1px solid #2a2a2a; margin-top: 2rem;">
        
        <!-- Dekoratif Arka Plan İkonları -->
        <div class="position-absolute top-0 start-0 translate-middle opacity-10" style="pointer-events: none;">
            <i class="bi bi-flower1" style="color: #ff4d6d; font-size: 15rem;"></i>
        </div>
        <div class="position-absolute bottom-0 end-0 translate-middle opacity-10" style="pointer-events: none;">
            <i class="bi bi-flower3" style="color: #ff4d6d; font-size: 15rem;"></i>
        </div>

        <div class="container position-relative z-1 py-4">
            <div class="row justify-content-center text-center">
                <div class="col-lg-8 col-md-10">
                    
                    <!-- Şık Badge -->
                    <div class="mb-4">
                        <span class="badge rounded-pill px-4 py-2 fs-6 shadow-sm" style="background-color: #2a1518; color: #ff4d6d; border: 1px solid #4a1f26; letter-spacing: 1px;">
                            <i class="bi bi-journal-richtext me-2"></i> Çiçeksi Hikayeler
                        </span>
                    </div>
                    
                    <!-- Ana Başlık -->
                    <h1 class="fw-bold text-white display-4 mb-4" style="letter-spacing: -1px;">
                        Blogumuza <span class="position-relative" style="color: #ff4d6d;">
                            Hoş Geldiniz
                            <!-- Alt Çizgi Efekti -->
                            <svg class="position-absolute w-100 h-100" style="left: 0; bottom: -10px; z-index: -1; opacity: 0.3;" viewBox="0 0 100 20" preserveAspectRatio="none">
                                <path d="M0 15 Q 50 0 100 15" fill="none" stroke="#ff4d6d" stroke-width="5"/>
                            </svg>
                        </span>
                    </h1>
                    
                    <!-- Alt Metin -->
                    <p class="fs-5 leading-relaxed mb-4 px-lg-5" style="color: #adb5bd;">
                        Çiçeklerin dili, en yeni aranjman fikirleri ve doğanın bize anlattığı birbirinden güzel hikayelerle ilham dolu bir yolculuğa çıkın.
                    </p>
                    
                    <!-- İkonlu Ayırıcı Çizgi -->
                    <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                        <div class="rounded-pill opacity-50" style="width: 50px; height: 3px; background-color: #ff4d6d;"></div>
                        <i class="bi bi-suit-heart-fill fs-6" style="color: #ff4d6d;"></i>
                        <div class="rounded-pill opacity-50" style="width: 50px; height: 3px; background-color: #ff4d6d;"></div>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- BLOG KARTLARININ LİSTELENDİĞİ ALAN -->
    <section id="blog-list" class="py-5">
        <div class="container">
            <div class="row g-4">
                
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <!-- Koyu Tema Kart -->
                        <div class="card h-100 border-0 rounded-4 shadow-lg overflow-hidden designer-card" style="background-color: #1a1a1a;">
                            
                            <!-- Eşit Boyutlu ve Parametreli Resim Alanı -->
                            <div class="position-relative" style="height: 250px; width: 100%;">
                                <img src="~/img/@item.Image" 
                                     class="w-100 h-100" 
                                     alt="@item.Title" 
                                     style="object-fit: cover !important;" />
                                
                                <!-- Kart Üzeri Tarih Etiketi -->
                                <div class="position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill" style="background-color: rgba(26, 26, 26, 0.85); border: 1px solid #333; backdrop-filter: blur(5px);">
                                    <small class="text-white fw-semibold">
                                        <i class="bi bi-calendar3 me-1" style="color: #ff4d6d;"></i> @item.DateCreated.ToString("dd MMM yyyy")
                                    </small>
                                </div>
                            </div>

                            <!-- Kart Gövdesi (Bilgiler) -->
                            <div class="card-body p-4 d-flex flex-column">
                                <h5 class="card-title fw-bold text-white mb-3 fs-4">@item.Title</h5>
                                
                                <!-- Açıklama satır kısıtlaması (Taşmayı önler) -->
                                <p class="card-text mb-4" style="color: #a0a0a0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Description
                                </p>
                                
                                <!-- Alt Bilgi ve Buton -->
                                <div class="mt-auto pt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid #333;">
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id" 
                                       class="btn btn-sm rounded-pill px-4 text-white designer-btn" style="background-color: #ff4d6d; border: none; font-weight: 600;">
                                        Devamını Oku
                                    </a>
                                    <small style="color: #777;"><i class="bi bi-eye me-1"></i>@item.ViewsCount</small>
                                </div>
                            </div>

                        </div>
                    </div>
                }

            </div>
        </div>
    </section>

</div>

<style>
    /* Tasarımcı Dokunuşu: Hover Efektleri */
    .designer-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .designer-card:hover { 
        transform: translateY(-8px); 
        box-shadow: 0 15px 30px rgba(255, 77, 109, 0.15) !important;
    }
    .designer-btn {
        transition: all 0.3s ease;
    }
    .designer-btn:hover { 
        background-color: #e63946 !important; 
        transform: scale(1.05);
    }
</style>