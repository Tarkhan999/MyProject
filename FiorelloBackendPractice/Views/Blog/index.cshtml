@model IEnumerable<BlogUIVM>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- Premium Dark Coffee Shop Background -->
<div style="background-color: #0b0b0b; min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    
    <!-- YENİ BANNER KISMI (Pembe Çiçek Yerine Starbucks Konsepti) -->
    <div class="text-center py-5" style="background-color: #121212; border-bottom: 2px solid #00704A; box-shadow: 0 4px 15px rgba(0, 112, 74, 0.2);">
        <!-- Dev Kahve İkonu -->
        <i class="bi bi-cup-hot-fill" style="font-size: 7rem; color: #00704A; filter: drop-shadow(0 0 20px rgba(0, 112, 74, 0.4));"></i>
        
        <div class="mt-4 mb-3">
            <span class="badge rounded-pill px-4 py-2" style="background-color: rgba(0, 112, 74, 0.15); color: #00a862; border: 1px solid #00704A;">
                <i class="bi bi-book-half me-2"></i> Kahve Kültürü
            </span>
        </div>
        
        <h1 class="display-4 fw-bold text-white mb-3">Blogumuza <span style="color: #00704A;">Hoş Geldiniz</span></h1>
        <div class="mx-auto" style="width: 80px; height: 3px; background-color: #00704A; border-radius: 5px;"></div>
        <p class="mt-4 fs-5" style="color: #a0a0a0; max-width: 600px; margin: 0 auto;">
            Kahve çekirdeklerinin dili, en yeni demleme yöntemleri ve birbirinden lezzetli tariflerle ilham dolu bir yolculuğa çıkın.
        </p>
    </div>

    <!-- KARTLARIN LİSTELENDİĞİ KISIM (Koyu Tema & Yeşil Çerçeve) -->
    <div class="container py-5">
        <div class="row pb-5 g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <!-- Tamamen Siyah Arka Plan & Yeşil Çerçeve -->
                    <div class="card h-100 rounded-4 overflow-hidden shadow-lg" style="background-color: #161616; border: 1px solid #00704A; transition: transform 0.3s ease;" onmouseover="this.style.transform='translateY(-10px)'" onmouseout="this.style.transform='translateY(0)'">
                        
                        <!-- Sabit Boyutlu Görsel Kalıbı -->
                        <div class="position-relative overflow-hidden" style="height: 260px; width: 100%; border-bottom: 2px solid #00704A;">
                            <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id" class="d-block w-100 h-100">
                                <img src="~/img/@item.Image" 
                                     class="w-100 h-100" 
                                     alt="@item.Title" 
                                     style="object-fit: cover !important; transition: transform 0.5s ease;" 
                                     onmouseover="this.style.transform='scale(1.1)'" 
                                     onmouseout="this.style.transform='scale(1)'" />
                            </a>
                            
                            <!-- Yeşil Rozetli Tarih Etiketi -->
                            <div class="position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill" style="background-color: rgba(0, 112, 74, 0.9); backdrop-filter: blur(4px); box-shadow: 0 4px 10px rgba(0,0,0,0.5);">
                                <small class="text-white fw-semibold">
                                    <i class="bi bi-calendar3 me-1"></i> @(item.DateCreated is DateTime dt ? dt.ToString("dd MMM yyyy") : item.DateCreated)
                                </small>
                            </div>
                        </div>

                        <!-- Kart İçeriği -->
                        <div class="card-body d-flex flex-column p-4 text-white">
                            <h5 class="card-title fw-bold text-white mb-3 fs-4" style="line-height: 1.3;">@item.Title</h5>
                            <p class="card-text mb-4" style="color: #b0b0b0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-weight: 300;">
                                @item.Description
                            </p>

                            <div class="mt-auto pt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid #2a2a2a;">
                                <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id" 
                                   class="btn btn-sm rounded-pill px-4 py-2 fw-bold text-white" style="background-color: #00704A; border: none; transition: background-color 0.3s;" onmouseover="this.style.backgroundColor='#00a862'" onmouseout="this.style.backgroundColor='#00704A'">
                                    Devamını Oku →
                                </a>
                                <div style="color: #00a862; background-color: rgba(0, 112, 74, 0.1); padding: 5px 12px; border-radius: 20px;">
                                    <i class="bi bi-eye me-1"></i> <small class="fw-bold">@item.ViewsCount</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>