@model IEnumerable<BlogUIVM>

<section id="blog">
    <div class="container">
        
        <!-- Başlık için ayrı bir alan (col-12 ile tüm satırı kaplar) -->
        <div class="row">
            <div class="col-12 mb-4">
                <h1 >Blog Sayfasina Hos Geldiniz!</h1>
            </div>
        </div>
        
        <!-- Blog kartlarının listelendiği alan -->
        <div class="row pb-5">
            @foreach (BlogUIVM item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="item">
                        <div class="img position-relative">
                            
                            <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id">
                                <img src="img/@item.Image" class="img-fluid" alt="">
                            </a>

                            <div class="date rounded bg-light position-absolute py-1 px-2">
                                <span>@item.DateCreated</span>
                            </div>
                        </div>
                        <div class="text mt-3 text-center px-5">
                            <h5>@item.Title</h5>
                            <p class="text-black-50">@item.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        
    </div>
</section>