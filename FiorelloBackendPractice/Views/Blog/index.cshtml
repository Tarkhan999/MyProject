@model IEnumerable<BlogUIVM>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- GÜZELLEŞTİRİLMİŞ ÜST KARŞILAMA ALANI -->
<section id="blog-header" class="py-5 mt-4 position-relative overflow-hidden bg-light rounded-4 mx-3 shadow-sm border border-secondary border-opacity-10">
    
    <!-- Dekoratif Arka Plan İkonları (Saydam) -->
    <div class="position-absolute top-0 start-0 translate-middle opacity-10" style="pointer-events: none;">
        <i class="bi bi-flower1 text-danger" style="font-size: 15rem;"></i>
    </div>
    <div class="position-absolute bottom-0 end-0 translate-middle opacity-10" style="pointer-events: none;">
        <i class="bi bi-flower3 text-danger" style="font-size: 15rem;"></i>
    </div>

    <div class="container position-relative z-1 py-4">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8 col-md-10">
                
                <!-- Şık Badge -->
                <div class="mb-4">
                    <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-4 py-2 fs-6 shadow-sm" style="letter-spacing: 1px;">
                        <i class="bi bi-journal-richtext me-2"></i> Çiçeksi Hikayeler
                    </span>
                </div>
                
                <!-- Ana Başlık -->
                <h1 class="fw-bold text-dark display-4 mb-4" style="letter-spacing: -1px;">
                    Blogumuza <span class="text-danger position-relative">
                        Hoş Geldiniz
                        <!-- Alt Çizgi Efekti -->
                        <svg class="position-absolute w-100 h-100" style="left: 0; bottom: -10px; z-index: -1; opacity: 0.2;" viewBox="0 0 100 20" preserveAspectRatio="none">
                            <path d="M0 15 Q 50 0 100 15" fill="none" stroke="red" stroke-width="5"/>
                        </svg>
                    </span>
                </h1>
                
                <!-- Alt Metin -->
                <p class="text-muted fs-5 leading-relaxed mb-4 px-lg-5">
                    Çiçeklerin dili, en yeni aranjman fikirleri ve doğanın bize anlattığı birbirinden güzel hikayelerle ilham dolu bir yolculuğa çıkın.
                </p>
                
                <!-- İkonlu Ayırıcı Çizgi -->
                <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                    <div class="bg-danger rounded-pill opacity-50" style="width: 50px; height: 3px;"></div>
                    <i class="bi bi-suit-heart-fill text-danger fs-6"></i>
                    <div class="bg-danger rounded-pill opacity-50" style="width: 50px; height: 3px;"></div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- BLOG KARTLARININ LİSTELENDİĞİ ALAN -->
<section id="blog-list" class="py-5">
    <div class="container">
        
        <!-- Kartları Getiren Partial View -->
        <!-- Not: Modelinizi (IEnumerable<BlogUIVM>) partial'a aktarmak için model parametresini ekledik -->
        <partial name="_BlogPartial" model="@Model" />
        
    </div>
</section>