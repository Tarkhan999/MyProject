@model FiorelloBackendPractice.Views.Blog.BlogDetailUIVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- Sayfa Kapsayıcısı (Siyah) -->
<div class="w-100 py-5" style="background-color: #000000; min-height: 100vh;">
    <div class="container mb-5">
        
        <!-- Ana Sayfaya Dön Butonu -->
        <div class="mb-4">
            <a asp-controller="Home" asp-action="Index" class="btn rounded-pill px-4 text-white" style="background-color: transparent; border: 1px solid #00704A;">
                <i class="bi bi-arrow-left me-1"></i> Ana Sayfaya Dön
            </a>
        </div>

        <!-- Detay Kartı (Siyah & Yeşil Çerçeveli) -->
        <div class="card rounded-4 overflow-hidden" style="background-color: #0a0a0a; border: 2px solid #00704A; box-shadow: 0 10px 30px rgba(0, 112, 74, 0.2);">
            <div class="card-body p-4 p-md-5">
                <div class="row g-5 align-items-center">
                    
                    <!-- Sol Taraf: İçerik -->
                    <div class="col-lg-6 order-2 order-lg-1">
                        <div class="d-flex flex-wrap gap-2 align-items-center mb-4">
                            <span class="badge px-3 py-2 rounded-pill fs-6 text-white" style="background-color: #00704A;">
                                <i class="bi bi-calendar3 me-1"></i> @Model.DateCreated.ToString("dd MMMM yyyy")
                            </span>
                            <span class="badge px-3 py-2 rounded-pill fs-6 text-white" style="background-color: #1a1a1a; border: 1px solid #00704A;">
                                <i class="bi bi-eye me-1"></i> @Model.ViewsCount görüntülenme
                            </span>
                        </div>

                        <h1 class="fw-bold text-white mb-3 display-5">@Model.Title</h1>

                        @if (!string.IsNullOrEmpty(Model.Link))
                        {
                            <div class="mb-4 fs-6" style="color: #a0a0a0;">
                                <i class="bi bi-person-circle me-1" style="color: #00704A;"></i> <b>Tasarımcı:</b> 
                                <span class="text-white fw-semibold">@Model.Link</span>
                            </div>
                        }

                        <div class="p-4 rounded-4 mb-4" style="background-color: #141414; border-left: 4px solid #00704A;">
                            <p class="fs-6 mb-0" style="color: #cccccc; line-height: 1.8;">
                                @Model.Description
                            </p>
                        </div>
                    </div>

                    <!-- Sağ Taraf: Tıklandığında Büyüyen Görsel -->
                    <div class="col-lg-6 order-1 order-lg-2">
                        <div class="position-relative text-center rounded-4 overflow-hidden" 
                             style="border: 2px solid #00704A; cursor: pointer;" 
                             data-bs-toggle="modal" 
                             data-bs-target="#imageModal">
                            
                            <img src="~/img/@Model.Image" 
                                 alt="@Model.Title" 
                                 class="img-fluid w-100" 
                                 style="height: 420px; object-fit: cover !important;" />
                                 
                            <!-- Resim Üzeri İpucu Etiketi -->
                            <div class="position-absolute bottom-0 end-0 m-3 px-3 py-1 rounded-pill bg-dark text-white opacity-75">
                                <small><i class="bi bi-zoom-in me-1"></i> Büyütmek için tıkla</small>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- TIKLANDIĞINDA AÇILAN BÜYÜK RESİM MODALI (LIGHTBOX POPUP) -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" style="z-index: 9999;"></button>
                <img src="~/img/@Model.Image" class="img-fluid rounded-4 shadow-lg" style="max-height: 85vh; border: 3px solid #00704A;" alt="@Model.Title">
            </div>
        </div>
    </div>
</div>