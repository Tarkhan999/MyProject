@model FiorelloBackendPractice.Views.Blog.BlogDetailUIVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    .ux-detail-page {
        background-color: #050505;
        min-height: 100vh;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .ux-back-btn {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e4e4e7;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .ux-back-btn:hover {
        background: #00704A;
        border-color: #00a862;
        color: white;
        transform: translateX(-5px);
        box-shadow: 0 0 20px rgba(0, 168, 98, 0.4);
    }

    .ux-detail-surface {
        background: #0c0c0e;
        border: 1px solid rgba(0, 112, 74, 0.2);
        border-radius: 32px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.8);
        position: relative;
    }

    .ux-desc-box {
        background: linear-gradient(135deg, rgba(0, 112, 74, 0.08) 0%, rgba(0,0,0,0) 100%);
        border-left: 4px solid #00a862;
        border-radius: 0 16px 16px 0;
        padding: 24px 32px;
        position: relative;
    }

    .ux-desc-box::before {
        content: '\F6B0';
        font-family: 'bootstrap-icons';
        position: absolute;
        top: -15px; left: 15px;
        font-size: 3rem;
        color: rgba(0, 168, 98, 0.1);
    }

    .ux-btn-primary {
        background: linear-gradient(135deg, #00704A 0%, #005236 100%);
        border: none;
        box-shadow: 0 8px 20px rgba(0, 112, 74, 0.3);
        transition: all 0.3s ease;
    }
    
    .ux-btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(0, 168, 98, 0.5);
        background: linear-gradient(135deg, #00a862 0%, #00704A 100%);
    }

    .ux-detail-img-wrapper {
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
        position: relative;
        cursor: zoom-in;
    }

    .ux-detail-img-wrapper img {
        transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .ux-detail-img-wrapper:hover img {
        transform: scale(1.05);
    }

    .ux-img-badge {
        background: rgba(0, 112, 74, 0.7);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(0, 168, 98, 0.5);
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.4s ease;
    }

    .ux-detail-img-wrapper:hover .ux-img-badge {
        opacity: 1;
        transform: translateY(0);
    }

    @@keyframes zoomIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

<div class="ux-detail-page py-5 w-100">
    <div class="container pb-5">
        <div class="mb-5">
            <a asp-controller="Blog" asp-action="Index" class="btn ux-back-btn rounded-pill px-4 py-2.5 fw-semibold d-inline-flex align-items-center gap-2 text-decoration-none">
                <i class="bi bi-arrow-left"></i> <span>Blog'a Dön</span>
            </a>
        </div>

        <div class="ux-detail-surface p-1">
            <div class="row g-0">
                <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-center order-2 order-lg-1">
                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <span class="badge rounded-pill px-4 py-2 fw-medium d-flex align-items-center gap-2" style="background: rgba(0, 112, 74, 0.12); color: #00a862; border: 1px solid rgba(0, 168, 98, 0.3);">
                            <i class="bi bi-calendar2-week"></i> @Model.DateCreated.ToString("dd MMMM yyyy")
                        </span>
                        <span class="badge rounded-pill px-4 py-2 fw-medium d-flex align-items-center gap-2" style="background: rgba(255,255,255,0.03); color: #a1a1aa; border: 1px solid rgba(255,255,255,0.08);">
                            <i class="bi bi-bar-chart-fill"></i> @Model.ViewsCount Okunma
                        </span>
                    </div>

                    <h1 class="fw-bold text-white mb-4 display-5" style="letter-spacing: -1px; line-height: 1.15;">
                        @Model.Title
                    </h1>

                    @if (!string.IsNullOrEmpty(Model.Link))
                    {
                        <div class="d-flex align-items-center mb-5 pb-4" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 52px; height: 52px; background: linear-gradient(135deg, #00704A, #00402a); border: 2px solid #00a862; box-shadow: 0 0 15px rgba(0, 168, 98, 0.3);">
                                <i class="bi bi-pen text-white fs-5"></i>
                            </div>
                            <div>
                                <small class="text-uppercase fw-bold" style="color: #71717a; letter-spacing: 1.5px; font-size: 0.7rem;">İçerik Üreticisi</small>
                                <div class="text-white fw-semibold fs-5 mt-1">@Model.Link</div>
                            </div>
                        </div>
                    }

                    <div class="ux-desc-box mb-5">
                        <p class="fs-5 mb-0" style="color: #d4d4d8; line-height: 1.8; font-weight: 300;">
                            @Model.Description
                        </p>
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="Home" asp-action="Index" asp-fragment="products" 
                           class="btn ux-btn-primary rounded-pill px-5 py-3 fw-bold d-flex align-items-center gap-2 text-white text-decoration-none">
                            <i class="bi bi-bag-fill"></i> Hemen Sipariş Ver
                        </a>
                        <button class="btn rounded-pill px-4 py-3 fw-semibold d-flex align-items-center gap-2" style="background: rgba(255,255,255,0.05); color: #e4e4e7; border: 1px solid rgba(255,255,255,0.1); transition: all 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">
                            <i class="bi bi-share-fill"></i> Paylaş
                        </button>
                    </div>
                </div>

                <div class="col-lg-6 p-4 d-flex align-items-center justify-content-center order-1 order-lg-2">
                    <div class="ux-detail-img-wrapper w-100 h-100 position-relative shadow-lg" data-bs-toggle="modal" data-bs-target="#uxImageModal" style="min-height: 450px;">
                        <img src="~/img/@Model.Image" alt="@Model.Title" class="w-100 h-100 object-fit-cover position-absolute top-0 start-0" />
                        
                        <div class="position-absolute inset-0 w-100 h-100" style="background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 40%); pointer-events: none;"></div>
                        
                        <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4 w-100 text-center pointer-events-none">
                            <span class="ux-img-badge badge rounded-pill py-2 px-4 shadow-lg text-white fw-medium pointer-events-auto">
                                <i class="bi bi-arrows-fullscreen me-2"></i> Resmi Büyüt
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="uxImageModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(15px); background-color: rgba(5, 5, 5, 0.9);">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-4 shadow-lg" data-bs-dismiss="modal" aria-label="Close" style="z-index: 1055; background-color: #00704A; padding: 14px; border-radius: 50%; opacity: 1; transition: transform 0.3s;" onmouseover="this.style.transform='rotate(90deg)'" onmouseout="this.style.transform='rotate(0)'"></button>
                <img src="~/img/@Model.Image" class="img-fluid rounded-4 shadow-lg" style="max-height: 85vh; border: 1px solid rgba(0, 168, 98, 0.4); box-shadow: 0 0 50px rgba(0, 168, 98, 0.2) !important; animation: zoomIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);" alt="@Model.Title">
            </div>
        </div>
    </div>
</div>