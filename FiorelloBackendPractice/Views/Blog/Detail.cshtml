@model FiorelloBackendPractice.Views.Blog.BlogDetailUIVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    
    <!-- Üst Navigasyon / Geri Dön -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Blogs
        </a>
    </div>

    <!-- Blog Detay Kartı -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <div class="row g-4 align-items-center">
                
                <!-- Sol Taraf: Blog Bilgileri -->
                <div class="col-lg-6 order-2 order-lg-1">
                    
                    <!-- Rozetler (Tarih ve Okunma Sayısı) -->
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fs-6">
                            <i class="bi bi-calendar3 me-1"></i> @Model.DateCreated
                        </span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill fs-6">
                            <i class="bi bi-eye me-1"></i> @Model.ViewsCount Views
                        </span>
                    </div>

                    <!-- Başlık -->
                    <h1 class="fw-bold text-dark mb-3 display-6">@Model.Title</h1>

                    <!-- Designer / Kaynak Linki -->
                    @if (!string.IsNullOrEmpty(Model.Link))
                    {
                        <div class="mb-4 text-muted fs-6">
                            <i class="bi bi-person-circle me-1 text-primary"></i> <b>Designer:</b> 
                            <span class="text-dark fw-semibold">@Model.Link</span>
                        </div>
                    }

                    <!-- Açıklama Metni -->
                    <div class="bg-light p-4 rounded-4 border-start border-primary border-4 mb-4 shadow-sm">
                        <p class="text-secondary fs-6 leading-relaxed mb-0">
                            @Model.Description
                        </p>
                    </div>

                    <!-- Sosyal Medya Paylaşım Butonları -->
                    <div class="d-flex align-items-center gap-2 pt-2">
                        <span class="fw-bold text-secondary me-2">Share:</span>
                        <a href="#x" class="btn btn-outline-primary btn-sm rounded-circle shadow-sm" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#x" class="btn btn-outline-info btn-sm rounded-circle shadow-sm" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;" title="Twitter">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                        <a href="#x" class="btn btn-outline-danger btn-sm rounded-circle shadow-sm" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;" title="Pinterest">
                            <i class="bi bi-pinterest"></i>
                        </a>
                        <a href="#x" class="btn btn-outline-primary btn-sm rounded-circle shadow-sm" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;" title="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>
                    </div>

                </div>

                <!-- Sağ Taraf: Görsel -->
                <div class="col-lg-6 order-1 order-lg-2">
                    <div class="position-relative text-center">
                        <img src="~/img/@Model.Image" 
                             alt="@Model.Title" 
                             class="img-fluid rounded-4 shadow-lg w-100 object-fit-cover" 
                             style="max-height: 450px;" />
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

@section Css{
    <link rel="stylesheet" href="~/css/blog.css">
}