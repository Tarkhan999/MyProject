@model FiorelloBackendPractice.Views.Blog.BlogDetailUIVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- Premium Dark Coffee Shop Background -->
<div class="w-100 py-5" style="background-color: #0b0b0b; min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="container pb-5">
        
        <!-- Şık Geri Dön Butonu -->
        <div class="mb-4">
            <a asp-controller="Blog" asp-action="Index" class="btn rounded-pill px-4 py-2 text-white fw-bold d-inline-flex align-items-center" 
               style="background-color: #121212; border: 1px solid #333; transition: all 0.3s ease;" 
               onmouseover="this.style.backgroundColor='#00704A'; this.style.borderColor='#00704A';" 
               onmouseout="this.style.backgroundColor='#121212'; this.style.borderColor='#333';">
                <i class="bi bi-arrow-left me-2"></i> Blog'a Dön
            </a>
        </div>

        <!-- Premium Detay Kartı -->
        <div class="card border-0 rounded-4 overflow-hidden shadow-lg position-relative" style="background-color: #161616;">
            
            <!-- Üst Dekoratif Çizgi -->
            <div style="height: 5px; background: linear-gradient(90deg, #00704A 0%, #00a862 50%, #00704A 100%); width: 100%;"></div>

            <div class="row g-0">
                <!-- Sol Taraf: İçerik ve Yazılar -->
                <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-center order-2 order-lg-1">
                    
                    <!-- Etiketler -->
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: rgba(0, 112, 74, 0.15); color: #00a862; border: 1px solid #00704A;">
                            <i class="bi bi-calendar-event me-1"></i> @Model.DateCreated.ToString("dd MMMM yyyy")
                        </span>
                        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #0a0a0a; color: #a0a0a0; border: 1px solid #333;">
                            <i class="bi bi-eye me-1"></i> @Model.ViewsCount Okunma
                        </span>
                    </div>

                    <!-- Başlık -->
                    <h1 class="fw-bold text-white mb-4 display-5" style="letter-spacing: -1px; line-height: 1.2;">
                        @Model.Title
                    </h1>

                    <!-- Yazar/Barista Bilgisi -->
                    @if (!string.IsNullOrEmpty(Model.Link))
                    {
                        <div class="d-flex align-items-center mb-4 pb-4" style="border-bottom: 1px solid #2a2a2a;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 shadow" style="width: 50px; height: 50px; background-color: #00704A; color: white;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </div>
                            <div>
                                <small class="text-uppercase fw-bold" style="color: #777; letter-spacing: 1px; font-size: 0.75rem;">İçerik Üreticisi</small>
                                <div class="text-white fw-semibold fs-5">@Model.Link</div>
                            </div>
                        </div>
                    }

                    <!-- Açıklama Kısmı -->
                    <div class="position-relative" style="z-index: 1;">
                        <i class="bi bi-quote position-absolute" style="font-size: 5rem; color: #00704A; opacity: 0.1; top: -30px; left: -20px; z-index: -1;"></i>
                        <p class="fs-5 mb-0" style="color: #cccccc; line-height: 1.8; font-weight: 300;">
                            @Model.Description
                        </p>
                    </div>

                    <!-- Alt Butonlar -->
                    <div class="mt-5 d-flex gap-3">
                        <!-- SİPARİŞ VER BUTONU: 404 hatasını önlemek için Ana Sayfadaki Ürünler (#products) alanına gider -->
                        <a asp-controller="Home" asp-action="Index" asp-fragment="products" 
                           class="btn rounded-pill px-4 py-2 fw-bold d-flex align-items-center text-white text-decoration-none" 
                           style="background-color: #00704A; border: none; transition: transform 0.2s;" 
                           onmouseover="this.style.transform='scale(1.05)'; this.style.backgroundColor='#00a862';" 
                           onmouseout="this.style.transform='scale(1)'; this.style.backgroundColor='#00704A';">
                            <i class="bi bi-cart-fill me-2"></i> Sipariş Ver
                        </a>
                        <button class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold d-flex align-items-center" style="border-color: #444; color: #ddd;">
                            <i class="bi bi-share me-2"></i> Paylaş
                        </button>
                    </div>
                </div>

                <!-- Sağ Taraf: Görsel -->
                <div class="col-lg-6 position-relative p-3 p-lg-4 d-flex align-items-center justify-content-center order-1 order-lg-2">
                    <div class="position-relative w-100 h-100 rounded-4 overflow-hidden shadow-lg" 
                         style="cursor: zoom-in; min-height: 400px; border: 1px solid rgba(255,255,255,0.05);"
                         data-bs-toggle="modal" data-bs-target="#imageModal">
                        
                        <img src="~/img/@Model.Image" 
                             alt="@Model.Title" 
                             class="img-fluid w-100 h-100 object-fit-cover position-absolute top-0 start-0" 
                             style="transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);"
                             onmouseover="this.style.transform='scale(1.08)'"
                             onmouseout="this.style.transform='scale(1)'"/>
                        
                        <div class="position-absolute w-100 h-100 top-0 start-0 d-flex flex-column justify-content-end p-4" style="background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 40%); pointer-events: none;">
                            <div class="align-self-end">
                                <span class="badge rounded-pill py-2 px-3 shadow" style="background-color: rgba(0, 112, 74, 0.8); backdrop-filter: blur(4px); border: 1px solid #00a862; pointer-events: auto;">
                                    <i class="bi bi-arrows-fullscreen me-1"></i> Büyütmek için tıkla
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- RESİM MODALI -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(10px); background-color: rgba(0,0,0,0.8);">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 shadow-lg" data-bs-dismiss="modal" aria-label="Close" style="z-index: 9999; background-color: #00704A; opacity: 1; padding: 10px; border-radius: 50%;"></button>
                <img src="~/img/@Model.Image" class="img-fluid rounded-4 shadow-lg" style="max-height: 85vh; border: 2px solid #00704A; box-shadow: 0 0 40px rgba(0, 112, 74, 0.4) !important;" alt="@Model.Title">
            </div>
        </div>
    </div>
</div>