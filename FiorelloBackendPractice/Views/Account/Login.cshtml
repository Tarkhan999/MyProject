@model LoginVM

<!-- DESIGNER EDITION: PREMIUM LOGIN STYLES -->
<style>
    body {
        background-color: #0a0604 !important;
    }

    .premium-card {
        background: #140d0a;
        border: 1px solid rgba(0, 112, 74, 0.25);
        border-radius: 16px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        padding: 3rem !important;
        position: relative;
        overflow: hidden;
    }

    .premium-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, transparent, #00704A, transparent);
    }

    .premium-card h3 {
        color: #FBF8F1;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 1.8rem;
    }

    .premium-card p.subtitle {
        color: rgba(251, 248, 241, 0.5);
        font-size: 0.9rem;
        margin-bottom: 2.5rem;
    }

    /* Premium Validation Summary */
    .premium-validation-summary {
        margin-bottom: 1.5rem;
    }

    .premium-validation-summary:not(:empty) {
        background-color: rgba(231, 76, 60, 0.1); 
        border-left: 4px solid #e74c3c; 
        border-radius: 8px;
        padding: 15px 20px;
    }

    .premium-validation-summary ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
    }

    .premium-validation-summary li {
        color: #e74c3c; 
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
    }

    .field-validation-error {
        font-size: 0.75rem;
        margin-top: 5px;
        display: block;
        color: #e74c3c !important;
    }

    .designer-label {
        color: rgba(251, 248, 241, 0.85);
        font-size: 0.75rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    /* Sol İkon (Kullanıcı ve Kilit) */
    .input-icon-left {
        position: absolute;
        left: 18px;
        color: rgba(251, 248, 241, 0.3);
        font-size: 1.1rem;
        transition: all 0.3s ease;
        z-index: 2;
    }

    /* Sağ İkon (Göz İkonu) */
    .toggle-password {
        position: absolute;
        right: 18px;
        color: rgba(251, 248, 241, 0.5);
        font-size: 1.1rem;
        cursor: pointer;
        transition: color 0.3s ease;
        z-index: 3;
    }

    .toggle-password:hover {
        color: #00704A;
    }

    .designer-input {
        background-color: rgba(255, 255, 255, 0.03) !important;
        border: 1px solid rgba(251, 248, 241, 0.1) !important;
        color: #FBF8F1 !important;
        padding: 14px 45px 14px 50px !important; /* Sağ padding göz ikonu için artırıldı */
        border-radius: 10px;
        height: 55px;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        width: 100%;
    }

    .input-wrapper:focus-within .input-icon-left {
        color: #00704A;
    }

    .designer-input:focus {
        background-color: rgba(255, 255, 255, 0.06) !important;
        border-color: #00704A !important;
        box-shadow: 0 0 0 4px rgba(0, 112, 74, 0.15) !important;
    }

    .designer-input::placeholder {
        color: rgba(251, 248, 241, 0.2) !important;
    }

    .designer-btn {
        background-color: #00704A;
        color: #FBF8F1;
        border-radius: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        height: 60px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .designer-btn:hover {
        background-color: #005a3b;
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 112, 74, 0.4);
    }

    .auth-link {
        color: #00704A;
        font-weight: 700;
        text-decoration: none;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

    .auth-link:hover {
        color: #FBF8F1;
    }

    .forgot-password {
        color: rgba(251, 248, 241, 0.5);
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }
    
    .forgot-password:hover {
        color: #00704A;
        text-decoration: none;
    }
</style>

<!-- FORM BÖLÜMÜ -->
<div class="container my-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            
            <div class="premium-card">
                
                <div class="text-center">
                    <h3>Welcome Back</h3>
                    <p class="subtitle">Sign in to continue your premium coffee experience.</p>
                </div>
                
                <form asp-controller="Account" asp-action="Login" method="post">
                    
                    <div asp-validation-summary="ModelOnly" class="premium-validation-summary"></div>

                    <!-- Email or Username -->
                    <div class="mb-4">
                        <label asp-for="EmailOrUserName" class="form-label designer-label">Email or Username</label>
                        <div class="input-wrapper">
                            <i class="far fa-user input-icon-left"></i>
                            <input asp-for="EmailOrUserName" class="form-control designer-input" placeholder="Enter email or username">
                        </div>
                        <span asp-validation-for="EmailOrUserName"></span>
                    </div>

                    <!-- Password (Göz İkonu Eklendi) -->
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label designer-label">Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon-left"></i>
                            <input asp-for="Password" class="form-control designer-input" placeholder="Enter your password" id="passwordInput">
                            <i class="fas fa-eye toggle-password" id="togglePasswordIcon" title="Show/Hide Password"></i>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    <!-- Forgot Password -->
                    <div class="d-flex justify-content-end align-items-center mb-5">
                        <a href="#" class="forgot-password">Forgot Password?</a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn designer-btn w-100 border-0">
                        Login Now
                    </button>

                    <!-- Alt Yönlendirme Linki -->
                    <div class="text-center mt-5">
                        <span style="color: rgba(251, 248, 241, 0.5); font-size: 0.85rem;">Don't have an account?</span>
                        <a asp-controller="Account" asp-action="Register" class="auth-link ml-1" style="font-size: 0.85rem;">
                            REGISTER HERE
                        </a>
                    </div>
                </form>

            </div>
            
        </div>
    </div>
</div>

<!-- ŞİFRE GÖSTER/GİZLE SCRİPTİ -->
<!-- ŞİFRE GÖSTER/GİZLE SCRİPTİ -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const togglePasswordIcon = document.getElementById("togglePasswordIcon");
        const passwordInput = document.getElementById("passwordInput");

        if (togglePasswordIcon && passwordInput) {
            togglePasswordIcon.addEventListener("click", function () {
                // Type özelliğini text veya password olarak değiştir
                const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
                passwordInput.setAttribute("type", type);
                
                // İkonu değiştir (Göz açık / Göz kapalı)
                this.classList.toggle("fa-eye");
                this.classList.toggle("fa-eye-slash");
            });
        }
    });
</script>
}