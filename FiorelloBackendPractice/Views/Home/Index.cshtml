@model HomeVM

@{
    ViewData["Title"] = "Home Page";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- ========================================== -->
<!-- STARBUCKS ÖZEL İKONA VE MODAL KODLARI BAŞI -->
<!-- ========================================== -->

<!-- 1. YÜZEN KAHVE BUTONU -->
<button id="themeToggleBtn" class="btn rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center" 
        style="background-color: #00704A; color: white; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 9999; border: 2px solid #000000; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease;">
    <i class="bi bi-cup-hot-fill fs-4" id="themeIcon"></i>
</button>

<!-- 2. EKRANDA DUMAN VE PIRILTI EFEKTİ İÇİN CANVAS -->
<canvas id="coffeeCanvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 99998;"></canvas>

<!-- 3. ŞIK STARBUCKS MODAL (PENCERE) -->
<div class="modal fade" id="coffeeModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4" style="background-color: #121212; border: 2px solid #00704A; border-radius: 20px; color: #ffffff;">
            <div class="modal-body py-4">
                <div class="mb-3">
                    <i class="bi bi-cup-hot display-1" style="color: #00704A;"></i>
                </div>
                <h3 class="fw-bold mb-2">Take a Coffee Break! ☕</h3>
                <p style="color: #a0a0a0; font-size: 0.95rem;">
                    Günün yoğunluğuna kısa bir ara ver. Taze kavrulmuş Starbucks kahveleriyle enerjini tazele!
                </p>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <!-- ORDER NOW Butonu: Tıklanınca #products id'li "All" bölümüne kaydırır ve modalı kapatır -->
                    <a href="#products" onclick="$('#coffeeModal').modal('hide');" class="btn px-4 py-2 rounded-pill fw-bold text-white text-decoration-none" style="background-color: #00704A; border: none;">Order Now</a>
                    
                    <!-- CLOSE Butonu: Bootstrap 4 uyumlu kapatma etiketi eklendi -->
                    <button type="button" class="btn px-4 py-2 rounded-pill text-white" data-dismiss="modal" style="background-color: #2b2b2b;">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- STARBUCKS ÖZEL İKONA VE MODAL KODLARI SONU -->
<!-- ========================================== -->

<!-- MAIN START -->
<main id="mainContent" style="background-color: #000000; min-height: 100vh;">

    <!-- SLIDER START -->
    @await Component.InvokeAsync("Slider")
    <!-- SLIDER END -->

    <!-- PRODUCTS START -->
    <div id="products">
        @await Component.InvokeAsync("Product")
    </div>
    <!-- PRODUCTS END -->

    <!-- ABOUT START -->
    <section id="about" style="background-color: #0a0a0a;">
        <div class="container py-5 mt-5">
            <div class="row align-items-center py-5">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <div class="img position-relative shadow-lg rounded-4 overflow-hidden" style="border: 2px solid #00704A;">
                        <img src="img/h3-video-img.jpg" class="img-fluid w-100 object-fit-cover" style="min-height: 400px; opacity: 0.8;" alt="About Video">
                        <!-- Play Butonu Yeşil Yapıldı -->
                        <div class="player position-absolute top-50 start-50 translate-middle rounded-circle d-flex align-items-center justify-content-center shadow-lg" 
                             style="width: 80px; height: 80px; cursor: pointer; transition: transform 0.3s ease; background-color: #00704A; color: white;" 
                             onmouseover="this.style.transform='translate(-50%, -50%) scale(1.1)'" 
                             onmouseout="this.style.transform='translate(-50%, -50%) scale(1)'">
                            <i class="fas fa-play fa-lg ms-1"></i>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-6">
                    <div class="about-text px-lg-5">
                        <h1 class="fw-bold display-5 mb-4 text-white">Surprise Your <span style="color: #00704A;">Valentine!</span> <br>Let us arrange a smile.</h1>
                        <!-- Açıklama Kutusu Starbucks Stili -->
                        <p class="py-3 fs-5 leading-relaxed border-start border-4 ps-4 rounded-end" style="border-color: #00704A !important; background-color: #141414; color: #cccccc;">
                            Where flowers are our inspiration to create lasting memories. Whatever the occasion...
                        </p>
                        <ul class="list-unstyled mt-4">
                            <li class="mt-3 d-flex align-items-center fs-5 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #00704A; font-size: 1.5rem;"></i> Hand picked just for you.
                            </li>
                            <li class="mt-3 d-flex align-items-center fs-5 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #00704A; font-size: 1.5rem;"></i> Unique flower arrangements.
                            </li>
                            <li class="mt-3 d-flex align-items-center fs-5 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #00704A; font-size: 1.5rem;"></i> Best way to say you care.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ABOUT END -->

    <!-- EXPERTS START -->
