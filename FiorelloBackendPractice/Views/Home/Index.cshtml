@model HomeVM

@{
    ViewData["Title"] = "Home Page";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- ========================================== -->
<!-- YÜZEN KAHVE BUTONU VE CANVAS -->
<!-- ========================================== -->
<button id="themeToggleBtn" class="btn rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center" 
        style="background-color: #00704A; color: white; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 9999; border: 2px solid #CBA258; cursor: pointer; transition: transform 0.3s ease;">
    <i class="bi bi-cup-hot-fill fs-4" id="themeIcon"></i>
</button>

<canvas id="coffeeCanvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 9998;"></canvas>

<!-- KAHVE BREAK MODAL -->
<div class="modal fade" id="coffeeModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4" style="background-color: #120d0a; border: 2px solid #00704A; border-radius: 20px; color: #ffffff;">
            <div class="modal-body py-4">
                <div class="mb-3">
                    <i class="bi bi-cup-hot display-1" style="color: #CBA258;"></i>
                </div>
                <h3 class="fw-bold mb-2" style="color: #FBF8F1;">Take a Coffee Break! ☕</h3>
                <p style="color: #a0a0a0; font-size: 0.95rem;">
                    Günün yoğunluğuna kısa bir ara ver. Taze kavrulmusa Starbucks kahveleriyle enerjini tazele!
                </p>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a href="#products" onclick="$('#coffeeModal').modal('hide');" class="btn px-4 py-2 rounded-pill fw-bold text-white text-decoration-none" style="background-color: #00704A; border: none;">Order Now</a>
                    <button type="button" class="btn px-4 py-2 rounded-pill text-white" data-dismiss="modal" data-bs-dismiss="modal" style="background-color: #2b2b2b;">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<main id="mainContent" style="background-color: #0d0805; min-height: 100vh; clear: both;">

    <!-- SLIDER -->
    @await Component.InvokeAsync("Slider")

    <!-- PRODUCTS (Kendi ViewComponent'i içinde <section id="products"> barındırır) -->
    @await Component.InvokeAsync("Product")

    
    <!-- ABOUT SECTION -->
    @if (Model.AboutInfo != null)
    {
        <section id="about" style="background-color: #0a0604; padding: 60px 0;">
            <div class="container my-5">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-4 mb-lg-0">
                        <div class="img position-relative shadow-lg rounded-4 overflow-hidden" style="border: 2px solid #00704A;">
                            <img src="~/img/@Model.AboutInfo.ImageUrl" class="img-fluid w-100 object-fit-cover" style="min-height: 380px; opacity: 0.85;" alt="About Video">
                        </div>
                    </div>
                
                    <div class="col-lg-6">
                        <div class="about-text px-lg-4">
                            <h1 class="fw-bold display-6 mb-4 text-white">
                                @Model.AboutInfo.Title <span style="color: #00704A;">@Model.AboutInfo.HighlightedText</span> <br>Coffee
                            </h1>
                            <p class="py-3 fs-6 leading-relaxed border-start border-4 ps-4 rounded-end" style="border-color: #00704A !important; background-color: #140d0a; color: #d1d1d1;">
                                @Model.AboutInfo.Description
                            </p>
                            <ul class="list-unstyled mt-4">
                                <li class="mt-3 d-flex align-items-center fs-6 text-white">
                                    <i class="bi bi-check-circle-fill me-3" style="color: #00704A; font-size: 1.3rem;"></i> @Model.AboutInfo.PointText
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    <!-- EXPERTS SECTION -->
    <section id="experts" class="py-5" style="background-color: #0d0805;">
        <div class="container py-4">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <h1 class="fw-bold display-6 text-white mb-2">Our Baristas</h1>
                    <p class="fs-6" style="color: #a0a0a0;">Mastering the art of perfect coffee</p>
                    <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 3px; background-color: #CBA258;"></div>
                </div>
            </div>
            
            <div class="row g-4 justify-content-center">
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #140d0a; border: 1px solid rgba(0, 112, 74, 0.3) !important;">
                        <div class="img mx-auto" style="width: 130px; height: 130px;">
                            <img src="~/img/normal_005.jpg" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">CRYSTAL BROOKS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #CBA258; border: 1px solid #00704A;">Head Barista</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #140d0a; border: 1px solid rgba(0, 112, 74, 0.3) !important;">
                        <div class="img mx-auto" style="width: 130px; height: 130px;">
                            <img src="~/img/normal_005.jpg" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">SHIRLEY HARRIS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #CBA258; border: 1px solid #00704A;">Store Manager</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #140d0a; border: 1px solid rgba(0, 112, 74, 0.3) !important;">
                        <div class="img mx-auto" style="width: 130px; height: 130px;">
                            <!-- Güncellenen Satır: -->
                            <img src="/img/normal_005.jpg" asp-append-version="true" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="Amanda Watkins">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">AMANDA WATKINS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #CBA258; border: 1px solid #00704A;">Latte Artist</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #140d0a; border: 1px solid rgba(0, 112, 74, 0.3) !important;">
                        <div class="img mx-auto" style="width: 130px; height: 130px;">
                            <img src="~/img/normal_005.jpg" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">AMANDA WATKINS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #CBA258; border: 1px solid #00704A;">Latte Artist</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SUBSCRIBE -->
    <section id="subscribe" class="py-5" style="background-color: #0a0604; border-top: 1px solid rgba(251,248,241,0.05);">
        <div class="container py-4">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <div class="content p-5 rounded-4 shadow-lg card border-0" style="background-color: #140d0a; border: 1px solid rgba(0, 112, 74, 0.3) !important;">
                        <h2 class="fw-bold mb-3 text-white display-6">Join The Coffee Club!</h2>
                        <p class="mb-4" style="color: #a0a0a0;">Get special offers, event invites, and fresh roast updates.</p>
                    
                        <div class="d-flex justify-content-center">
                            <div class="input-group input-group-lg" style="max-width: 550px; border: 2px solid #00704A; border-radius: 50px; overflow: hidden;">
                                <!-- ID Eklendi: subscribeEmail -->
                                <input type="email" id="subscribeEmail" placeholder="Email Address" class="form-control border-0 px-4 py-3 text-white shadow-none" style="background-color: #0a0604;" aria-label="Email Address">
                            
                                <!-- ID Eklendi: subscribeBtn -->
                                <button id="subscribeBtn" type="button" class="btn px-4 py-3 fw-bold text-uppercase border-0 text-white" style="background-color: #00704A; letter-spacing: 1px;">Subscribe</button>
                            </div>
                        </div>
                    
                        <!-- Bildirim Mesajı İçin Alan -->
                        <div id="subscribeMessage" class="mt-3 fw-bold text-warning" style="min-height: 24px;"></div>
                    
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BLOG -->
    <section id="blog" class="py-5" style="background-color: #0d0805;">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <h1 class="fw-bold display-6 text-white mb-2">From Coffee Blog</h1>
                    <p class="fs-6" style="color: #a0a0a0;">Stories behind the finest coffee beans</p>
                    <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 3px; background-color: #CBA258;"></div>
                </div>
            </div>
            <partial name="_BlogPartial" model="@Model.Blogs"/>
        </div>
    </section>

    <!-- INSTAGRAM -->
    <section id="instagram" class="position-relative overflow-hidden" style="background-color: #0d0805;">
        <div class="owl-carousel instagram" style="opacity: 0.85;">
            <!-- Görsellerin hepsine w-100, object-fit-cover ve sabit yükseklik (height: 350px) eklendi -->
            <div><img src="~/img/normal_005.jpg" class="img-fluid w-100 object-fit-cover" style="height: 350px; border: 1px solid #0d0805;" alt=""></div>
            <div><img src="~/img/normal_005.jpg" class="img-fluid w-100 object-fit-cover" style="height: 350px; border: 1px solid #0d0805;" alt=""></div>
            <div><img src="~/img/gettyimages-2151794290-2048x2048.jpg" class="img-fluid w-100 object-fit-cover" style="height: 350px; border: 1px solid #0d0805;" alt=""></div>
            <div><img src="~/img/gettyimages-2151794290-2048x2048.jpg" class="img-fluid w-100 object-fit-cover" style="height: 350px; border: 1px solid #0d0805;" alt=""></div>
            <div><img src="~/img/gettyimages-2151794290-2048x2048.jpg" class="img-fluid w-100 object-fit-cover" style="height: 350px; border: 1px solid #0d0805;" alt=""></div>
            <div><img src="~/img/normal_005.jpg" class="img-fluid w-100 object-fit-cover" style="height: 350px; border: 1px solid #0d0805;" alt=""></div>
        </div>
        <div class="hastag position-absolute top-50 start-50 translate-middle fw-bold py-3 px-5 shadow-lg rounded-pill" style="z-index: 2; letter-spacing: 2px; background-color: #0d0805; border: 2px solid #00704A; color: #ffffff;">
            <i class="bi bi-instagram me-2" style="color: #CBA258;"></i>#STARBUCKS
        </div>
    </section>

</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("themeToggleBtn");
        const themeIcon = document.getElementById("themeIcon");
        const canvas = document.getElementById("coffeeCanvas");
        const ctx = canvas.getContext("2d");

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        resizeCanvas();
        window.addEventListener("resize", resizeCanvas);

        let particles = [];

        function createParticles(x, y) {
            for (let i = 0; i < 30; i++) {
                particles.push({
                    x: x,
                    y: y,
                    radius: Math.random() * 5 + 2,
                    color: i % 2 === 0 ? "#00704A" : "#CBA258",
                    vx: (Math.random() - 0.5) * 8,
                    vy: (Math.random() - 1) * 8 - 2,
                    alpha: 1
                });
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach((p, index) => {
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= 0.025;
                if (p.alpha <= 0) {
                    particles.splice(index, 1);
                } else {
                    ctx.save();
                    ctx.globalAlpha = p.alpha;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.fill();
                    ctx.restore();
                }
            });
            if (particles.length > 0) {
                requestAnimationFrame(animateParticles);
            }
        }

        toggleBtn.addEventListener("click", function (e) {
            themeIcon.style.transition = "transform 0.4s ease";
            themeIcon.style.transform = "rotate(360deg) scale(1.2)";
            setTimeout(() => { themeIcon.style.transform = "rotate(0deg) scale(1)"; }, 400);

            const rect = toggleBtn.getBoundingClientRect();
            createParticles(rect.left + rect.width / 2, rect.top + rect.height / 2);
            animateParticles();

            if (typeof $ !== 'undefined' && $('#coffeeModal').modal) {
                $('#coffeeModal').modal('show');
            }
        });
    });
</script>