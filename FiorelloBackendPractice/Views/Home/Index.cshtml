                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-1.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">CRYSTAL BROOKS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Florist</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-2.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">SHIRLEY HARRIS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Manager</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-3.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">BEVERLY CLARK</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Florist</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-4.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">AMANDA WATKINS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Florist</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- EXPERTS END -->

    <!-- SUBSCRIBE START -->
    <section id="subscribe" class="py-5" style="background-color: #0a0a0a; border-top: 1px solid #1a1a1a; border-bottom: 1px solid #1a1a1a;">
        <div class="container py-5">
            <div class="row py-4">
                <div class="col-lg-8 mx-auto text-center">
                    <div class="content p-5 rounded-4 shadow-lg card border-0" style="background-color: #000000; box-shadow: 0 10px 30px rgba(0, 112, 74, 0.1) !important;">
                        <h2 class="fw-bold mb-4 text-white display-6">Join The Colorful Bunch!</h2>
                        <div class="d-flex justify-content-center mt-4">
                            <div class="input-group input-group-lg" style="max-width: 600px; border: 2px solid #00704A; border-radius: 50px; overflow: hidden;">
                                <input type="email" placeholder="Email Address" class="form-control border-0 px-4 py-3 text-white shadow-none" style="background-color: #141414;" aria-label="Email Address">
                                <button class="btn px-5 py-3 fw-bold text-uppercase tracking-wide border-0 text-white" style="background-color: #00704A;">Subscribe</button>
                            </div>
                        </div>
                        <p class="mt-3 small" style="color: #a0a0a0;">We won't spam you. Unsubscribe at any time.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- SUBSCRIBE END -->

    <!-- BLOG START -->
    <section id="blog" class="py-5 mt-4" style="background-color: #000000;">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <div class="section-title">
                        <h1 class="fw-bold display-6 text-white mb-3">From our Blog</h1>
                        <p class="fs-6" style="color: #cccccc;">A perfect blend of creativity, energy, communication, happiness and love. Let us arrange a smile for you.</p>
                        <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 4px; background-color: #00704A;"></div>
                    </div>
                </div>
            </div>
            <partial name="_BlogPartial" model="@Model.Blogs"/>
        </div>
    </section>
    <!-- BLOG END -->

    <!-- SAY START -->
    <section id="say" class="py-5 mt-4" style="background-color: #0a0a0a;">
        <div class="container">
            <div class="row py-5 justify-content-center">
                <div class="col-md-10 col-xl-8">
                    <div class="owl-carousel say">
                        <!-- Testimonial 1 -->
                        <div>
                            <div class="item text-center px-4">
                                <div class="img d-flex justify-content-center mb-4">
                                    <img src="img/testimonial-img-1.png" class="rounded-circle shadow-sm" style="width: 90px; height: 90px; border: 3px solid #00704A;" alt="">
                                </div>
                                <div class="text fs-5 fst-italic mb-4 position-relative" style="color: #cccccc;">
                                    <i class="bi bi-quote position-absolute opacity-25" style="color: #00704A; font-size: 4rem; top: -30px; left: -20px; z-index: 0;"></i>
