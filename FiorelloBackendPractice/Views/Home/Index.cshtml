@model HomeVM

@{
    ViewData["Title"] = "Home Page";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    /* DİNAMİK HAREKETLİ ARKA PLAN */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .animated-bg {
        background:black;
        background-size: 400% 400%;
        animation: gradientMove 15s ease infinite;
        min-height: 100vh;
    }

    /* GLASSMORPHISM (BUZLU CAM) STANDART SINIFI */
    .glass-panel {
        background:black;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(203, 162, 88, 0.15);
        border-radius: 24px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .glass-panel:hover {
        border-color: rgba(0, 112, 74, 0.4);
        transform: translateY(-5px);
    }
    
    /* YUMUŞAK YÜZME ANİMASYONU (GÖRSELLER İÇİN) */
    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }
    .floating-img {
        animation: float 6s ease-in-out infinite;
    }
</style>

<!-- YÜZEN KAHVE BUTONU VE CANVAS (Değiştirilmedi, JS kancaları aynı) -->
<button id="themeToggleBtn" class="btn rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center"
        style="background-color: rgba(0, 112, 74, 0.8); backdrop-filter: blur(5px); color: white; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 9999; border: 2px solid #CBA258; cursor: pointer; transition: all 0.3s ease;">
    <i class="bi bi-cup-hot-fill fs-4" id="themeIcon"></i>
</button>

<canvas id="coffeeCanvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 9998;"></canvas>

<!-- KAHVE BREAK MODAL -->
<div class="modal fade" id="coffeeModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(15px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4 glass-panel" style="background: rgba(18, 13, 10, 0.85); border: 2px solid #00704A; color: #ffffff;">
            <div class="modal-body py-4">
                <div class="mb-3 floating-img">
                    <i class="bi bi-cup-hot display-1" style="color: #CBA258;"></i>
                </div>
                <h3 class="fw-bold mb-2" style="color: #FBF8F1;">Take a Coffee Break! ☕</h3>
                <p style="color: #c4c4c4; font-size: 0.95rem;">
                    Günün yoğunluğuna kısa bir ara ver. Taze kavrulmuş Starbucks kahveleriyle enerjini tazele!
                </p>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a href="#products" onclick="$('#coffeeModal').modal('hide');" class="btn px-4 py-2 rounded-pill fw-bold text-white text-decoration-none shadow" style="background: linear-gradient(45deg, #00704A, #053b26); border: none;">Order Now</a>
                    <button type="button" class="btn px-4 py-2 rounded-pill text-white" data-dismiss="modal" data-bs-dismiss="modal" style="background-color: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT (Animasyonlu Şeffaf Arka Plan İçinde) -->
<main id="mainContent" class="animated-bg" style="clear: both; overflow-x: hidden;">

    <!-- SLIDER -->
    @await Component.InvokeAsync("Slider")

    <!-- PRODUCTS -->
    @await Component.InvokeAsync("Product")

    <!-- ABOUT SECTION -->
    @if (Model.AboutInfo != null)
    {
    <section id="about" style="padding: 80px 0; position: relative;">
        <div class="container my-5 glass-panel p-5">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <div class="img position-relative shadow-lg rounded-4 overflow-hidden floating-img" style="border: 2px solid rgba(0, 112, 74, 0.5);">
                        <img src="~/img/@Model.AboutInfo.ImageUrl" class="img-fluid w-100 object-fit-cover" style="min-height: 380px; opacity: 0.9;" alt="About Video">
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="about-text px-lg-4">
                        <h1 class="fw-bold display-6 mb-4 text-white" style="text-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                            @Model.AboutInfo.Title <span style="color: #00704A;">@Model.AboutInfo.HighlightedText</span> <br>Coffee
                        </h1>
                        <p class="py-3 fs-6 leading-relaxed border-start border-4 ps-4 rounded-end" style="border-color: #00704A !important; background: rgba(0, 112, 74, 0.05); color: #e0e0e0;">
                            @Model.AboutInfo.Description
                        </p>
                        <ul class="list-unstyled mt-4">
                            <li class="mt-3 d-flex align-items-center fs-6 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #CBA258; font-size: 1.3rem; filter: drop-shadow(0 0 5px rgba(203,162,88,0.5));"></i> @Model.AboutInfo.PointText
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    }

    <!-- EXPERTS SECTION -->
    <section id="experts" class="py-5">
        <div class="container py-4">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <h1 class="fw-bold display-6 text-white mb-2" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Our Baristas</h1>
                    <p class="fs-6" style="color: #c4c4c4;">Mastering the art of perfect coffee</p>
                    <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 3px; background: linear-gradient(90deg, transparent, #CBA258, transparent);"></div>
                </div>
            </div>

            <div class="row g-4 justify-content-center">
                @if (Model.Experts != null)
                {
                foreach (var item in Model.Experts)
                {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center glass-panel h-100 py-4 px-3 position-relative overflow-hidden">
                        <!-- Arka plan parlaması -->
                        <div style="position:absolute; top:-50px; right:-50px; width:100px; height:100px; background:#00704A; filter:blur(60px); opacity:0.4; z-index:0;"></div>
                        
                        <div class="img mx-auto position-relative" style="width: 130px; height: 130px; z-index:1;">
                            <img src="~/img/@item.ImageUrl" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid rgba(203, 162, 88, 0.8);" alt="@item.FullName">
                        </div>
                        <div class="text mt-4 position-relative" style="z-index:1;">
                            <h6 class="fw-bold mb-2 text-white">@item.FullName</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background: rgba(0, 112, 74, 0.3); color: #CBA258; border: 1px solid rgba(0, 112, 74, 0.5); backdrop-filter: blur(4px);">@item.Position</span>
                        </div>
                    </div>
                </div>
                }
                }
            </div>
        </div>
    </section>

    <!-- SUBSCRIBE / JOIN US -->
    @if (Model.SubscribeInfo != null)
    {
    <section id="subscribe" class="py-5 position-relative"
             style="background-image: url('/img/@Model.SubscribeInfo.BackgroundImageUrl'); background-size: cover; background-position: center; background-attachment: fixed;">

        <!-- Koyu Gradient Overlay -->
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(13,8,5,1) 0%, rgba(13,8,5,0.6) 50%, rgba(13,8,5,1) 100%);"></div>

        <div class="container py-5 position-relative" style="z-index: 1;">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <div class="content p-5 glass-panel">
                        <h2 class="fw-bold mb-3 text-white display-6">@Model.SubscribeInfo.Title</h2>
                        <p class="mb-4" style="color: #d1d1d1;">@Model.SubscribeInfo.Description</p>

                        <div class="d-flex justify-content-center">
                            <div class="input-group input-group-lg shadow-lg" style="max-width: 550px; border: 1px solid rgba(203,162,88,0.4); border-radius: 50px; overflow: hidden; background: rgba(0,0,0,0.4); backdrop-filter: blur(10px);">
                                <input type="email" id="subscribeEmail" placeholder="Email Address" class="form-control border-0 px-4 py-3 text-white shadow-none" style="background-color: transparent;" aria-label="Email Address">

                                <button id="subscribeBtn" type="button" class="btn px-4 py-3 fw-bold text-uppercase border-0 text-white" style="background: linear-gradient(45deg, #00704A, #034f36); letter-spacing: 1px; transition: opacity 0.3s ease;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">Continue</button>
                            </div>
                        </div>
                        <div id="subscribeMessage" class="mt-3 fw-bold" style="min-height: 24px; text-shadow: 0 2px 4px rgba(0,0,0,0.8);"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    }

    <!-- BLOG -->
    <section id="blog" class="py-5">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <h1 class="fw-bold display-6 text-white mb-2" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">From Coffee Blog</h1>
                    <p class="fs-6" style="color: #c4c4c4;">Stories behind the finest coffee beans</p>
                    <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 3px; background: linear-gradient(90deg, transparent, #CBA258, transparent);"></div>
                </div>
            </div>
            <!-- Partial çağrısı değişmedi -->
            <partial name="_BlogPartial" model="@Model.Blogs"/>
        </div>
    </section>

    <!-- INSTAGRAM -->
    <section id="instagram" class="position-relative overflow-hidden py-4">
        <div class="owl-carousel instagram" style="opacity: 0.9;">
            @if (Model.InstagramPhotos != null && Model.InstagramPhotos.Any())
            {
                foreach (var photo in Model.InstagramPhotos)
                {
                    <div class="px-2">
                        <div class="rounded-4 overflow-hidden" style="border: 2px solid rgba(255,255,255,0.05);">
                            <img src="~/img/@photo.ImageUrl" class="img-fluid w-100 object-fit-cover" style="height: 350px; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" alt="Instagram">
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-white p-5 text-center w-100 glass-panel mx-auto" style="max-width:400px;">Henüz Instagram fotoğrafı yüklenmedi.</div>
            }
        </div>
        
        <div class="hastag position-absolute top-50 start-50 translate-middle fw-bold py-3 px-5 shadow-lg rounded-pill" style="z-index: 2; letter-spacing: 2px; background: rgba(13, 8, 5, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(203, 162, 88, 0.5); color: #ffffff;">
            <i class="bi bi-instagram me-2" style="color: #CBA258;"></i>#STARBUCKS
        </div>
    </section>

</main>

