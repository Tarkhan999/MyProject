@model HomeVM

@{
    ViewData["Title"] = "Home Page";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<!-- TEMA DEĞİŞTİRME BUTONU (İsteğe bağlı bırakıldı, ancak tasarım artık kalıcı Starbucks konseptinde) -->
<button id="themeToggleBtn" class="btn rounded-circle shadow-lg position-fixed" style="background-color: #00704A; color: white; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 9999; border: 2px solid #000000;">
    <i class="bi bi-cup-hot-fill fs-4" id="themeIcon"></i>
</button>

<!-- MAIN START -->
<main id="mainContent" style="background-color: #000000; min-height: 100vh;">

    <!-- SLIDER START -->
    @await Component.InvokeAsync("Slider")
    <!-- SLIDER END -->

    <!-- PRODUCTS START -->
    @await Component.InvokeAsync("Product")
    <!-- PRODUCTS END -->

    <!-- ABOUT START -->
    <section id="about" style="background-color: #0a0a0a;">
        <div class="container py-5 mt-5">
            <div class="row align-items-center py-5">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <div class="img position-relative shadow-lg rounded-4 overflow-hidden" style="border: 2px solid #00704A;">
                        <img src="img/h3-video-img.jpg" class="img-fluid w-100 object-fit-cover" style="min-height: 400px; opacity: 0.8;" alt="About Video">
                        <!-- Play Butonu Yeşil Yapıldı -->
                        <div class="player position-absolute top-50 start-50 translate-middle rounded-circle d-flex align-items-center justify-content-center shadow-lg" 
                             style="width: 80px; height: 80px; cursor: pointer; transition: transform 0.3s ease; background-color: #00704A; color: white;" 
                             onmouseover="this.style.transform='translate(-50%, -50%) scale(1.1)'" 
                             onmouseout="this.style.transform='translate(-50%, -50%) scale(1)'">
                            <i class="fas fa-play fa-lg ms-1"></i>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-6">
                    <div class="about-text px-lg-5">
                        <h1 class="fw-bold display-5 mb-4 text-white">Surprise Your <span style="color: #00704A;">Valentine!</span> <br>Let us arrange a smile.</h1>
                        <!-- Açıklama Kutusu Starbucks Stili -->
                        <p class="py-3 fs-5 leading-relaxed border-start border-4 ps-4 rounded-end" style="border-color: #00704A !important; background-color: #141414; color: #cccccc;">
                            Where flowers are our inspiration to create lasting memories. Whatever the occasion...
                        </p>
                        <ul class="list-unstyled mt-4">
                            <li class="mt-3 d-flex align-items-center fs-5 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #00704A; font-size: 1.5rem;"></i> Hand picked just for you.
                            </li>
                            <li class="mt-3 d-flex align-items-center fs-5 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #00704A; font-size: 1.5rem;"></i> Unique flower arrangements.
                            </li>
                            <li class="mt-3 d-flex align-items-center fs-5 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #00704A; font-size: 1.5rem;"></i> Best way to say you care.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- ABOUT END -->

    <!-- EXPERTS START -->
    <section id="experts" class="py-5" style="background-color: #000000;">
        <div class="container py-4">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <div class="section-title">
                        <h1 class="fw-bold display-6 text-white mb-3">Rose </h1>
                        <p class="fs-6" style="color: #a0a0a0;">My favourite flower Rose</p>
                        <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 4px; background-color: #00704A;"></div>
                    </div>
                </div>
            </div>
            
            <div class="row pb-5 g-4 justify-content-center">
                <!-- Personel Kartları Koyu Gri & Yeşil Çerçeveli -->
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-1.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">CRYSTAL BROOKS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Florist</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-2.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">SHIRLEY HARRIS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Manager</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-3.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">BEVERLY CLARK</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Florist</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="item text-center card border-0 shadow-lg rounded-4 h-100 py-4 px-2" style="background-color: #0a0a0a; border: 1px solid #1a1a1a !important;">
                        <div class="img mx-auto" style="width: 140px; height: 140px;">
                            <img src="img/h3-team-img-4.png" class="img-fluid rounded-circle shadow h-100 w-100 object-fit-cover" style="border: 3px solid #00704A;" alt="">
                        </div>
                        <div class="text mt-4">
                            <h6 class="fw-bold mb-2 text-white">AMANDA WATKINS</h6>
                            <span class="badge rounded-pill px-3 py-1" style="background-color: rgba(0, 112, 74, 0.2); color: #00704A; border: 1px solid #00704A;">Florist</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- EXPERTS END -->

    <!-- SUBSCRIBE START -->
    <section id="subscribe" class="py-5" style="background-color: #0a0a0a; border-top: 1px solid #1a1a1a; border-bottom: 1px solid #1a1a1a;">
        <div class="container py-5">
            <div class="row py-4">
                <div class="col-lg-8 mx-auto text-center">
                    <div class="content p-5 rounded-4 shadow-lg card border-0" style="background-color: #000000; box-shadow: 0 10px 30px rgba(0, 112, 74, 0.1) !important;">
                        <h2 class="fw-bold mb-4 text-white display-6">Join The Colorful Bunch!</h2>
                        <div class="d-flex justify-content-center mt-4">
                            <div class="input-group input-group-lg" style="max-width: 600px; border: 2px solid #00704A; border-radius: 50px; overflow: hidden;">
                                <input type="email" placeholder="Email Address" class="form-control border-0 px-4 py-3 text-white shadow-none" style="background-color: #141414;" aria-label="Email Address">
                                <button class="btn px-5 py-3 fw-bold text-uppercase tracking-wide border-0 text-white" style="background-color: #00704A;">Subscribe</button>
                            </div>
                        </div>
                        <p class="mt-3 small" style="color: #a0a0a0;">We won't spam you. Unsubscribe at any time.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- SUBSCRIBE END -->

    <!-- BLOG START -->
    <section id="blog" class="py-5 mt-4" style="background-color: #000000;">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <div class="section-title">
                        <h1 class="fw-bold display-6 text-white mb-3">From our Blog</h1>
                        <p class="fs-6" style="color: #cccccc;">A perfect blend of creativity, energy, communication, happiness and love. Let us arrange a smile for you.</p>
                        <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 4px; background-color: #00704A;"></div>
                    </div>
                </div>
            </div>
            <partial name="_BlogPartial" model="@Model.Blogs"/>
        </div>
    </section>
    <!-- BLOG END -->

    <!-- SAY START -->
    <section id="say" class="py-5 mt-4" style="background-color: #0a0a0a;">
        <div class="container">
            <div class="row py-5 justify-content-center">
                <div class="col-md-10 col-xl-8">
                    <div class="owl-carousel say">
                        <!-- Testimonial 1 -->
                        <div>
                            <div class="item text-center px-4">
                                <div class="img d-flex justify-content-center mb-4">
                                    <img src="img/testimonial-img-1.png" class="rounded-circle shadow-sm" style="width: 90px; height: 90px; border: 3px solid #00704A;" alt="">
                                </div>
                                <div class="text fs-5 fst-italic mb-4 position-relative" style="color: #cccccc;">
                                    <i class="bi bi-quote position-absolute opacity-25" style="color: #00704A; font-size: 4rem; top: -30px; left: -20px; z-index: 0;"></i>
                                    <span class="position-relative" style="z-index: 1;">Nullam dictum felis eu pede mollis pretium. Integer tincidunt. Cras dapibus lingua.</span>
                                </div>
                                <div class="author">
                                    <h6 class="fw-bold text-white mb-2">Anna Barnes</h6>
                                    <span class="badge rounded-pill px-3" style="background-color: #1a1a1a; color: #00704A; border: 1px solid #00704A;">Florist</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- SAY END -->

    <!-- INSTAGRAM START -->
    <section id="instagram" class="position-relative" style="background-color: #000000;">
        <div class="owl-carousel instagram" style="opacity: 0.8;">
            <div><img src="img/instagram1.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
            <div><img src="img/instagram2.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
            <div><img src="img/instagram3.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
            <div><img src="img/instagram4.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
            <div><img src="img/instagram5.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
            <div><img src="img/instagram6.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
            <div><img src="img/instagram7.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
            <div><img src="img/instagram8.jpg" class="img-fluid" style="transition: opacity 0.3s; border: 1px solid #000;" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='1'" alt=""></div>
        </div>
        <!-- Hashtag Kutusu (Siyah & Yeşil) -->
        <div class="hastag position-absolute top-50 start-50 translate-middle fw-bold py-3 px-5 shadow-lg rounded-pill" style="z-index: 2; letter-spacing: 2px; background-color: #000000; border: 2px solid #00704A; color: #ffffff;">
            <i class="bi bi-instagram me-2" style="color: #00704A;"></i>#FIORELLO
        </div>
    </section>
    <!-- INSTAGRAM END -->

</main>
<!-- MAIN END -->