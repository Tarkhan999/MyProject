@model HeaderVM

<!-- PREMIUM HEADER STİLLERİ -->
<style>
    header .navbar-nav .nav-item > ul,
    header .navbar-nav .nav-item .account-dropdown,
    header .navbar-nav .nav-item ul.list-unstyled {
        background-color: #140d0a !important; 
        border: 1px solid #00704A !important;
        padding: 0 !important;
        box-shadow: 0px 8px 16px rgba(0,0,0,0.8) !important;
    }

    header .navbar-nav .nav-item > ul > li {
        background-color: transparent !important;
        border-bottom: 1px solid rgba(251, 248, 241, 0.1) !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    header .navbar-nav .nav-item > ul > li > a {
        color: #FBF8F1 !important; 
        display: block !important;
        padding: 12px 20px !important;
        font-size: 12px !important;
        text-transform: uppercase !important;
        letter-spacing: 2px !important;
        transition: all 0.3s ease !important;
        background-color: transparent !important;
    }

    header .navbar-nav .nav-item > ul > li > a:hover {
        color: #140d0a !important; 
        background-color: #00704A !important; 
    }
    
    header {
        background-color: #140d0a !important;
        border-bottom: 2px solid #00704A !important; 
        margin: 0 !important; 
        padding: 0 !important;
        width: 100%;
        display: block;
    }

    .navbar {
        margin-bottom: 0 !important;
        padding-top: 15px !important;
        padding-bottom: 15px !important;
    }

    header .nav-link {
        color: #FBF8F1 !important;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 10px 15px !important;
        transition: color 0.3s ease;
    }

    header .shop-cart a::after,
    header .shop-cart a::before,
    header .shop-cart span::after,
    header .shop-cart span::before,
    header .shop-cart sup::after,
    header .shop-cart sup::before {
        display: none !important;
        content: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
    }

    header .shop-cart a span {
        transform: none !important;
        top: auto !important;
    }

    header .nav-link:hover,
    header .shop-cart a:hover span,
    header .shop-cart a:hover i {
        color: #00704A !important;
    }

    .account-menu {
        position: relative; 
    }

    .account-dropdown {
        display: none; 
        position: absolute;
        top: 100%;
        left: 0;
        background-color: #140d0a !important; 
        border: 1px solid #00704A; 
        min-width: 160px;
        padding: 0;
        margin: 0;
        z-index: 1050;
        box-shadow: 0px 8px 16px rgba(0,0,0,0.6); 
        border-radius: 4px;
    }

    .account-menu:hover .account-dropdown {
        display: block;
    }

    .account-dropdown li {
        border-bottom: 1px solid rgba(251, 248, 241, 0.1);
    }

    .account-dropdown li:last-child {
        border-bottom: none;
    }

    .account-dropdown .nav-link {
        padding: 12px 20px !important;
        font-size: 11px;
    }

    .account-dropdown .nav-link:hover {
        background-color: #00704A !important;
        color: #fff !important;
    }

    .mobile-navbar {
        background-color: #140d0a !important;
        border-left: 2px solid #00704A;
        z-index: 1000;
    }
    
    .mobile-navbar a, .mobile-navbar i {
        color: #FBF8F1 !important;
        transition: color 0.3s ease;
    }
    
    .mobile-navbar a:hover, .mobile-navbar i:hover {
        color: #00704A !important;
    }
</style>

<!-- HEADER START -->
<header>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav class="navbar navbar-expand-lg d-flex d-lg-block justify-content-between d-xl-flex navbar-dark">
                    
                    <!-- BRAND -->
                    <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <img src="~/img/@Model.Setting.HeaderLogo" alt="Starbucks Logo" id="logo" style="height: 45px; width: auto; object-fit: contain;">
                        
                        <div class="ml-4 pl-4 border-left d-none d-md-flex align-items-center" style="border-color: rgba(251, 248, 241, 0.15) !important; height: 35px;">
                            <i class="fas fa-phone-alt mr-2" style="font-size: 11px; color: #00704A;"></i>
                            <span style="font-size: 13px; letter-spacing: 1.5px; color: #FBF8F1; font-weight: 500;">@Model.Setting.Phone</span>
                        </div>
                    </a>
                    
                    <button class="navbar-toggler" type="button" data-toggle="collapse"
                            data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation" id="mobile-navbar-show" style="border: none;">
                        <span class="navbar-toggler-icon" style="font-size: 14px;"></span>
                    </button>

                    <div class="collapse navbar-collapse d-none d-lg-block" id="navbarSupportedContent">
                        <ul class="navbar-nav ml-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">Shop</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">Portfolio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a>
                            </li>
                            
                            <!-- IDENTITY KONTROLLÜ ACCOUNT MENÜSÜ -->
                            <li class="nav-item account-menu d-flex align-items-center">
                                @if (!User.Identity.IsAuthenticated)
                                {
                                    <!-- Kullanıcı giriş yapmamışsa Account yazar -->
                                    <a class="nav-link d-flex align-items-center m-0" href="#" style="cursor: default; gap: 6px;">
                                        Account <i class="fas fa-angle-down" style="font-size: 11px; margin-top: 1px;"></i>
                                    </a>
                                    <ul class="list-unstyled account-dropdown">
                                        <li><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                                        <li><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                                    </ul>
                                }
                                else
                                {
                                    <!-- Kullanıcı giriş yapmışsa Kullanıcı Adı yazar -->
                                    <a class="nav-link d-flex align-items-center m-0 text-warning" href="#" style="cursor: default; gap: 6px; text-transform: none !important;">
                                        <i class="far fa-user"></i> @User.Identity.Name <i class="fas fa-angle-down" style="font-size: 11px; margin-top: 1px;"></i>
                                    </a>
                                    <ul class="list-unstyled account-dropdown">
                                        <li><a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a></li>
                                    </ul>
                                }
                            </li>
                            
                            <!-- SEPET BÖLÜMÜ -->
                            <li class="nav-item my-auto ml-lg-5 shop-cart">
                                <a asp-controller="Basket" asp-action="Index" class="d-flex align-items-center text-decoration-none" style="gap: 12px;">
                                    <div class="position-relative d-flex align-items-center">
                                        <i class="fas fa-shopping-bag" style="font-size: 22px; color: #FBF8F1; transition: color 0.3s ease;"></i>
                                        <sup class="d-flex justify-content-center align-items-center font-weight-bold" 
                                             style="position: absolute; top: -10px; right: -10px; width: 18px; height: 18px; font-size: 11px; background-color: #00704A; color: #ffffff; border-radius: 50%; padding: 0; margin: 0;">
                                            @Model.BasketCount
                                        </sup>
                                    </div>
                                    <span class="font-weight-bold" style="font-size: 13px; letter-spacing: 1px; color: #FBF8F1; transition: color 0.3s ease; display: inline-block;">CART ($@Model.ProductPrice)</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>

        <!-- MOBİL MENÜ IDENTITY KONTROLÜ -->
        <div class="mobile-navbar position-absolute shadow-lg h-100 p-5">
            <i class="fas fa-times fa-2x mb-5" id="mobile-navbar-close" style="cursor: pointer;"></i>
            <ul class="list-unstyled d-flex flex-column" style="gap: 20px;">
                <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" href="#">Shop</a></li>
                <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" href="#">Portfolio</a></li>
                <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" asp-controller="Blog" asp-action="Index">Blog</a></li>
                
                @if (!User.Identity.IsAuthenticated)
                {
                    <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" asp-controller="Account" asp-action="Register">Register</a></li>
                }
                else
                {
                    <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px; color:#00704A !important;" href="#"><i class="far fa-user mr-2"></i>@User.Identity.Name</a></li>
                    <li><a class="text-uppercase font-weight-bold" style="font-size: 1.1rem; letter-spacing: 2px;" asp-controller="Account" asp-action="Logout">Logout</a></li>
                }
            </ul>
        </div>
    </div>               
</header>
<!-- HEADER END -->