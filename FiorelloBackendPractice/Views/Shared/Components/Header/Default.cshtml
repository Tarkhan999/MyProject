@model HeaderVM

<style>
    header.premium-header {
        background-color: #0a0a0c;
        border-bottom: 2px solid #00704A;
        padding: 12px 0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
        position: sticky;
        top: 0;
        z-index: 1050;
        width: 100%;
    }

    .header-left-group {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .phone-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(0, 112, 74, 0.1);
        border: 1px solid rgba(0, 112, 74, 0.3);
        padding: 6px 14px;
        border-radius: 20px;
    }

    .phone-badge span {
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 1px;
        color: #FBF8F1;
    }

    .premium-nav-link {
        color: #FBF8F1 !important;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 8px 16px !important;
        transition: color 0.3s ease;
    }

    .premium-nav-link:hover {
        color: #00a862 !important;
    }

    .account-wrapper {
        position: relative;
    }

    .account-trigger {
        color: #FBF8F1;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding: 8px 16px;
        transition: color 0.3s ease;
    }

    .account-trigger:hover {
        color: #00a862;
    }

    .account-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        background-color: #0a0a0c;
        border: 1px solid #00704A;
        border-radius: 4px;
        min-width: 150px;
        padding: 0;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.8);
        margin-top: 10px;
    }

    .account-wrapper:hover .account-dropdown-menu {
        opacity: 1;
        visibility: visible;
        margin-top: 0;
    }

    .account-dropdown-menu a {
        display: block;
        padding: 12px 20px;
        color: #ffffff !important;
        font-size: 12px;
        text-decoration: none;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(251, 248, 241, 0.1);
        transition: all 0.3s ease;
    }

    .account-dropdown-menu a:last-child {
        border-bottom: none;
    }

    .account-dropdown-menu a:hover {
        background-color: #00704A;
        color: #ffffff !important;
        padding-left: 25px;
    }

    .cart-btn-premium {
        display: flex;
        align-items: center;
        gap: 12px;
        background: transparent;
        border: 1px solid rgba(251, 248, 241, 0.1);
        padding: 8px 20px;
        border-radius: 30px;
        text-decoration: none !important;
        transition: all 0.3s ease;
    }

    .cart-btn-premium:hover {
        background: rgba(0, 112, 74, 0.15);
        border-color: #00704A;
    }

    .cart-icon-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .cart-icon-wrapper i {
        font-size: 20px;
        color: #FBF8F1;
    }

    .cart-badge {
        position: absolute;
        top: -6px;
        right: -8px;
        background: #00704A;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .cart-text {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #FBF8F1;
    }

    .cart-price {
        color: #00a862;
        margin-left: 4px;
    }

    .mobile-navbar-premium {
        background: #0a0a0c;
        border-left: 2px solid #00704A;
        z-index: 2000;
    }

    .mobile-navbar-premium a {
        color: #ffffff !important;
        font-size: 16px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: bold;
        transition: color 0.3s ease;
    }

    .mobile-navbar-premium a:hover {
        color: #00a862 !important;
    }
</style>

<header class="premium-header">
    <div class="container">
        <nav class="navbar navbar-expand-lg d-flex align-items-center justify-content-between p-0">
            <div class="header-left-group">
                <a class="navbar-brand m-0 p-0" asp-controller="Home" asp-action="Index">
                    <img src="~/img/@Model?.Setting?.HeaderLogo" alt="Logo" style="height: 44px; width: auto; object-fit: contain;">
                </a>

                <div class="d-none d-md-flex phone-badge">
                    <i class="fas fa-phone-alt" style="color: #00a862; font-size: 11px;"></i>
                    <span>@Model?.Setting?.Phone</span>
                </div>
            </div>

            <button class="navbar-toggler" type="button" id="mobile-navbar-show" style="border: none; outline: none; padding: 0;">
                <i class="fas fa-bars" style="color: #00a862; font-size: 24px;"></i>
            </button>

            <div class="collapse navbar-collapse d-none d-lg-block">
                <ul class="navbar-nav ml-auto align-items-center gap-1">
                    <li class="nav-item"><a class="nav-link premium-nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link premium-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                    <li class="nav-item"><a class="nav-link premium-nav-link" asp-controller="About" asp-action="Index">About</a></li>
                    <li class="nav-item"><a class="nav-link premium-nav-link" asp-controller="Blog" asp-action="Index">Blog</a></li>

                    <li class="nav-item account-wrapper ml-3">
                        @if (User.Identity is null || !User.Identity.IsAuthenticated)
                        {
                            <div class="account-trigger">
                                Account <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                            </div>
                            <div class="account-dropdown-menu">
                                <a asp-controller="Account" asp-action="Login">Login</a>
                                <a asp-controller="Account" asp-action="Register">Register</a>
                            </div>
                        }
                        else
                        {
                            <div class="account-trigger" style="color: #00a862;">
                                <i class="far fa-user"></i> @User.Identity.Name <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                            </div>
                            <div class="account-dropdown-menu">
                                <a asp-controller="Account" asp-action="Logout" style="color: #ff4d4d !important;">Logout</a>
                            </div>
                        }
                    </li>

                    <li class="nav-item ml-4 shop-cart">
                        <a asp-controller="Basket" asp-action="Index" class="cart-btn-premium">
                            <div class="cart-icon-wrapper">
                                <i class="fas fa-shopping-bag"></i>
                                <sup class="cart-badge">@Model?.BasketCount</sup>
                            </div>
                            <span class="cart-text">CART <span class="cart-price">($@Model?.ProductPrice)</span></span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <div class="mobile-navbar mobile-navbar-premium position-fixed top-0 right-0 h-100 p-4 shadow-lg" style="display:none; width:280px;">
        <div class="d-flex justify-content-end mb-4">
            <i class="fas fa-times fa-lg" id="mobile-navbar-close" style="cursor: pointer; color: #FBF8F1; font-size: 24px;"></i>
        </div>
        <ul class="list-unstyled d-flex flex-column" style="gap: 20px;">
            <li><a class="nav-link p-0" asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a class="nav-link p-0" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
            <li><a class="nav-link p-0" asp-controller="About" asp-action="Index">About Us</a></li>
            <li><a class="nav-link p-0" asp-controller="Blog" asp-action="Index">Blog</a></li>
            <li class="mt-2 border-top pt-3" style="border-color: rgba(251, 248, 241, 0.1) !important;"></li>
            @if (User.Identity is null || !User.Identity.IsAuthenticated)
            {
                <li><a class="nav-link p-0" asp-controller="Account" asp-action="Login">Login</a></li>
                <li><a class="nav-link p-0" asp-controller="Account" asp-action="Register">Register</a></li>
            }
            else
            {
                <li><a class="nav-link p-0" style="color: #00a862 !important;"><i class="far fa-user mr-2"></i>@User.Identity.Name</a></li>
                <li><a class="nav-link p-0" asp-controller="Account" asp-action="Logout" style="color: #ff4d4d !important;">Logout</a></li>
            }
        </ul>
    </div>
</header>