@model ProductVCVM

<style>
    /* ÜRÜNLER ALANI VE HİZALAMA */
    #products-section {
        background-color: #0b0705; /* Biraz daha koyu, tok bir siyah */
        padding-top: 50px;
        padding-bottom: 90px;
        position: relative;
        z-index: 5;
        clear: both;
    }

    /* KATEGORİ FİLTRE MENÜSÜ - GLASSMORPHISM EFEKTİ */
    .filter-bar {
        background-color: rgba(20, 13, 10, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(203, 162, 88, 0.2);
        border-radius: 50px;
        padding: 10px 25px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .filter-bar a {
        color: rgba(251, 248, 241, 0.7) !important;
        font-weight: 500;
        font-size: 0.85rem;
        letter-spacing: 2px;
        text-decoration: none;
        transition: all 0.3s ease;
        padding: 8px 20px;
        border-radius: 30px;
    }

    .filter-bar a:hover, 
    .filter-bar a.active {
        color: #CBA258 !important;
        background-color: rgba(203, 162, 88, 0.15);
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(203, 162, 88, 0.1);
    }

    /* KART DIŞ MARGIN KONTROLÜ */
    .product-grid-row {
        margin-top: 100px; 
    }

    /* PREMIUM STARBUCKS GREEN KART TASARIMI */
    .coffee-card {
        background: linear-gradient(145deg, #053b26 0%, #021a11 100%);
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        padding: 0 20px 25px;
        margin-top: 75px; 
        border: 1px solid rgba(251, 248, 241, 0.08);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
    }

    .coffee-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0, 112, 74, 0.4), 0 0 20px rgba(203, 162, 88, 0.15);
        border-color: rgba(203, 162, 88, 0.5);
    }

    /* DAİRESEL DIŞARI TAŞAN FOTOĞRAF */
    .circle-img-container {
        width: 150px; 
        height: 150px;
        margin: -75px auto 20px; 
        border-radius: 50%;
        border: 4px solid #0b0705; 
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);
        overflow: hidden;
        background-color: #FBF8F1;
        position: relative;
        cursor: pointer;
        z-index: 10;
        transition: border-color 0.4s ease;
    }
    
    .coffee-card:hover .circle-img-container {
        border-color: #CBA258;
    }

    .circle-img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .circle-img-container:hover img {
        transform: scale(1.15);
    }

    .img-hover-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(2, 26, 17, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: #CBA258;
        font-size: 2rem;
    }

    .circle-img-container:hover .img-hover-overlay {
        opacity: 1;
    }

    /* KART BİLGİLERİ */
    .card-coffee-title {
        color: #FBF8F1;
        font-size: 1.1rem;
        letter-spacing: 1px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .card-coffee-price {
        color: #CBA258;
        font-size: 1.4rem;
        font-weight: 800;
    }

    .btn-add-gold {
        border: 2px solid #CBA258;
        color: #CBA258;
        border-radius: 30px;
        padding: 8px 22px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        background: transparent;
        transition: all 0.3s ease;
    }

    .btn-add-gold:hover {
        background-color: #CBA258 !important;
        color: #0b0705 !important;
        box-shadow: 0 5px 20px rgba(203, 162, 88, 0.5);
        transform: translateY(-2px);
    }

    /* FİLTRELEME ANİMASYONU */
    @@keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
    .product-wrapper {
        animation: fadeInScale 0.5s ease forwards;
    }

    /* EŞİT VE KÜÇÜK MODAL GÖRSEL TASARIMI */
    .modal-custom-img {
        width: 260px;
        height: 260px;
        object-fit: cover;
        border-radius: 24px;
        border: 4px solid #CBA258;
        background-color: #FBF8F1;
        box-shadow: 0 20px 50px rgba(0,0,0,0.8);
    }
</style>

<section id="products-section">
    <div class="container">
        
        <!-- FİLTRE MENÜSÜ -->
        <div class="row justify-content-center mb-5">
            <div class="col-12 col-lg-10">
                <div class="filter-bar d-flex justify-content-center justify-content-md-between align-items-center flex-wrap gap-3">
                    <ul class="category d-flex list-unstyled mb-0 gap-2 flex-wrap align-items-center justify-content-center">
                        <li><a href="javascript:void(0)" data-id="all" class="text-uppercase category-filter active">All</a></li>
                        @foreach (var item in Model.Categories)
                        {
                            <li><a href="javascript:void(0)" data-id="@item.Id" class="text-uppercase category-filter">@item.Name</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- ÜRÜN KARTLARI IZGARASI -->
        <div class="row product-grid-row" id="product-list">
            @foreach (var item in Model.Products)
            {
                <div class="col-sm-6 col-md-4 col-lg-3 mb-5 product-wrapper" data-category="@item.CategoryId">
                    <div class="coffee-card text-center d-flex flex-column h-100">
                        <!-- DAİRESEL RESİM -->
                        <div class="circle-img-container" data-toggle="modal" data-target="#imageModal-@item.Id" data-bs-toggle="modal" data-bs-target="#imageModal-@item.Id">
                            <img src="~/img/@item.MainImage" alt="@item.Name">
                            <div class="img-hover-overlay">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </div>
                        
                        <!-- BAŞLIK & TÜR -->
                        <div class="title mt-2 flex-grow-1 px-2">
                            <h6 class="card-coffee-title">@item.Name</h6>
                            <p style="color: rgba(251, 248, 241, 0.5); font-size: 0.75rem; letter-spacing: 1.5px; text-transform: uppercase;">Premium Blend</p>
                        </div>
                        
                        <!-- FİYAT VE SEPET BUTONU -->
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top" style="border-color: rgba(251, 248, 241, 0.08) !important;">
                            <span class="card-coffee-price">$@item.Price</span>
                            <button data-id="@item.Id" class="btn btn-add-gold d-flex align-items-center basket-add-btn">
                                <i class="fas fa-plus me-1 mr-1"></i> ADD
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- MODALLAR -->
@foreach (var item in Model.Products)
{
    <div class="modal fade" id="imageModal-@item.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 260px;">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body text-center p-0 position-relative">
                    
                    <!-- KAPATMA BUTONU -->
                    <button type="button" class="btn rounded-circle d-flex align-items-center justify-content-center position-absolute" 
                            style="top: -15px; right: -15px; width: 40px; height: 40px; background-color: #0b0705; border: 2px solid #CBA258; color: #CBA258; z-index: 9999; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.5); transition: all 0.3s ease;" 
                            onmouseover="this.style.backgroundColor='#CBA258'; this.style.color='#0b0705';" 
                            onmouseout="this.style.backgroundColor='#0b0705'; this.style.color='#CBA258';"
                            data-dismiss="modal" data-bs-dismiss="modal">
                        <i class="fas fa-times fs-6"></i>
                    </button>
                    
                    <img src="~/img/@item.MainImage" class="modal-custom-img" alt="@item.Name">
                </div>
            </div>
        </div>
    </div>
}

<!-- FİLTRELEME İŞLEMİ (GÜNCELLENDİ) -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const filterButtons = document.querySelectorAll(".category-filter");
        const products = document.querySelectorAll(".product-wrapper");

        filterButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault(); 

                // Buton tasarımlarını güncelle
                filterButtons.forEach(btn => btn.classList.remove("active"));
                this.classList.add("active");

                const selectedCategoryId = this.getAttribute("data-id").toString();

                products.forEach(product => {
                    const productCategoryId = product.getAttribute("data-category").toString();

                    // Eşleşme kontrolü
                    if (selectedCategoryId === "all" || selectedCategoryId === productCategoryId) {
                        product.classList.remove("d-none"); // Bootstrap class'ı ile görünür yap
                        
                        // Animasyonu sıfırla ve tekrar oynat
                        product.style.animation = 'none';
                        product.offsetHeight; /* Reflow tetikle */
                        product.style.animation = 'fadeInScale 0.5s ease forwards'; 
                    } else {
                        product.classList.add("d-none"); // Bootstrap class'ı ile gizle
                    }
                });
            });
        });
    });
</script>