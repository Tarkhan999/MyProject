@model ProductVCVM

<style>
    /* ÜRÜNLER ALANI VE ŞEFFAF YAPI */
    #products-section {
        /* Arka plan rengini kaldırdık ki ana sayfadaki hareketli fon arkadan gözüksün */
        background: transparent;
        padding-top: 50px;
        padding-bottom: 90px;
        position: relative;
        z-index: 5;
    }

    /* KATEGORİ FİLTRE MENÜSÜ - PREMIUM GLASSMORPHISM */
    .filter-bar {
        background: rgba(10, 6, 4, 0.3);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(203, 162, 88, 0.2);
        border-radius: 50px;
        padding: 10px 25px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .filter-bar a {
        color: rgba(251, 248, 241, 0.7) !important;
        font-weight: 500;
        font-size: 0.85rem;
        letter-spacing: 2px;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        padding: 8px 20px;
        border-radius: 30px;
    }

    .filter-bar a:hover,
    .filter-bar a.active {
        color: #0b0705 !important;
        background: linear-gradient(45deg, #CBA258, #e5c88c);
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(203, 162, 88, 0.4);
        transform: translateY(-2px);
    }

    .product-grid-row {
        margin-top: 80px;
    }

    /* ŞEFFAF KART TASARIMI (GLASS-CARD) */
    .glass-card {
        background: linear-gradient(145deg, rgba(5, 59, 38, 0.2) 0%, rgba(2, 26, 17, 0.4) 100%);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-radius: 40px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        padding: 0 20px 25px;
        margin-top: 40px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.4s ease;
        position: relative;
    }

    .glass-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 20px 40px rgba(0, 112, 74, 0.3), 0 0 20px rgba(203, 162, 88, 0.1);
        border-color: rgba(203, 162, 88, 0.3);
        background: linear-gradient(145deg, rgba(5, 59, 38, 0.4) 0%, rgba(2, 26, 17, 0.6) 100%);
    }

    /* DAİRESEL DIŞARI TAŞAN FOTOĞRAF */
    .circle-img-container {
        width: 140px;
        height: 140px;
        margin: -70px auto 20px;
        border-radius: 50%;
        border: 4px solid rgba(11, 7, 5, 0.8);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        background-color: transparent;
        position: relative;
        cursor: pointer;
        z-index: 10;
        transition: all 0.4s ease;
    }

    .glass-card:hover .circle-img-container {
        border-color: #CBA258;
        transform: rotate(5deg) scale(1.05);
    }

    .circle-img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .img-hover-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(2, 26, 17, 0.7);
        backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: #CBA258;
        font-size: 2rem;
    }

    .circle-img-container:hover .img-hover-overlay {
        opacity: 1;
    }

    .card-coffee-title {
        color: #FBF8F1;
        font-size: 1.15rem;
        letter-spacing: 1px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 6px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .card-coffee-price {
        color: #CBA258;
        font-size: 1.4rem;
        font-weight: 800;
        text-shadow: 0 0 10px rgba(203,162,88,0.2);
    }

    .btn-add-gold {
        border: 1px solid rgba(203, 162, 88, 0.5);
        color: #CBA258;
        border-radius: 30px;
        padding: 8px 22px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        background: rgba(203, 162, 88, 0.05);
        transition: all 0.3s ease;
    }

    .btn-add-gold:hover {
        background: linear-gradient(45deg, #CBA258, #e5c88c) !important;
        color: #0b0705 !important;
        box-shadow: 0 5px 20px rgba(203, 162, 88, 0.4);
        transform: translateY(-2px);
    }

    @@keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.9) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .product-wrapper {
        animation: fadeInScale 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .modal-custom-img {
        width: 260px;
        height: 260px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #CBA258;
        box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 40px rgba(203,162,88,0.3);
    }
</style>

<section id="products-section">
    <div class="container">

        <!-- FİLTRE MENÜSÜ -->
        <div class="row justify-content-center mb-5">
            <div class="col-12 col-lg-8">
                <div class="filter-bar d-flex justify-content-center align-items-center flex-wrap gap-3">
                    <ul class="category d-flex list-unstyled mb-0 gap-3 flex-wrap align-items-center justify-content-center w-100">
                        <li><a href="javascript:void(0)" data-id="all" class="text-uppercase category-filter active">All</a></li>
                        @foreach (var item in Model.Categories)
                        {
                        <li><a href="javascript:void(0)" data-id="@item.Id" class="text-uppercase category-filter">@item.Name</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- ÜRÜN KARTLARI IZGARASI -->
        <div class="row product-grid-row" id="product-list">
            @foreach (var item in Model.Products)
            {
            <div class="col-sm-6 col-md-4 col-lg-3 mb-5 product-wrapper" data-category="@item.CategoryId">
                <div class="glass-card text-center d-flex flex-column h-100">
                    <!-- DAİRESEL RESİM -->
                    <div class="circle-img-container" data-toggle="modal" data-target="#imageModal-@item.Id" data-bs-toggle="modal" data-bs-target="#imageModal-@item.Id">
                        <img src="~/img/@item.MainImage" alt="@item.Name">
                        <div class="img-hover-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>

                    <!-- BAŞLIK & TÜR -->
                    <div class="title mt-3 flex-grow-1 px-2">
                        <h6 class="card-coffee-title">@item.Name</h6>
                        <p style="color: rgba(251, 248, 241, 0.6); font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase;">Premium Blend</p>
                    </div>

                    <!-- FİYAT VE SEPET BUTONU -->
                    <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                        <span class="card-coffee-price">$@item.Price</span>
                        <button data-id="@item.Id" class="btn btn-add-gold d-flex align-items-center basket-add-btn">
                            <i class="fas fa-plus me-1"></i> ADD
                        </button>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</section>

<!-- MODALLAR -->
@foreach (var item in Model.Products)
{
<div class="modal fade" id="imageModal-@item.Id" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(10px);">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 260px;">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0 position-relative">

                <!-- KAPATMA BUTONU -->
                <button type="button" class="btn rounded-circle d-flex align-items-center justify-content-center position-absolute"
                        style="top: -10px; right: -10px; width: 45px; height: 45px; background: rgba(11,7,5,0.9); backdrop-filter: blur(5px); border: 2px solid #CBA258; color: #CBA258; z-index: 9999; box-shadow: 0 4px 15px rgba(0,0,0,0.6);"
                        onmouseover="this.style.background='#CBA258'; this.style.color='#0b0705';"
                        onmouseout="this.style.background='rgba(11,7,5,0.9)'; this.style.color='#CBA258';"
                        data-dismiss="modal" data-bs-dismiss="modal">
                    <i class="fas fa-times fs-5"></i>
                </button>

                <img src="~/img/@item.MainImage" class="modal-custom-img" alt="@item.Name">
            </div>
        </div>
    </div>
</div>
}

<script>
    // Filtreleme JS Kodu - Sınıflar ve ID'ler korundu, animasyonlar iyileştirildi.
    document.addEventListener("DOMContentLoaded", function () {
        const filterButtons = document.querySelectorAll(".category-filter");
        const products = document.querySelectorAll(".product-wrapper");

        filterButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                filterButtons.forEach(btn => btn.classList.remove("active"));
                this.classList.add("active");
                const selectedCategoryId = this.getAttribute("data-id").toString();

                products.forEach(product => {
                    const productCategoryId = product.getAttribute("data-category").toString();
                    if (selectedCategoryId === "all" || selectedCategoryId === productCategoryId) {
                        product.classList.remove("d-none");
                        product.style.animation = 'none';
                        product.offsetHeight;
                        product.style.animation = 'fadeInScale 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards';
                    } else {
                        product.classList.add("d-none");
                    }
                });
            });
        });
    });
</script>