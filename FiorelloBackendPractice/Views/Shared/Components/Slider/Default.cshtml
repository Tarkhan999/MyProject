@model SliderVCVM

<style>
    /* Slider ana kapsayıcısı - Taşmaları kesin olarak engeller */
    #slider {
        position: relative;
        width: 100%;
        overflow: hidden; 
    }

    /* Görsellerin her ekranda mükemmel oturması için */
    .slider-image {
        width: 100%;
        height: 60vh; /* Ekran yüksekliğinin %60'ını kaplar */
        min-height: 400px; /* Mobilde çok küçülmesini engeller */
        max-height: 600px; /* Büyük ekranlarda çok uzamasını engeller */
        object-fit: cover; /* Resmi ezmeden alanı dolduracak şekilde kırpar */
        object-position: center; /* Odak noktası hep ortası olur */
        filter: brightness(0.6); /* Yazıların okunması için karartma */
    }

    /* Yazı alanının resmin üzerine ve tam ortaya oturması için */
    .slider-context {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        transform: translateY(-50%); /* Tam dikey ortalama */
        z-index: 10; /* Resimlerin önünde durması için */
        pointer-events: none; /* Yazı boşluklarının slider'ı kaydırmayı engellememesi için */
    }
    
    /* İçeriklerde tıklanabilirlik isteniyorsa geri açılır */
    .slider-context * {
        pointer-events: auto; 
    }
</style>

<!-- SLIDER START -->
<section id="slider">
    <div class="owl-carousel slider">
        @foreach (var item in Model.Sliders)
        {
            <div>
                <img src="~/img/@item.Image" alt="Slider Image" class="slider-image">
            </div>
        }
    </div>
    
    <!-- Yazı Alanı (Overlay) -->
    <div class="slider-context">
        <div class="container pl-lg-5 ml-lg-3">
            <div class="row">
                <div class="col-lg-6 col-md-8">
                    <div class="text">
                        <h1 class="text-white" style="text-shadow: 2px 2px 5px rgba(0,0,0,0.7); font-weight: bold;">
                            @Model.SliderInfo.Title
                        </h1>

                        <p class="text-white d-none d-sm-block mt-3" style="font-size: 1.1rem; line-height: 1.6; text-shadow: 1px 1px 4px rgba(0,0,0,0.7);">
                            @Model.SliderInfo.Description
                        </p>
                    </div>
                    <div class="img mt-4">
                        <!-- BUNU YAPIŞTIR -->
                        <img src="~/img/@Model.SliderInfo.SignImage" alt="Signature" class="img-fluid" style="max-width: 150px; height: auto;">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- SLIDER END -->