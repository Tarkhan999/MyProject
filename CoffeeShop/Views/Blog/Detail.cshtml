@model FiorelloBackendPractice.Views.Blog.BlogDetailUIVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    /* =========================================
       ZARA / EDITORIAL BLOG DETAIL SYSTEM
       ========================================= */
    .editorial-detail-page {
        background-color: #ffffff;
        min-height: 100vh;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #000000;
        overflow-x: hidden;
    }

    /* Back Button */
    .editorial-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #000000;
        text-decoration: none;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        border-bottom: 1px solid transparent;
        padding-bottom: 3px;
        transition: all 0.3s ease;
    }

    .editorial-back-btn:hover {
        border-bottom: 1px solid #000000;
        color: #767676;
    }

    /* Main Content Surface */
    .editorial-detail-surface {
        padding: 40px 0;
    }

    .editorial-meta {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
        margin-bottom: 25px;
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .editorial-meta span {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .editorial-title {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 48px;
        font-weight: 400;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 30px;
        line-height: 1.1;
    }

    .editorial-author-box {
        border-top: 1px solid #000000;
        border-bottom: 1px solid #000000;
        padding: 15px 0;
        margin-bottom: 40px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .editorial-author-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
    }

    .editorial-author-name {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #000000;
    }

    .editorial-desc-box {
        font-size: 13px;
        color: #333333;
        line-height: 2;
        margin-bottom: 40px;
        font-weight: 400;
        text-align: justify;
    }

    /* Buttons */
    .editorial-btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .editorial-btn-primary {
        background-color: #000000;
        color: #ffffff;
        border: 1px solid #000000;
        padding: 12px 30px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s ease;
        border-radius: 0;
    }
    
    .editorial-btn-primary:hover {
        background-color: #ffffff;
        color: #000000;
    }

    .editorial-btn-secondary {
        background-color: transparent;
        color: #000000;
        border: 1px solid #000000;
        padding: 12px 30px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.3s ease;
        border-radius: 0;
        background: none;
    }

    .editorial-btn-secondary:hover {
        background-color: #f5f5f5;
    }

    /* Image Wrapper */
    .editorial-img-wrapper {
        width: 100%;
        height: 100%;
        min-height: 500px;
        position: relative;
        cursor: zoom-in;
        overflow: hidden;
    }

    .editorial-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        filter: grayscale(100%);
        transition: filter 0.5s ease, transform 0.5s ease;
    }

    .editorial-img-wrapper:hover img {
        filter: grayscale(0%);
        transform: scale(1.02);
    }

    .editorial-img-badge {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: #ffffff;
        color: #000000;
        padding: 8px 16px;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
    }

    .editorial-img-wrapper:hover .editorial-img-badge {
        opacity: 1;
    }

    /* Modal Adjustments */
    #editorialImageModal .modal-content {
        background: transparent;
        border: none;
        border-radius: 0;
    }

    #editorialImageModal .btn-close-white {
        background-color: #ffffff;
        opacity: 1;
        border-radius: 0;
        padding: 15px;
        z-index: 1060;
        filter: invert(1);
    }
</style>

<div class="editorial-detail-page py-5 w-100">
    <div class="container pb-5 px-md-5">
        <div class="mb-5">
            <a asp-controller="Blog" asp-action="Index" class="editorial-back-btn">
                <i class="bi bi-arrow-left"></i> BACK TO JOURNAL
            </a>
        </div>

        <div class="editorial-detail-surface">
            <div class="row g-5">
                <!-- Text Column -->
                <div class="col-lg-6 d-flex flex-column justify-content-center order-2 order-lg-1">
                    
                    <div class="editorial-meta">
                        <span>
                            @Model.DateCreated.ToString("dd.MM.yyyy")
                        </span>
                        <span>
                            VIEWS: @Model.ViewsCount
                        </span>
                    </div>

                    <h1 class="editorial-title">
                        @Model.Title
                    </h1>

                    @if (!string.IsNullOrEmpty(Model.Link))
                    {
                        <div class="editorial-author-box">
                            <div>
                                <div class="editorial-author-label">CONTENT CREATOR</div>
                                <div class="editorial-author-name mt-1">@Model.Link</div>
                            </div>
                        </div>
                    }

                    <div class="editorial-desc-box">
                        @Model.Description
                    </div>

                    <div class="editorial-btn-group">
                        <a asp-controller="Home" asp-action="Index" asp-fragment="products" class="editorial-btn-primary">
                            ORDER NOW
                        </a>
                        <button class="editorial-btn-secondary">
                            SHARE
                        </button>
                    </div>
                </div>

                <!-- Image Column -->
                <div class="col-lg-6 order-1 order-lg-2">
                    <div class="editorial-img-wrapper" data-bs-toggle="modal" data-bs-target="#editorialImageModal">
                        <img src="~/img/@Model.Image" alt="@Model.Title" />
                        <span class="editorial-img-badge">
                            ENLARGE
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="editorialImageModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(5px); background-color: rgba(255, 255, 255, 0.95);">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-body text-center p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img src="~/img/@Model.Image" class="img-fluid" style="max-height: 90vh; width: auto; object-fit: contain;" alt="@Model.Title">
            </div>
        </div>
    </div>
</div>