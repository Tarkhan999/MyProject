@model IEnumerable<BlogUIVM>

<style>
    /* =========================================
       ZARA / MINIMALIST EDITORIAL (REFINED)
       ========================================= */
    .editorial-blog-page {
        background-color: #ffffff;
        min-height: 100vh;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #000000;
        overflow-x: hidden;
        padding-top: 80px; /* Space added since Hero is removed */
    }

    /* Grid & Cards Animation */
    .editorial-grid-item {
        opacity: 0;
        transform: translateY(40px);
        animation: revealUp 1s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    }

    .editorial-blog-card {
        background: transparent;
        border: none;
        border-radius: 0;
        margin-bottom: 70px;
        display: block;
        text-decoration: none !important;
        position: relative;
    }

    /* Image Wrapper with Deep Parallax & Filter Hover */
    .editorial-img-container {
        width: 100%;
        height: 500px;
        overflow: hidden;
        margin-bottom: 25px;
        position: relative;
        background-color: #fafafa;
    }

    .editorial-img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%) brightness(0.9);
        transition: transform 1.5s cubic-bezier(0.19, 1, 0.22, 1), filter 1s ease;
        will-change: transform, filter;
    }

    .editorial-blog-card:hover .editorial-img-container img {
        filter: grayscale(0%) brightness(1.05);
        transform: scale(1.04);
    }

    /* Meta Data */
    .editorial-meta {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #999999;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: color 0.4s ease;
    }

    /* Typography */
    .editorial-title {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 22px;
        font-weight: 400;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 18px;
        line-height: 1.35;
        transition: color 0.4s ease;
    }

    .editorial-desc {
        font-size: 13px;
        color: #666666;
        line-height: 1.8;
        margin-bottom: 25px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-weight: 300;
        transition: color 0.4s ease;
    }

    /* Animated Underline Button */
    .editorial-btn-read {
        display: inline-block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #000000;
        position: relative;
        padding-bottom: 8px;
    }

    .editorial-btn-read::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1px;
        background-color: #000000;
        transform: scaleX(0);
        transform-origin: right center;
        transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    }

    /* Hover States for Text */
    .editorial-blog-card:hover .editorial-meta {
        color: #000000;
    }

    .editorial-blog-card:hover .editorial-title {
        color: #555555;
    }

    .editorial-blog-card:hover .editorial-desc {
        color: #333333;
    }

    .editorial-blog-card:hover .editorial-btn-read::after {
        transform: scaleX(1);
        transform-origin: left center;
    }

    /* Keyframe Animations */
    @@keyframes revealUp {
        0% {
            opacity: 0;
            transform: translateY(40px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="editorial-blog-page">
    <div class="container px-md-5">
        <div class="row g-5 pb-5">
            @{ var index = 0; }
            @foreach (var item in Model)
            {
            /* Staggered animation delay based on grid column */
            var delay = (index % 3) * 0.2;

            <div class="col-md-6 col-lg-4 editorial-grid-item" style="animation-delay: @(delay)s;">
                <article class="w-100">
                    <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id" class="editorial-blog-card">
                        <div class="editorial-img-container">
                            <img src="~/img/@item.Image" alt="@item.Title" loading="lazy" />
                        </div>

                        <div class="editorial-meta">
                            <span>@(item.DateCreated is DateTime dt ? dt.ToString("dd.MM.yyyy") : item.DateCreated)</span>
                            <span>VIEWS: @item.ViewsCount</span>
                        </div>

                        <h2 class="editorial-title">
                            @item.Title
                        </h2>

                        <p class="editorial-desc">
                            @item.Description
                        </p>

                        <div>
                            <span class="editorial-btn-read">Read Article</span>
                        </div>
                    </a>
                </article>
            </div>
            index++;
            }
        </div>
    </div>
</div>