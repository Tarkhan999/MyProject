@model FiorelloBackendPractice.Models.Expert

@{
    ViewData["Title"] = "Barista Detay";
}

<style>
    /* =========================================
       ZARA / EDITORIAL EXPERT DETAIL SYSTEM
       ========================================= */
    .editorial-expert-page {
        background-color: #ffffff;
        min-height: 100vh;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #000000;
        overflow-x: hidden;
    }

    /* Geri Dön Butonu */
    .editorial-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #000000;
        text-decoration: none;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        border-bottom: 1px solid transparent;
        padding-bottom: 3px;
        transition: all 0.3s ease;
    }

    .editorial-back-btn:hover {
        border-bottom: 1px solid #000000;
        color: #767676;
    }

    /* Görsel Çerçeve & Efekt */
    .editorial-expert-img-wrapper {
        width: 100%;
        height: 620px;
        overflow: hidden;
        border: 1px solid #000000;
        position: relative;
    }

    .editorial-expert-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
        transition: filter 0.8s ease, transform 0.8s ease;
    }

    .editorial-expert-img-wrapper:hover img {
        filter: grayscale(0%);
        transform: scale(1.02);
    }

    /* Tipografi */
    .editorial-category {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
        margin-bottom: 15px;
        display: block;
    }

    .editorial-name {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 52px;
        font-weight: 400;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 10px;
        line-height: 1;
    }

    .editorial-position {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 35px;
    }

    .editorial-quote {
        font-size: 13px;
        color: #333333;
        line-height: 2;
        margin-bottom: 45px;
        font-weight: 400;
        border-left: 1px solid #000000;
        padding-left: 20px;
    }

    /* Uzmanlık Alanları Izgarası */
    .editorial-skills-grid {
        border-top: 1px solid #000000;
        padding-top: 25px;
        display: flex;
        gap: 40px;
        flex-wrap: wrap;
    }

    .editorial-skill-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .editorial-skill-title {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #000000;
    }

    .editorial-skill-sub {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #767676;
    }
</style>

<div class="editorial-expert-page py-5 w-100">
    <div class="container pb-5 px-md-5">
        
        <!-- Geri Dön -->
        <div class="row mb-5">
            <div class="col-12">
                <a asp-controller="Home" asp-action="Index" class="editorial-back-btn">
                    <i class="bi bi-arrow-left"></i> GERİ DÖN
                </a>
            </div>
        </div>

        <div class="row align-items-center justify-content-between g-5">
            
            <!-- SOL TARAF: FOTOĞRAF -->
            <div class="col-lg-5">
                <div class="editorial-expert-img-wrapper">
                    <img src="~/img/@Model.ImageUrl" alt="@Model.FullName">
                </div>
            </div>

            <!-- SAĞ TARAF: BİLGİLER -->
            <div class="col-lg-6 ps-lg-5">
                
                <span class="editorial-category">KAHVE SANATKARI</span>
                
                <h1 class="editorial-name">
                    @Model.FullName
                </h1>
                
                <div class="editorial-position">
                    @Model.Position
                </div>
                
                <div class="editorial-quote">
                    "Her kahve çekirdeğinin anlatacak bir hikayesi vardır. Benim işim, o hikayeyi fincanınıza en pürüzsüz ve en zengin haliyle taşımak. Mükemmel espresso bir tesadüf değil, tutku ve tekniğin buluştuğu noktadır."
                </div>

                <div class="editorial-skills-grid">
                    <div class="editorial-skill-item">
                        <span class="editorial-skill-title">LATTE ART</span>
                        <span class="editorial-skill-sub">EXPERT LEVEL</span>
                    </div>
                    <div class="editorial-skill-item">
                        <span class="editorial-skill-title">ROASTING</span>
                        <span class="editorial-skill-sub">MASTER</span>
                    </div>
                    <div class="editorial-skill-item">
                        <span class="editorial-skill-title">SIGNATURE</span>
                        <span class="editorial-skill-sub">CRAFT BREW</span>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>