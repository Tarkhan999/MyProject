@model FiorelloBackendPractice.Models.Expert

@{
    ViewData["Title"] = "Barista Detay";
}

<!-- Sayfa Arka Planı (Tamamen koyu ve minimalist) -->
<section class="min-vh-100 py-5" style="background-color: #080808; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <div class="container mt-5">
        
        <!-- Şık ve İnce Geri Dön Butonu -->
        <div class="row mb-5">
            <div class="col-12">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-inline-flex align-items-center" style="color: #a0a0a0; letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem; transition: color 0.3s ease;" onmouseover="this.style.color='#CBA258'" onmouseout="this.style.color='#a0a0a0'">
                    <i class="bi bi-arrow-left me-3 fs-5"></i> Geri Dön
                </a>
            </div>
        </div>

        <div class="row align-items-center justify-content-between pb-5">
            
            <!-- SOL TARAF: BÜYÜK ÇERÇEVELİ FOTOĞRAF -->
            <div class="col-lg-5 mb-5 mb-lg-0">
                <div class="position-relative" style="padding: 20px;">
                    
                    <!-- Dış Altın Çerçeve Efekti (Fotoğrafın arkasından kaymış zarif çizgi) -->
                    <div class="position-absolute" style="top: 0; left: 0; right: 40px; bottom: 40px; border: 1px solid rgba(203, 162, 88, 0.4); z-index: 0;"></div>
                    
                    <!-- Paspartu (İç Çerçeve / Galeri Görünümü) -->
                    <div class="position-relative z-1 shadow-lg p-3" style="background: #121212; transform: translate(20px, 20px);">
                        
                        <!-- Ana Fotoğraf -->
                        <img src="~/img/@Model.ImageUrl" class="img-fluid w-100 object-fit-cover shadow" 
                             style="height: 600px; filter: contrast(1.1) brightness(0.95);" 
                             alt="@Model.FullName">
                             
                    </div>
                </div>
            </div>

            <!-- SAĞ TARAF: BİLGİLER VE MİNİMALİST DETAYLAR -->
            <div class="col-lg-6 text-white ps-lg-5 mt-4 mt-lg-0">
                
                <!-- Altın Renkli İnce Çizgi ve Üst Başlık -->
                <div class="d-flex align-items-center mb-4">
                    <div style="width: 40px; height: 1px; background-color: #CBA258;" class="me-3"></div>
                    <span class="text-uppercase" style="color: #CBA258; letter-spacing: 4px; font-size: 0.85rem; font-weight: 600;">
                        Kahve Sanatkarı
                    </span>
                </div>
                
                <!-- İsim -->
                <h1 class="fw-bold mb-2" style="font-size: 4rem; letter-spacing: -1px; text-shadow: 0 5px 15px rgba(0,0,0,1);">
                    @Model.FullName
                </h1>
                
                <!-- Pozisyon -->
                <h3 class="mb-5" style="color: #00d28a; font-weight: 300; font-size: 1.5rem; letter-spacing: 1px;">
                    @Model.Position
                </h3>
                
                <!-- Açıklama / Alıntı (Şık, ince font) -->
                <div class="position-relative mb-5 pe-lg-4">
                    <i class="bi bi-quote position-absolute" style="font-size: 5rem; color: rgba(255,255,255,0.03); top: -35px; left: -20px;"></i>
                    <p class="fs-5" style="line-height: 2; color: #999; font-weight: 300;">
                        "Her kahve çekirdeğinin anlatacak bir hikayesi vardır. Benim işim, o hikayeyi fincanınıza en pürüzsüz ve en zengin haliyle taşımak. Mükemmel espresso bir tesadüf değil, tutku ve tekniğin buluştuğu noktadır."
                    </p>
                </div>

                <!-- Alt Detay İkonları (Uzmanlık alanları) -->
                <div class="d-flex gap-5 mt-5 pt-4" style="border-top: 1px solid rgba(255,255,255,0.05);">
                    <div>
                        <i class="bi bi-cup-hot mb-2 d-block" style="color: #CBA258; font-size: 1.5rem;"></i>
                        <span style="color: #666; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase;">Latte Art</span>
                    </div>
                    <div>
                        <i class="bi bi-moisture mb-2 d-block" style="color: #CBA258; font-size: 1.5rem;"></i>
                        <span style="color: #666; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase;">Roasting</span>
                    </div>
                    <div>
                        <i class="bi bi-stars mb-2 d-block" style="color: #CBA258; font-size: 1.5rem;"></i>
                        <span style="color: #666; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase;">Signature</span>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</section>