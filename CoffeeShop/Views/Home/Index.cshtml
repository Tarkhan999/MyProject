@model HomeVM

@{
ViewData["Title"] = "Home Page";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    /* 0. SLIDER BÜYÜK (HERO) GÖRSEL HİZALAMASI */
    #slider {
        position: relative;
        height: 100vh;
        width: 100%; /* 200% yerine 100% olmalı */
        overflow: hidden;
    }

    #slider .owl-carousel,
    #slider .owl-carousel .owl-stage-outer,
    #slider .owl-carousel .owl-item,
    #slider .owl-carousel .item {
        height: 100vh !important; /* 250vh çok fazlaydı, resimle (100vh) eşitlendi */
    }

    /* Sadece ana arka plan görselini hedefler, küçük görseli bozmaz */
    #slider .owl-carousel .item > img,
    #slider > section > img,
    #slider img.bg-img {
        width: 100% !important;
        height: 100vh !important;
        object-fit: cover !important;
        object-position: center !important;
        display: block !important;
    }

    /* Arka plan CSS'den (background-image) geliyorsa diye yedek kural */
    #slider .owl-carousel .item {
        background-size: cover !important;
        background-position: center !important;
    }

    /* SLIDER İÇİNDEKİ KÜÇÜK GÖRSEL */
    #slider .img.mt-4 img {
        width: auto !important;
        max-width: 280px !important;
        height: auto !important;
        border-radius: 12px !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4) !important;
        animation: floatSignature 5s ease-in-out infinite !important;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease !important;
        cursor: pointer !important;
    }

    #slider .img.mt-4 img:hover {
        transform: scale(1.08) translateY(-5px) !important;
        box-shadow: 0 15px 35px rgba(203, 162, 88, 0.4) !important;
    }

    @@keyframes floatSignature {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-12px); }
        100% { transform: translateY(0px); }
    }

    /* 1. Instagram Görselleri Hizalaması */
    #instagram .owl-carousel img,
    #instagram img {
        height: 450px !important;
        width: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
        border-radius: 16px;
    }

    /* 2. About (Hakkımızda) Görsel Hizalaması */
    #about img {
        height: 650px !important;
        width: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
    }

    /* 3. Barista (Experts) Görsel Hizalaması */
    #experts .img img {
        width: 200px !important;
        height: 200px !important;
        object-fit: cover !important;
        border-radius: 50% !important;
    }

    /* DİNAMİK HAREKETLİ ARKA PLAN */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .animated-bg {
        background: transparent;
        background-size: 400% 400%;
        animation: gradientMove 15s ease infinite;
        min-height: 100vh;
    }

    /* VİDEO ARKA PLAN STANDARTLARI */
    .video-bg-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -2;
        overflow: hidden;
        background-color: #000;
    }

    .video-bg-container video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.35;
        transform: scale(1.05);
    }

    .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(13,8,5,0.9) 0%, rgba(13,8,5,0.4) 50%, rgba(13,8,5,0.9) 100%);
        z-index: -1;
    }

    /* ANİMASYONLAR */
    .anim-up {
        opacity: 0;
        transform: translateY(120px);
        transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1), transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    .anim-left {
        opacity: 0;
        transform: translateX(-120px);
        transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1), transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    .anim-right {
        opacity: 0;
        transform: translateX(120px);
        transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1), transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    .anim-up.is-visible, .anim-left.is-visible, .anim-right.is-visible {
        opacity: 1;
        transform: translate(0);
    }

    .stagger-wrap .stagger-item {
        opacity: 0;
        transform: translateY(80px);
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .stagger-wrap.is-visible .stagger-item:nth-child(1) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
    .stagger-wrap.is-visible .stagger-item:nth-child(2) { transition-delay: 0.25s; opacity: 1; transform: translateY(0); }
    .stagger-wrap.is-visible .stagger-item:nth-child(3) { transition-delay: 0.4s; opacity: 1; transform: translateY(0); }
    .stagger-wrap.is-visible .stagger-item:nth-child(4) { transition-delay: 0.55s; opacity: 1; transform: translateY(0); }
    .stagger-wrap.is-visible .stagger-item:nth-child(5) { transition-delay: 0.7s; opacity: 1; transform: translateY(0); }

    .glass-panel {
        background: black;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(203, 162, 88, 0.15);
        border-radius: 24px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .glass-panel:hover {
        border-color: rgba(0, 112, 74, 0.4);
        transform: translateY(-5px);
    }

    @@keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }
    .floating-img {
        animation: float 6s ease-in-out infinite;
    }
</style>

<!-- VİDEO ARKA PLAN KONTEYNERİ -->
<div class="video-bg-container">
    <video autoplay loop muted playsinline>
        <source src="https://cdn.coverr.co/videos/coverr-pouring-coffee-into-a-cup-2814/1080p.mp4" type="video/mp4">
    </video>
    <div class="video-overlay"></div>
</div>

<!-- YÜZEN ÇARK BUTONU (Güncellenmiş) -->
<button type="button" data-toggle="modal" data-target="#wheelModal" 
        class="btn rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center"
        style="background-color: rgba(0, 112, 74, 0.8); backdrop-filter: blur(5px); color: white; bottom: 30px; right: 30px; width: 70px; height: 70px; z-index: 999999; border: 2px solid #CBA258; cursor: pointer; transition: all 0.3s ease;"
        onmouseover="this.style.transform='scale(1.1)'; document.getElementById('wheelIcon').style.transform='rotate(180deg)';"
        onmouseout="this.style.transform='scale(1)'; document.getElementById('wheelIcon').style.transform='rotate(0deg)';">
    <i class="bi bi-arrow-repeat display-6" id="wheelIcon" style="transition: transform 0.5s ease; color: #CBA258;"></i>
</button>

<!-- GÜNÜN KAHVESİ ÇARK MODALI -->
<div class="modal fade" id="wheelModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(15px); z-index: 9999999;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4 glass-panel" style="background: rgba(18, 13, 10, 0.85); border: 2px solid #00704A; color: #ffffff;">
            <div class="modal-header border-0 justify-content-center pb-0">
                <h3 class="fw-bold mb-0" style="color: #FBF8F1;">Günün Kahvesini Seç! 🎯</h3>
            </div>
            <div class="modal-body py-4 d-flex flex-column align-items-center">
                <div style="position: relative; width: 300px; height: 300px; margin: 20px auto;">
                    <div style="position: absolute; top: -15px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 15px solid transparent; border-right: 15px solid transparent; border-top: 30px solid #CBA258; z-index: 10; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5));"></div>
                    <canvas id="wheelCanvas" width="300" height="300" class="shadow-lg rounded-circle" style="border: 4px solid #00704A; transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99); background-color: #1e3932;"></canvas>
                </div>
                <h4 id="coffeeResult" class="fw-bold mt-2 mb-4" style="min-height: 35px; color: #CBA258; font-size: 1.3rem;">Şansını dene!</h4>
                <div class="d-flex justify-content-center gap-2">
                    <button id="spinBtn" type="button" class="btn px-5 py-2 rounded-pill fw-bold text-white shadow" style="background: linear-gradient(45deg, #00704A, #053b26); border: none; font-size: 1.1rem; z-index: 10;">Çarkı Çevir</button>
                    <button type="button" class="btn px-4 py-2 rounded-pill text-white" data-dismiss="modal" style="background-color: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KAHVE BREAK MODAL -->
<div class="modal fade" id="coffeeModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(15px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4 glass-panel" style="background: rgba(18, 13, 10, 0.85); border: 2px solid #00704A; color: #ffffff;">
            <div class="modal-body py-4">
                <div class="mb-3 floating-img">
                    <i class="bi bi-cup-hot display-1" style="color: #CBA258;"></i>
                </div>
                <h3 class="fw-bold mb-2" style="color: #FBF8F1;">Take a Coffee Break! ☕</h3>
                <p style="color: #c4c4c4; font-size: 0.95rem;">
                    Günün yoğunluğuna kısa bir ara ver. Taze kavrulmuş Starbucks kahveleriyle enerjini tazele!
                </p>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a href="#products" onclick="$('#coffeeModal').modal('hide');" class="btn px-4 py-2 rounded-pill fw-bold text-white text-decoration-none shadow" style="background: linear-gradient(45deg, #00704A, #053b26); border: none;">Order Now</a>
                    <button type="button" class="btn px-4 py-2 rounded-pill text-white" data-bs-dismiss="modal" style="background-color: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<main id="mainContent" class="animated-bg" style="clear: both; overflow-x: hidden;">

    <!-- SLIDER -->
    <div id="slider" class="anim-up is-visible">
        @await Component.InvokeAsync("Slider")
    </div>

    <!-- PRODUCTS -->
    <div class="anim-up">
        @await Component.InvokeAsync("Product")
    </div>

    <!-- ABOUT SECTION -->
    @if (Model.AboutInfo != null)
    {
    <section id="about" style="padding: 80px 0; position: relative;">
        <div class="container my-5 glass-panel p-5">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0 anim-left">
                    <div class="img position-relative shadow-lg rounded-4 overflow-hidden floating-img" style="border: 2px solid rgba(0, 112, 74, 0.5);">
                        <a asp-controller="Home" asp-action="AboutDetail" asp-route-id="@Model.AboutInfo.Id" class="d-block w-100 h-100">
                            <img src="~/img/@Model.AboutInfo.ImageUrl" class="img-fluid" alt="About Image">
                        </a>
                    </div>
                </div>

                <div class="col-lg-6 anim-right">
                    <div class="about-text px-lg-4">
                        <h1 class="fw-bold display-6 mb-4 text-white" style="text-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                            @Model.AboutInfo.Title <span style="color: #00704A;">@Model.AboutInfo.HighlightedText</span> <br>Coffee
                        </h1>
                        <p class="py-3 fs-6 leading-relaxed border-start border-4 ps-4 rounded-end" style="border-color: #00704A !important; background: rgba(0, 112, 74, 0.05); color: #e0e0e0;">
                            @Model.AboutInfo.Description
                        </p>
                        <ul class="list-unstyled mt-4">
                            <li class="mt-3 d-flex align-items-center fs-6 text-white">
                                <i class="bi bi-check-circle-fill me-3" style="color: #CBA258; font-size: 1.3rem; filter: drop-shadow(0 0 5px rgba(203,162,88,0.5));"></i> @Model.AboutInfo.PointText
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    }

    <!-- EXPERTS SECTION -->
    <section id="experts" class="py-5">
        <div class="container py-4">
            <div class="row mb-5 anim-up">
                <div class="col-lg-6 mx-auto text-center">
                    <h1 class="fw-bold display-6 text-white mb-2" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Our Baristas</h1>
                    <p class="fs-6" style="color: #c4c4c4;">Mastering the art of perfect coffee</p>
                    <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 3px; background: linear-gradient(90deg, transparent, #CBA258, transparent);"></div>
                </div>
            </div>

            <div class="row g-4 justify-content-center stagger-wrap">
                @if (Model.Experts != null)
                {
                foreach (var item in Model.Experts)
                {
                <div class="col-sm-6 col-md-4 col-lg-3 stagger-item">
                    <a asp-controller="Home" asp-action="ExpertDetail" asp-route-id="@item.Id" class="text-decoration-none">
                        <div class="item text-center glass-panel h-100 py-4 px-3 position-relative overflow-hidden" style="transition: transform 0.3s ease;">
                            <div style="position:absolute; top:-50px; right:-50px; width:100px; height:100px; background:#00704A; filter:blur(60px); opacity:0.4; z-index:0;"></div>
                            <div class="img mx-auto position-relative" style="width: 200px; height: 200px; z-index:1;">
                                <img src="~/img/@item.ImageUrl" class="shadow" style="border: 3px solid rgba(203, 162, 88, 0.8);" alt="@item.FullName">
                            </div>
                            <div class="text mt-4 position-relative" style="z-index:1;">
                                <h6 class="fw-bold mb-2 text-white">@item.FullName</h6>
                                <span class="badge rounded-pill px-3 py-1" style="background: rgba(0, 112, 74, 0.3); color: #CBA258; border: 1px solid rgba(0, 112, 74, 0.5); backdrop-filter: blur(4px);">@item.Position</span>
                            </div>
                        </div>
                    </a>
                </div>
                }
                }
            </div>
        </div>
    </section>

    <!-- SUBSCRIBE / JOIN US -->
    @if (Model.SubscribeInfo != null)
    {
    <section id="subscribe" class="py-5 position-relative anim-up"
             style="background-image: url('/img/@Model.SubscribeInfo.BackgroundImageUrl'); background-size: cover; background-position: center; background-attachment: fixed;">

        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(13,8,5,1) 0%, rgba(13,8,5,0.6) 50%, rgba(13,8,5,1) 100%);"></div>

        <div class="container py-5 position-relative" style="z-index: 1;">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <div class="content p-5 glass-panel">
                        <h2 class="fw-bold mb-3 text-white display-6">@Model.SubscribeInfo.Title</h2>
                        <p class="mb-4" style="color: #d1d1d1;">@Model.SubscribeInfo.Description</p>

                        <div class="d-flex justify-content-center">
                            <div class="input-group input-group-lg shadow-lg" style="max-width: 550px; border: 1px solid rgba(203,162,88,0.4); border-radius: 50px; overflow: hidden; background: rgba(0,0,0,0.4); backdrop-filter: blur(10px);">
                                <input type="email" id="subscribeEmail" placeholder="Email Address" class="form-control border-0 px-4 py-3 text-white shadow-none" style="background-color: transparent;" aria-label="Email Address">
                                <button id="subscribeBtn" type="button" class="btn px-4 py-3 fw-bold text-uppercase border-0 text-white" style="background: linear-gradient(45deg, #00704A, #034f36); letter-spacing: 1px; transition: opacity 0.3s ease;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">Continue</button>
                            </div>
                        </div>
                        <div id="subscribeMessage" class="mt-3 fw-bold" style="min-height: 24px; text-shadow: 0 2px 4px rgba(0,0,0,0.8);"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    }

    <!-- BLOG -->
    <section id="blog" class="py-5 anim-up">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-6 mx-auto text-center">
                    <h1 class="fw-bold display-6 text-white mb-2" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">From Coffee Blog</h1>
                    <p class="fs-6" style="color: #c4c4c4;">Stories behind the finest coffee beans</p>
                    <div class="mx-auto rounded-pill mt-3" style="width: 60px; height: 3px; background: linear-gradient(90deg, transparent, #CBA258, transparent);"></div>
                </div>
            </div>
            <partial name="_BlogPartial" model="@Model.Blogs"/>
        </div>
    </section>

    <!-- INSTAGRAM -->
    <section id="instagram" class="position-relative overflow-hidden py-4 anim-up">
        <div class="owl-carousel instagram" style="opacity: 0.9;">
            @if (Model.InstagramPhotos != null && Model.InstagramPhotos.Any())
            {
            foreach (var photo in Model.InstagramPhotos)
            {
            <div class="px-2">
                <div class="rounded-4 overflow-hidden" style="border: 2px solid rgba(255,255,255,0.05);">
                    <img src="~/img/@photo.ImageUrl" class="img-fluid" alt="Instagram">
                </div>
            </div>
            }
            }
            else
            {
            <div class="text-white p-5 text-center w-100 glass-panel mx-auto" style="max-width:400px;">Henüz Instagram fotoğrafı yüklenmedi.</div>
            }
        </div>

        <div class="hastag position-absolute top-50 start-50 translate-middle fw-bold py-3 px-5 shadow-lg rounded-pill" style="z-index: 2; letter-spacing: 2px; background: rgba(13, 8, 5, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(203, 162, 88, 0.5); color: #ffffff;">
            <i class="bi bi-instagram me-2" style="color: #CBA258;"></i>#STARBUCKS
        </div>
    </section>

</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const animatedElements = document.querySelectorAll('.anim-up, .anim-left, .anim-right, .stagger-wrap');

        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, {
            root: null,
            rootMargin: '0px 0px -10% 0px',
            threshold: 0.1
        });

        animatedElements.forEach(el => observer.observe(el));
    });

    window.addEventListener("load", function() {

        const canvas = document.getElementById("wheelCanvas");
        if(!canvas) return;

        const ctx = canvas.getContext("2d");
        const spinBtn = document.getElementById("spinBtn");
        const resultText = document.getElementById("coffeeResult");

        const coffees = [
            "Caramel Macchiato", "White Mocha", "Cold Brew",
            "Frappuccino", "Flat White", "Caffe Americano"
        ];

        const colors = ["#00704A", "#1e3932", "#00704A", "#1e3932", "#00704A", "#1e3932"];

        let currentRotation = 0;
        let isSpinning = false;

        function drawWheel() {
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            const radius = centerX;
            const arcSize = (2 * Math.PI) / coffees.length;

            for (let i = 0; i < coffees.length; i++) {
                const angle = i * arcSize;

                ctx.beginPath();
                ctx.fillStyle = colors[i];
                ctx.moveTo(centerX, centerY);
                ctx.arc(centerX, centerY, radius, angle, angle + arcSize);
                ctx.fill();

                ctx.lineWidth = 2;
                ctx.strokeStyle = "#CBA258";
                ctx.stroke();

                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(angle + arcSize / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = "#FBF8F1";
                ctx.font = "bold 16px Arial";
                ctx.fillText(coffees[i], radius - 20, 5);
                ctx.restore();
            }
        }

        drawWheel();

        spinBtn.onclick = function() {
            if (isSpinning) return;
            isSpinning = true;
            resultText.innerHTML = "Kahveniz seçiliyor... ☕";
            resultText.style.color = "#c4c4c4";

            const randomDegree = Math.floor(Math.random() * 360);
            const totalDegree = 1800 + randomDegree;
            currentRotation += totalDegree;

            canvas.style.transform = `rotate(${currentRotation}deg)`;

            setTimeout(() => {
                isSpinning = false;

                const normalizedRotation = currentRotation % 360;
                const originalTopAngle = (630 - normalizedRotation) % 360;
                const sliceAngle = 360 / coffees.length;
                const winnerIndex = Math.floor(originalTopAngle / sliceAngle);

                resultText.innerHTML = `🎉 Çıkan Kahve: <span style='color:#CBA258'>${coffees[winnerIndex]}</span> 🎉`;
                resultText.style.color = "#ffffff";
            }, 4000);
        };
    });
</script>