@model HomeVM

@{
ViewData["Title"] = "Home Page";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    /* --- PRELOADER (Açılış Animasyonu) CSS --- */
    #editorial-preloader {
        position: fixed;
        inset: 0;
        background-color: #ffffff;
        z-index: 999999999;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1), opacity 1s ease;
    }

    #editorial-preloader.hide-preloader {
        transform: translateY(-100%);
        opacity: 0;
        pointer-events: none;
    }

    .preloader-brand-wrapper {
        overflow: hidden;
        margin-bottom: 10px;
    }

    .preloader-brand {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 1.5rem;
        letter-spacing: 0.3em;
        color: #000000;
        text-transform: uppercase;
        transform: translateY(100%);
        animation: textReveal 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        animation-delay: 0.2s;
    }

    .preloader-line {
        height: 1px;
        background-color: #000000;
        width: 0;
        animation: lineGrow 1.5s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        animation-delay: 0.5s;
    }

    @@keyframes textReveal {
        to { transform: translateY(0); }
    }

    @@keyframes lineGrow {
        to { width: 100px; }
    }

    /* --- ANA STİLLER --- */
    #mainContent {
        background-color: #ffffff;
        color: #000000;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    #mainContent *, .editorial-modal *, .btn {
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    .editorial-title {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        color: #000000;
        line-height: 1.1;
    }

    .editorial-subtitle {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #555555;
        display: block;
    }

    #slider {
        position: relative;
        height: 90vh;
        width: 100%;
        overflow: hidden;
        background-color: #f4f4f4;
    }

    #slider .owl-carousel,
    #slider .owl-carousel .owl-stage-outer,
    #slider .owl-carousel .owl-item,
    #slider .owl-carousel .item {
        height: 90vh !important;
    }

    #slider .owl-carousel .item > img,
    #slider > section > img,
    #slider img.bg-img {
        width: 100% !important;
        height: 90vh !important;
        object-fit: cover !important;
        object-position: center !important;
        filter: grayscale(15%) contrast(1.1);
    }

    #instagram .owl-carousel img,
    #instagram img {
        height: 450px !important;
        width: 100% !important;
        object-fit: cover !important;
        filter: grayscale(20%) contrast(1.05);
        transition: filter 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    #instagram .owl-carousel img:hover,
    #instagram img:hover {
        transform: scale(1.03);
        filter: grayscale(0%) contrast(1);
    }

    .image-reveal-container {
        overflow: hidden;
        position: relative;
    }

    #about img {
        height: 700px !important;
        width: 100% !important;
        object-fit: cover !important;
        background-color: #f5f5f5;
        filter: grayscale(10%);
        transform: scale(1.1);
        transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1), filter 0.8s ease;
    }

    #about .anim-left.is-visible img {
        transform: scale(1);
    }

    #about a:hover img {
        filter: grayscale(0%);
    }

    #experts .img {
        overflow: hidden;
    }

    #experts .img img {
        width: 100% !important;
        height: 420px !important;
        object-fit: cover !important;
        object-position: top center !important;
        filter: grayscale(100%);
        transform: scale(1.05);
        transition: filter 0.6s cubic-bezier(0.25, 1, 0.5, 1), transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    #experts .stagger-item:hover img {
        filter: grayscale(0%);
        transform: scale(1);
    }

    .btn-editorial-wheel {
        position: fixed;
        bottom: 40px;
        right: 40px;
        background-color: #000000;
        color: #ffffff;
        border: 1px solid #000000;
        padding: 16px 28px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        z-index: 99999;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }

    .btn-editorial-wheel:hover {
        background-color: #ffffff;
        color: #000000;
        transform: translateY(-3px);
    }

    .btn-editorial-wheel i {
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .btn-editorial-wheel:hover i {
        transform: rotate(180deg);
    }

    .editorial-modal {
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background-color: rgba(255, 255, 255, 0.4);
    }

    .editorial-modal .modal-content {
        background-color: #ffffff;
        border: 1px solid #000000;
        color: #000000;
        transform: translateY(20px);
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .editorial-modal.show .modal-content {
        transform: translateY(0);
    }

    .btn-editorial-outline, .btn-editorial-solid {
        padding: 12px 28px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    .btn-editorial-outline {
        background: transparent;
        border: 1px solid #000000;
        color: #000000;
    }

    .btn-editorial-outline:hover {
        background: #000000;
        color: #ffffff;
    }

    .btn-editorial-solid {
        background: #000000;
        border: 1px solid #000000;
        color: #ffffff;
    }

    .btn-editorial-solid:hover {
        background: #ffffff;
        color: #000000;
    }

    .anim-up {
        opacity: 0;
        transform: translateY(50px);
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .anim-left {
        opacity: 0;
        transform: translateX(-40px);
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .anim-right {
        opacity: 0;
        transform: translateX(40px);
        transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .anim-up.is-visible, .anim-left.is-visible, .anim-right.is-visible {
        opacity: 1;
        transform: translate(0);
    }

    .stagger-wrap .stagger-item {
        opacity: 0;
        transform: translateY(50px);
        transition: opacity 1s cubic-bezier(0.25, 1, 0.5, 1), transform 1s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .stagger-wrap.is-visible .stagger-item:nth-child(1) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
    .stagger-wrap.is-visible .stagger-item:nth-child(2) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
    .stagger-wrap.is-visible .stagger-item:nth-child(3) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }
    .stagger-wrap.is-visible .stagger-item:nth-child(4) { transition-delay: 0.4s; opacity: 1; transform: translateY(0); }

    .editorial-input {
        border: none;
        border-bottom: 1px solid #cccccc;
        background: transparent;
        color: #000000;
        padding: 12px 0;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        transition: border-color 0.4s ease;
    }
    .editorial-input:focus {
        outline: none;
        box-shadow: none;
        background: transparent;
        border-color: #000000;
    }
    .editorial-input::placeholder {
        color: #999999;
    }

    #subscribe {
        position: relative;
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        color: #ffffff;
    }
    #subscribe .subscribe-overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.65);
        z-index: 1;
    }
    #subscribe .container {
        position: relative;
        z-index: 2;
    }
    #subscribe .editorial-title {
        color: #ffffff;
    }
    #subscribe .editorial-subtitle,
    #subscribe .text-secondary {
        color: #cccccc !important;
    }
    #subscribe .editorial-input {
        color: #ffffff;
        border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    }
    #subscribe .editorial-input:focus {
        border-color: #ffffff;
    }
    #subscribe .editorial-input::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }
    #subscribe .btn-subscribe {
        background: #ffffff;
        border: 1px solid #ffffff;
        color: #000000;
        padding: 12px 28px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }
    #subscribe .btn-subscribe:hover {
        background: transparent;
        color: #ffffff;
    }
</style>

<!-- YÜKLEME EKRANI (PRELOADER) -->
<div id="editorial-preloader">
    <div class="preloader-brand-wrapper">
        <!-- İstersen buraya logonun ismini yaz veya <img src="logo.png"> ekle -->
        <div class="preloader-brand">MANIFEST</div>
    </div>
    <div class="preloader-line"></div>
</div>

<button type="button" data-toggle="modal" data-target="#wheelModal" class="btn-editorial-wheel d-flex align-items-center gap-2">
    <i class="bi bi-arrow-repeat fs-6" id="wheelIcon"></i>
    <span>MANIFEST</span>
</button>

<div class="modal fade editorial-modal" id="wheelModal" tabindex="-1" aria-hidden="true" style="z-index: 9999999;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="modal-header border-0 justify-content-center pb-0">
                <h4 class="editorial-title mb-0">THE SELECTION</h4>
            </div>
            <div class="modal-body py-4 d-flex flex-column align-items-center">
                <div style="position: relative; width: 280px; height: 280px; margin: 20px auto;">
                    <div style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 12px solid transparent; border-right: 12px solid transparent; border-top: 24px solid #000000; z-index: 10;"></div>
                    <canvas id="wheelCanvas" width="280" height="280" style="border: 2px solid #000000; transition: transform 4s cubic-bezier(0.2, 0.8, 0.2, 1); background-color: #ffffff;"></canvas>
                </div>
                <h6 id="coffeeResult" class="editorial-subtitle mt-3 mb-4" style="min-height: 25px; color: #000;">PRESS TO SPIN</h6>
                <div class="d-flex justify-content-center gap-3 w-100 px-3">
                    <button id="spinBtn" type="button" class="btn-editorial-solid flex-grow-1">SPIN</button>
                    <button type="button" class="btn-editorial-outline flex-grow-1" data-dismiss="modal">CLOSE</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade editorial-modal" id="coffeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-5">
            <div class="modal-body py-4">
                <p class="editorial-subtitle mb-3">MOMENT OF PAUSE</p>
                <h3 class="editorial-title mb-4">TAKE A BREAK</h3>
                <p class="text-secondary mb-5" style="font-size: 0.95rem; line-height: 1.6;">
                    Step away from the rush. Discover our carefully curated roasts crafted for the perfect moment.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="#products" data-bs-dismiss="modal" class="text-decoration-none btn-editorial-solid">DISCOVER</a>
                    <button type="button" class="btn-editorial-outline" data-bs-dismiss="modal">CLOSE</button>
                </div>
            </div>
        </div>
    </div>
</div>

<main id="mainContent">

    <div id="slider" class="anim-up is-visible">
        @await Component.InvokeAsync("Slider")
    </div>

    <div class="anim-up">
        @await Component.InvokeAsync("Product")
    </div>

    @if (Model.AboutInfo != null)
    {
    <section id="about" class="py-5 my-5">
        <div class="container-fluid px-md-5">
            <div class="row align-items-center gx-5">
                <div class="col-lg-6 mb-5 mb-lg-0 anim-left">
                    <div class="image-reveal-container">
                        <a asp-controller="Home" asp-action="AboutDetail" asp-route-id="@Model.AboutInfo.Id" class="d-block w-100">
                            <img src="~/img/@Model.AboutInfo.ImageUrl" alt="Editorial About Image">
                        </a>
                    </div>
                </div>

                <div class="col-lg-6 anim-right">
                    <div class="about-text px-lg-5">
                        <span class="editorial-subtitle">THE STORY</span>
                        <h2 class="editorial-title display-4 my-4">
                            @Model.AboutInfo.Title <br> @Model.AboutInfo.HighlightedText
                        </h2>
                        <p class="py-2 text-secondary" style="font-size: 1rem; line-height: 1.9;">
                            @Model.AboutInfo.Description
                        </p>
                        <div class="pt-4 border-top border-dark mt-5">
                            <p class="editorial-subtitle mb-0 text-dark" style="letter-spacing: 0.1em;">
                                — @Model.AboutInfo.PointText
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    }

    <section id="experts" class="py-5">
        <div class="container-fluid px-md-5 py-5 border-top border-dark">
            <div class="row mb-5 anim-up">
                <div class="col-12 text-center">
                    <span class="editorial-subtitle">THE ARTISANS</span>
                    <h2 class="editorial-title display-5 mt-3">OUR TEAM</h2>
                </div>
            </div>

            <div class="row g-4 justify-content-center stagger-wrap">
                @if (Model.Experts != null)
                {
                foreach (var item in Model.Experts)
                {
                <div class="col-6 col-md-3 stagger-item">
                    <a asp-controller="Home" asp-action="ExpertDetail" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                        <div class="item">
                            <div class="img mb-4 border border-dark">
                                <img src="~/img/@item.ImageUrl" alt="@item.FullName">
                            </div>
                            <div class="text text-center mt-3">
                                <h6 class="editorial-title mb-2" style="font-size: 1.1rem;">@item.FullName</h6>
                                <span class="editorial-subtitle" style="font-size: 0.65rem;">@item.Position</span>
                            </div>
                        </div>
                    </a>
                </div>
                }
                }
            </div>
        </div>
    </section>

    @if (Model.SubscribeInfo != null)
    {
    <section id="subscribe" class="py-5 my-5 border-top border-bottom border-dark"
             style="background-image: url('/img/@Model.SubscribeInfo.BackgroundImageUrl');">
        <div class="subscribe-overlay"></div>
        <div class="container py-5 anim-up">
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center">
                    <span class="editorial-subtitle">NEWSLETTER</span>
                    <h2 class="editorial-title display-6 my-4">@Model.SubscribeInfo.Title</h2>
                    <p class="text-secondary mb-5" style="font-size: 0.95rem; line-height: 1.6;">@Model.SubscribeInfo.Description</p>

                    <div class="d-flex justify-content-center align-items-end">
                        <div class="w-100 me-4">
                            <input type="email" id="subscribeEmail" placeholder="EMAIL ADDRESS" class="form-control editorial-input w-100" aria-label="Email Address">
                        </div>
                        <button id="subscribeBtn" type="button" class="btn-subscribe px-5 py-2" style="white-space: nowrap;">JOIN</button>
                    </div>
                    <div id="subscribeMessage" class="mt-4 editorial-subtitle" style="min-height: 20px;"></div>
                </div>
            </div>
        </div>
    </section>
    }

    <section id="blog" class="py-5 anim-up">
        <div class="container-fluid px-md-5">
            <div class="row mb-5">
                <div class="col-12 text-center">
                    <span class="editorial-subtitle">JOURNAL</span>
                    <h2 class="editorial-title display-5 mt-3">LATEST ENTRIES</h2>
                </div>
            </div>
            <partial name="_BlogPartial" model="@Model.Blogs"/>
        </div>
    </section>

    <section id="instagram" class="position-relative overflow-hidden pt-5 mt-5 anim-up border-top border-dark">
        <div class="owl-carousel instagram">
            @if (Model.InstagramPhotos != null && Model.InstagramPhotos.Any())
            {
            foreach (var photo in Model.InstagramPhotos)
            {
            <div class="border-end border-dark" style="overflow: hidden;">
                <img src="~/img/@photo.ImageUrl" alt="Instagram Editorial">
            </div>
            }
            }
        </div>

        <div class="position-absolute top-50 start-50 translate-middle py-3 px-5 bg-white border border-dark text-center" style="z-index: 2; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
            <span class="editorial-subtitle text-dark m-0">#THECOLLECTION</span>
        </div>
    </section>

</main>

<script>
    // PRELOADER KONTROLÜ
    window.addEventListener('load', function() {
        const preloader = document.getElementById('editorial-preloader');

        // Sayfa kaynakları yüklendikten sonra ufak bir estetik bekleme süresi (0.8 saniye) ekliyoruz.
        // Daha hızlı geçsin istersen 800 değerini 200 veya 300 yapabilirsin.
        setTimeout(() => {
            preloader.classList.add('hide-preloader');

            // DOM'dan kaldırmak istersen (Animasyon bitince saniye veriyoruz)
            setTimeout(() => {
                preloader.style.display = 'none';
            }, 1000);
        }, 800);
    });

    document.addEventListener("DOMContentLoaded", function () {
        const animatedElements = document.querySelectorAll('.anim-up, .anim-left, .anim-right, .stagger-wrap');

        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    requestAnimationFrame(() => {
                        entry.target.classList.add('is-visible');
                    });
                    obs.unobserve(entry.target);
                }
            });
        }, {
            root: null,
            rootMargin: '0px 0px -10% 0px',
            threshold: 0.15
        });

        animatedElements.forEach(el => observer.observe(el));
    });

    window.addEventListener("load", function() {
        const canvas = document.getElementById("wheelCanvas");
        if(!canvas) return;

        const ctx = canvas.getContext("2d");
        const spinBtn = document.getElementById("spinBtn");
        const resultText = document.getElementById("coffeeResult");

        const coffees = [
            "Caramel Macchiato", "White Mocha", "Cold Brew",
            "Frappuccino", "Flat White", "Caffe Americano"
        ];

        const colors = ["#000000", "#ffffff", "#000000", "#ffffff", "#000000", "#ffffff"];

        let currentRotation = 0;
        let isSpinning = false;

        function drawWheel() {
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            const radius = centerX;
            const arcSize = (2 * Math.PI) / coffees.length;

            for (let i = 0; i < coffees.length; i++) {
                const angle = i * arcSize;

                ctx.beginPath();
                ctx.fillStyle = colors[i];
                ctx.moveTo(centerX, centerY);
                ctx.arc(centerX, centerY, radius, angle, angle + arcSize);
                ctx.fill();

                ctx.lineWidth = 1;
                ctx.strokeStyle = "#000000";
                ctx.stroke();

                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(angle + arcSize / 2);
                ctx.textAlign = "right";

                ctx.fillStyle = (colors[i] === "#000000") ? "#ffffff" : "#000000";
                ctx.font = "600 11px 'Helvetica Neue', Arial";
                ctx.fillText(coffees[i].toUpperCase(), radius - 18, 4);
                ctx.restore();
            }
        }

        drawWheel();

        spinBtn.onclick = function() {
            if (isSpinning) return;
            isSpinning = true;
            resultText.innerHTML = "SELECTING...";
            resultText.style.color = "#767676";

            spinBtn.style.transform = "scale(0.96)";
            setTimeout(() => { spinBtn.style.transform = "none"; }, 150);

            const randomDegree = Math.floor(Math.random() * 360);
            const totalDegree = 1800 + randomDegree;
            currentRotation += totalDegree;

            canvas.style.transform = `rotate(${currentRotation}deg)`;

            setTimeout(() => {
                isSpinning = false;

                const normalizedRotation = currentRotation % 360;
                const originalTopAngle = (630 - normalizedRotation) % 360;
                const sliceAngle = 360 / coffees.length;
                const winnerIndex = Math.floor(originalTopAngle / sliceAngle);

                resultText.innerHTML = `SELECTION: ${coffees[winnerIndex].toUpperCase()}`;
                resultText.style.color = "#000000";
            }, 4000);
        };
    });
</script>