@model FiorelloBackendPractice.Models.About

@{
    ViewData["Title"] = "Hakkımızda Detay";
}

<style>
    /* =========================================
       ZARA / EDITORIAL ABOUT DETAIL SYSTEM
       ========================================= */
    .editorial-about-page {
        background-color: #ffffff;
        min-height: 100vh;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #000000;
        overflow-x: hidden;
    }

    /* Back Button */
    .editorial-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #000000;
        text-decoration: none;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        border-bottom: 1px solid transparent;
        padding-bottom: 3px;
        transition: all 0.3s ease;
    }

    .editorial-back-btn:hover {
        border-bottom: 1px solid #000000;
        color: #767676;
    }

    /* Image Styling */
    .editorial-about-img-wrapper {
        width: 100%;
        height: 650px;
        overflow: hidden;
        border: 1px solid #000000;
        position: relative;
    }

    .editorial-about-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
        transition: filter 0.8s ease, transform 0.8s ease;
    }

    .editorial-about-img-wrapper:hover img {
        filter: grayscale(0%);
        transform: scale(1.02);
    }

    /* Content Typography */
    .editorial-category {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
        margin-bottom: 15px;
        display: block;
    }

    .editorial-title {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 48px;
        font-weight: 400;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 35px;
        line-height: 1.1;
    }

    .editorial-title span {
        color: #767676;
        font-style: italic;
    }

    .editorial-description {
        font-size: 13px;
        color: #333333;
        line-height: 2;
        margin-bottom: 45px;
        font-weight: 400;
        text-align: justify;
    }

    /* Quote / Highlighted Point */
    .editorial-quote-box {
        border-left: 1px solid #000000;
        padding-left: 25px;
        margin-top: 20px;
    }

    .editorial-quote-text {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 18px;
        font-style: italic;
        color: #000000;
        line-height: 1.6;
        margin: 0;
    }
</style>

<div class="editorial-about-page py-5 w-100">
    <div class="container pb-5 px-md-5">
        
        <!-- Geri Dön -->
        <div class="row mb-5">
            <div class="col-12">
                <a asp-controller="Home" asp-action="Index" class="editorial-back-btn">
                    <i class="bi bi-arrow-left"></i> ANA SAYFAYA DÖN
                </a>
            </div>
        </div>

        <div class="row align-items-center justify-content-between g-5">
            
            <!-- SOL TARAF: FOTOĞRAF -->
            <div class="col-lg-5 mb-5 mb-lg-0">
                <div class="editorial-about-img-wrapper">
                    <img src="~/img/@Model.ImageUrl" alt="About Image Detail">
                </div>
            </div>

            <!-- SAĞ TARAF: BİLGİLER -->
            <div class="col-lg-6 ps-lg-5">
                
                <span class="editorial-category">HİKAYEMİZ</span>
                
                <h1 class="editorial-title">
                    @Model.Title <br />
                    <span>@Model.HighlightedText</span>
                </h1>
                
                <div class="editorial-description">
                    @Model.Description
                </div>
                
                <div class="editorial-quote-box">
                    <p class="editorial-quote-text">
                        "@Model.PointText"
                    </p>
                </div>
                
            </div>
        </div>
    </div>
</div>