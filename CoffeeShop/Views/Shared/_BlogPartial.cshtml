@model IEnumerable<BlogUIVM>

<div class="row pb-5 g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <!-- Tamamen Siyah Arka Plan & Yeşil Çerçeve -->
            <div class="card h-100 rounded-4 overflow-hidden shadow-lg" style="background-color: #000000; border: 2px solid #00704A;">
                
                <!-- Sabit Boyutlu Görsel Kalıbı -->
                <div class="position-relative overflow-hidden" style="height: 260px; width: 100%;">
                    <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id" class="d-block w-100 h-100">
                        <img src="~/img/@item.Image" 
                             class="w-100 h-100" 
                             alt="@item.Title" 
                             style="object-fit: cover !important; transition: transform 0.4s ease;" 
                             onmouseover="this.style.transform='scale(1.08)'" 
                             onmouseout="this.style.transform='scale(1)'" />
                    </a>
                    
                    <!-- Yeşil Rozetli Tarih Etiketi -->
                    <div class="position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill" style="background-color: rgba(0, 112, 74, 0.9); backdrop-filter: blur(4px);">
                        <small class="text-white fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i> @(item.DateCreated is DateTime dt ? dt.ToString("dd MMM yyyy") : item.DateCreated)
                        </small>
                    </div>
                </div>

                <!-- Kart İçeriği -->
                <div class="card-body d-flex flex-column p-4 text-white">
                    <h5 class="card-title fw-bold text-white mb-2 fs-5">@item.Title</h5>
                    <p class="card-text mb-4" style="color: #b0b0b0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @item.Description
                    </p>

                    <div class="mt-auto pt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid #1a1a1a;">
                        <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id" 
                           class="btn btn-sm rounded-pill px-4 fw-bold text-white" style="background-color: #00704A; border: none;">
                            Devamını Oku →
                        </a>
                        <small style="color: #00704A;"><i class="bi bi-eye me-1"></i>@item.ViewsCount</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>