@model IEnumerable<BlogUIVM>

@{
// Kartların sırayla animasyonla gelmesi için sayaç (Backend mantığı korundu)
int delayIndex = 0;
}

<style>
    /* =========================================
       ZARA STYLE - MINIMALIST YAPI
       ========================================= */
    .journal-container {
        /* Ekranın yanlarından zarif bir boşluk bırakır */
        padding: 4vw;
        background-color: #ffffff;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    /* Temiz, nefes alan, 3 kolonlu grid yapısı */
    .journal-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 4rem 2rem; /* Kartlar arası geniş ve ferah boşluklar */
    }

    /* Tablet ve Telefon uyumluluğu (Zara mantığı: Mobilde tek veya 2 kolon) */
    @@media (max-width: 992px) {
        .journal-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem 1.5rem;
        }
    }
    @@media (max-width: 768px) {
        .journal-container {
            padding: 2rem 1rem;
        }
        .journal-grid {
            grid-template-columns: 1fr;
            gap: 3rem 0;
        }
    }

    /* =========================================
       KART TASARIMI (EDİTORYAL)
       ========================================= */
    .journal-card {
        text-decoration: none !important;
        display: flex;
        flex-direction: column;

        /* Sayfa yüklendiğinde aşağıdan şeffaf gelme animasyonu */
        opacity: 0;
        transform: translateY(30px);
        animation: fadeUpMinimal 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    .journal-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 4/5; /* Moda/Editoryal standart portre oranı */
        overflow: hidden;
        background-color: transparent; /* Şeffaf zemin */
    }

    .journal-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* ARKA ŞEFFAF FON ANİMASYONU */
    .journal-overlay {
        position: absolute;
        inset: 0; /* Top, left, right, bottom 0 */
        /* Çok hafif, siyah-şeffaf bir degrade (Gradient) */
        background: linear-gradient(to top, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0) 30%);
        opacity: 0;
        transition: opacity 0.8s ease;
        z-index: 1;
    }

    /* Üzerine gelindiğinde fotoğrafın yavaşça büyümesi ve şeffaf fonun belirmesi */
    .journal-card:hover .journal-img {
        transform: scale(1.05); /* Yavaşça %5 yakınlaşır */
    }

    .journal-card:hover .journal-overlay {
        opacity: 1; /* Şeffaf karartı yumuşakça belirir */
    }

    /* =========================================
       TİPOGRAFİ (YAZILAR)
       ========================================= */
    .journal-content {
        padding-top: 1.5rem; /* Fotoğraf ile yazı arası mesafe */
        display: flex;
        flex-direction: column;
        align-items: center; /* Yazıyı merkeze hizalar */
        text-align: center;
    }

    .journal-title {
        font-size: 0.75rem; /* Oldukça küçük ve zarif punto */
        font-weight: 600;
        letter-spacing: 0.15em; /* Harf arası boşluk (Zara klasiği) */
        text-transform: uppercase;
        color: #000000;
        margin: 0;
        position: relative;
    }

    /* Yazının altından çıkan animasyonlu ince çizgi (Zarif detay) */
    .journal-title::after {
        content: '';
        display: block;
        width: 0;
        height: 1px;
        background: #000000;
        margin: 8px auto 0;
        transition: width 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .journal-card:hover .journal-title::after {
        width: 100%; /* Hover olunca çizgi tam genişliğe ulaşır */
    }

    /* =========================================
       KEYFRAMES
       ========================================= */
    @@keyframes fadeUpMinimal {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="journal-container">
    <div class="journal-grid">
        @foreach (var item in Model)
        {
        <!-- Backend mantığı aynı: delayIndex ile sıralı animasyon (stagger) -->
        <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id"
           class="journal-card"
           style="animation-delay: @(delayIndex * 0.1)s;"
           aria-label="@item.Title okumak için tıkla">

            <div class="journal-image-wrapper">
                <img src="~/img/@item.Image"
                     class="journal-img"
                     alt="@item.Title"
                     loading="lazy" />

                <!-- Hover olduğunda beliren şeffaf fon -->
                <div class="journal-overlay"></div>
            </div>

            <div class="journal-content">
                <h2 class="journal-title">@item.Title</h2>
            </div>
        </a>
        delayIndex++;
        }
    </div>
</div>