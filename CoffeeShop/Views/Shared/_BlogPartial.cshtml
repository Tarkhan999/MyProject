@model IEnumerable<BlogUIVM>

<style>
    /* =========================================
       SİNEMATİK HERO ALANI (YENİ TARZ)
       ========================================= */
    .cinematic-hero {
        position: relative;
        width: 100%;
        height: 50vh;
        min-height: 400px;
        /* Estetik, karanlık bir kahve çekirdeği/dükkanı arka planı */
        background-image: url('https://images.unsplash.com/photo-1442512595331-e89e73853f31?q=80&w=2000&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 2rem;
        margin-bottom: 5rem;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    /* Fotoğrafı sayfanın karanlık temasına yediren gradient maskesi */
    .cinematic-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, #0b0705 2%, rgba(11, 7, 5, 0.4) 60%, rgba(11, 7, 5, 0.7) 100%);
        z-index: 1;
    }

    .cinematic-content {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 0 2rem;
        animation: fadeUp 1.2s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    /* Yeni elit başlık stili */
    .new-style-title {
        color: #FBF8F1;
        font-size: 4rem;
        font-weight: 300;
        letter-spacing: 2px;
        margin-bottom: 0.5rem;
        font-family: 'Georgia', serif; 
    }

    .new-style-title strong {
        color: #00a862;
        font-weight: 600;
        font-style: italic;
    }

    .new-style-subtitle {
        color: #888888;
        font-size: 1rem;
        font-weight: 400;
        letter-spacing: 5px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
    }

    /* =========================================
       KART TASARIMI
       ========================================= */
    .premium-blog-card {
        background-color: transparent;
        border-radius: 2rem; 
        transition: transform 0.4s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .premium-blog-card:hover {
        transform: translateY(-8px);
    }

    .blog-image-wrapper {
        position: relative;
        width: 100%;
        height: 320px;
        border-radius: 2rem; 
        overflow: hidden;
        display: block;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(0, 112, 74, 0.1);
    }

    .blog-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .premium-blog-card:hover .blog-image {
        transform: scale(1.05);
    }

    .blog-content {
        padding: 0 1rem;
        text-align: center;
    }

    .blog-title {
        color: #FBF8F1;
        font-size: 1.35rem;
        font-weight: 600;
        margin-bottom: 1rem;
        transition: color 0.3s ease;
    }

    .premium-blog-card:hover .blog-title {
        color: #00a862;
    }

    /* Razor Uyarılarını Önlemek İçin @@ Kullanımı */
    @@keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 768px) {
        .new-style-title { font-size: 2.8rem; }
        .cinematic-hero { border-radius: 0; height: 40vh; margin-bottom: 3rem; }
        .blog-image-wrapper { height: 260px; }
    }
</style>

<!-- Yepyeni Sinematik Hero Alanı -->
<section class="cinematic-hero">
    <div class="cinematic-overlay"></div>
    <div class="cinematic-content">
        <div class="new-style-subtitle">Kavrulmuş Sanat</div>
        <h1 class="new-style-title">Fincandaki <strong>Hikayeler</strong></h1>
    </div>
</section>

<!-- Blog Kartları Listesi -->
<div class="container mb-5">
    <div class="row g-5">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="premium-blog-card">
                    
                    <a asp-controller="Blog" asp-action="Detail" asp-route-id="@item.Id" class="blog-image-wrapper" aria-label="@item.Title okumak için tıkla">
                        <img src="~/img/@item.Image" 
                             class="blog-image" 
                             alt="@item.Title" 
                             loading="lazy" />
                    </a>

                    <div class="blog-content">
                        <h5 class="blog-title">@item.Title</h5>
                    </div>
                    
                </article>
            </div>
        }
    </div>
</div>