@model SettingUIVM

<style>
    /* =========================================
       ZARA / EDITORIAL FOOTER SYSTEM
       ========================================= */
    .editorial-footer {
        background-color: #ffffff;
        padding: 80px 0 40px 0;
        color: #000000;
        margin-top: auto;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        border-top: 1px solid #000000;
    }

    .footer-brand {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 24px;
        font-weight: 400;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 20px;
        display: inline-block;
    }

    .footer-text {
        color: #767676;
        font-size: 12px;
        line-height: 1.8;
        margin-bottom: 30px;
        padding-right: 15px;
        letter-spacing: 0.5px;
    }

    .footer-heading {
        color: #000000;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 25px;
    }

    /* Linkler */
    .footer-link {
        color: #767676;
        text-decoration: none;
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
        display: block;
        margin-bottom: 12px;
        transition: color 0.3s ease;
    }

    .footer-link:hover {
        color: #000000;
        text-decoration: none;
    }

    /* İletişim Bilgileri */
    .footer-contact-item {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
        color: #767676;
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .footer-contact-item i {
        color: #000000;
        font-size: 14px;
        width: 15px;
        text-align: center;
    }

    /* Sosyal Medya İkonları */
    .social-icons-wrapper {
        display: flex;
        gap: 20px;
    }

    .social-icon-btn {
        color: #000000;
        text-decoration: none;
        font-size: 16px;
        transition: opacity 0.3s ease;
    }

    .social-icon-btn:hover {
        opacity: 0.5;
        color: #000000;
    }

    /* Harita - Keskin Kenar ve Siyah/Beyaz */
    .footer-map-container {
        width: 100%;
        height: 160px;
        border-radius: 0;
        overflow: hidden;
        border: 1px solid #000000;
        margin-top: 25px;
    }

    .footer-map-container iframe {
        width: 100%;
        height: 100%;
        border: 0;
        filter: grayscale(100%) contrast(120%);
    }

    /* Alt Telif Çizgisi */
    .footer-bottom {
        border-top: 1px solid #e0e0e0;
        padding-top: 30px;
        margin-top: 60px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .footer-bottom-text {
        color: #767676;
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .footer-bottom-links a {
        color: #767676;
        text-decoration: none;
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-left: 25px;
        transition: color 0.3s ease;
    }

    .footer-bottom-links a:hover {
        color: #000000;
    }
</style>

<footer class="editorial-footer">
    <div class="container px-md-5">
        <div class="row mb-4">
            <!-- 1. Sütun: Marka -->
            <div class="col-lg-4 col-md-12 mb-5 mb-lg-0">
                <span class="footer-brand">STARBUCKS</span>
                <p class="footer-text">
                    ÖZEL TASARIMLAR. YAŞAM ALANLARINIZA ŞIKLIK VE ZARAFET KATAN DETAYLAR.
                </p>

                <div class="social-icons-wrapper">
                    <a href="#" class="social-icon-btn"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-icon-btn"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="social-icon-btn"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-icon-btn"><i class="fab fa-pinterest-p"></i></a>
                </div>
            </div>

            <!-- 2. Sütun: Menü -->
            <div class="col-lg-2 col-md-6 mb-5 mb-lg-0">
                <h6 class="footer-heading">MENÜ</h6>
                <ul class="list-unstyled mb-0">
                    <li><a asp-controller="Home" asp-action="Index" class="footer-link">ANA SAYFA</a></li>
                    <li><a asp-controller="Blog" asp-action="Index" class="footer-link">JOURNAL</a></li>
                    <li><a asp-controller="Basket" asp-action="Index" class="footer-link">SEPETİM</a></li>
                </ul>
            </div>

            <!-- 3. Sütun: Destek -->
            <div class="col-lg-2 col-md-6 mb-5 mb-lg-0">
                <h6 class="footer-heading">DESTEK</h6>
                <ul class="list-unstyled mb-0">
                    <li><a asp-controller="Account" asp-action="Login" class="footer-link">HESABIM</a></li>
                    <li><a href="#" class="footer-link">SİPARİŞ TAKİBİ</a></li>
                    <li><a href="#" class="footer-link">İADE KOŞULLARI</a></li>
                    <li><a href="#" class="footer-link">S.S.S.</a></li>
                </ul>
            </div>

            <!-- 4. Sütun: İletişim & Harita -->
            <div class="col-lg-4 col-md-12">
                <h6 class="footer-heading">BİZE ULAŞIN</h6>

                <div class="footer-contact-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>LEFKOŞA / KIBRIS</span>
                </div>

                <div class="d-flex gap-4 flex-wrap mb-3">
                    <div class="footer-contact-item mb-0">
                        <i class="fas fa-phone-alt"></i>
                        <span>+90 212 555 00 00</span>
                    </div>
                    <div class="footer-contact-item mb-0">
                        <i class="fas fa-envelope"></i>
                        <a href="mailto:@Model?.Email" class="text-decoration-none" style="color: #767676;">@Model?.Email</a>
                    </div>
                </div>

                <div class="footer-map-container">
                    <iframe
                        src="https://maps.google.com/maps?q=Lefkosa,%20Kibris&t=&z=14&ie=UTF8&iwloc=&output=embed"
                        allowfullscreen=""
                        loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>

        <!-- Alt Telif Kısmı -->
        <div class="footer-bottom">
            <div class="footer-bottom-text">
                &copy; @DateTime.Now.Year <strong style="color: #000000; font-weight: 600;">TARKAN999</strong>. TÜM HAKLARI SAKLIDIR.
            </div>
            <div class="footer-bottom-links">
                <a href="#">GİZLİLİK POLİTİKASI</a>
                <a href="#">KULLANICI SÖZLEŞMESİ</a>
                <a href="#">ÇEREZ POLİTİKASI</a>
            </div>
        </div>
    </div>
</footer>