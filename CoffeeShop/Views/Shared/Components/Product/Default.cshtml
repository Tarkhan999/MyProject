@model ProductVCVM

<style>
    /* ÜRÜNLER ALANI */
    #products-section {
        background: transparent;
        padding-top: 100px;
        padding-bottom: 120px;
        position: relative;
        z-index: 5;
    }

    /* KATEGORİ FİLTRE MENÜSÜ - PREMIUM GLASSMORPHISM */
    .filter-bar {
        background: rgba(11, 7, 5, 0.4);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(203, 162, 88, 0.3);
        border-radius: 60px;
        padding: 15px 35px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
    }

    .filter-bar a {
        color: rgba(251, 248, 241, 0.6) !important;
        font-family: 'Outfit', sans-serif;
        font-weight: 500;
        font-size: 1rem;
        letter-spacing: 2px;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        padding: 12px 28px;
        border-radius: 40px;
        display: inline-block;
    }

    .filter-bar a:hover,
    .filter-bar a.active {
        color: #0b0705 !important;
        background: linear-gradient(45deg, #CBA258, #e5c88c);
        font-weight: 700;
        box-shadow: 0 8px 25px rgba(203, 162, 88, 0.4);
        transform: translateY(-3px);
    }

    .product-grid-row {
        margin-top: 100px;
    }

    /* ŞEFFAF KART TASARIMI (GLASS-CARD) */
    .glass-card {
        background: linear-gradient(145deg, rgba(5, 59, 38, 0.1) 0%, rgba(2, 26, 17, 0.3) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 40px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        padding: 0 25px 35px;
        margin-top: 60px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
    }

    .glass-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 30px 60px rgba(0, 112, 74, 0.2), 0 0 30px rgba(203, 162, 88, 0.1);
        border-color: rgba(203, 162, 88, 0.4);
        background: linear-gradient(145deg, rgba(5, 59, 38, 0.25) 0%, rgba(2, 26, 17, 0.5) 100%);
    }

    /* DAİRESEL DIŞARI TAŞAN FOTOĞRAF */
    .circle-img-container {
        width: 180px;
        height: 180px;
        margin: -90px auto 30px;
        border-radius: 50%;
        border: 6px solid #111;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        overflow: hidden;
        background-color: transparent;
        position: relative;
        cursor: pointer;
        z-index: 10;
        transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .glass-card:hover .circle-img-container {
        border-color: #CBA258;
        transform: rotate(8deg) scale(1.08);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.8), 0 0 20px rgba(203,162,88,0.3);
    }

    .circle-img-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .img-hover-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(2, 26, 17, 0.6);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.4s ease;
        color: #CBA258;
        font-size: 2.5rem;
    }

    .circle-img-container:hover .img-hover-overlay {
        opacity: 1;
    }

    .card-coffee-title {
        color: #FBF8F1;
        font-size: 1.4rem;
        font-family: 'Playfair Display', serif;
        letter-spacing: 1px;
        font-weight: 700;
        margin-bottom: 8px;
        text-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }

    .card-coffee-price {
        color: #CBA258;
        font-size: 1.8rem;
        font-weight: 700;
        font-family: 'Outfit', sans-serif;
        text-shadow: 0 0 15px rgba(203,162,88,0.3);
    }

    .btn-add-gold {
        border: 1px solid rgba(203, 162, 88, 0.6);
        color: #CBA258;
        border-radius: 40px;
        padding: 10px 28px;
        font-size: 0.95rem;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        letter-spacing: 2px;
        background: rgba(203, 162, 88, 0.05);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .btn-add-gold:hover {
        background: linear-gradient(45deg, #CBA258, #e5c88c) !important;
        color: #0b0705 !important;
        box-shadow: 0 10px 25px rgba(203, 162, 88, 0.5);
        transform: translateY(-3px) scale(1.05);
    }

    @@keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.9) translateY(40px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .product-wrapper {
        animation: fadeInScale 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .modal-custom-img {
        width: 350px;
        height: 350px;
        object-fit: cover;
        border-radius: 50%;
        border: 6px solid #CBA258;
        box-shadow: 0 25px 60px rgba(0,0,0,0.9), 0 0 50px rgba(203,162,88,0.4);
    }
</style>

<section id="products-section" class="reveal">
    <div class="container">

        <!-- FİLTRE MENÜSÜ -->
        <div class="row justify-content-center mb-5 pb-4">
            <div class="col-12 col-lg-10">
                <div class="filter-bar d-flex justify-content-center align-items-center flex-wrap gap-4">
                    <ul class="category d-flex list-unstyled mb-0 gap-3 flex-wrap align-items-center justify-content-center w-100">
                        <li><a href="javascript:void(0)" data-id="all" class="text-uppercase category-filter active">All Blends</a></li>
                        @foreach (var item in Model.Categories)
                        {
                        <li><a href="javascript:void(0)" data-id="@item.Id" class="text-uppercase category-filter">@item.Name</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- ÜRÜN KARTLARI IZGARASI -->
        <div class="row product-grid-row gx-5 gy-4" id="product-list">
            @foreach (var item in Model.Products)
            {
            <div class="col-sm-6 col-md-4 col-lg-3 mb-5 pb-4 product-wrapper" data-category="@item.CategoryId">
                <div class="glass-card text-center d-flex flex-column h-100">
                    <!-- DAİRESEL RESİM -->
                    <div class="circle-img-container" data-bs-toggle="modal" data-bs-target="#imageModal-@item.Id">
                        <img src="~/img/@item.MainImage" alt="@item.Name">
                        <div class="img-hover-overlay">
                            <i class="fas fa-search-plus"></i>
                        </div>
                    </div>

                    <!-- BAŞLIK & TÜR -->
                    <div class="title mt-2 flex-grow-1 px-3">
                        <h6 class="card-coffee-title">@item.Name</h6>
                        <p style="color: rgba(251, 248, 241, 0.5); font-size: 0.8rem; font-family: 'Outfit', sans-serif; letter-spacing: 3px; text-transform: uppercase;">Premium Blend</p>
                    </div>

                    <!-- FİYAT VE SEPET BUTONU -->
                    <div class="d-flex justify-content-between align-items-center mt-auto pt-4 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                        <span class="card-coffee-price">$@item.Price</span>
                        <button data-id="@item.Id" class="btn btn-add-gold d-flex align-items-center basket-add-btn">
                            <i class="fas fa-plus me-2"></i> ADD
                        </button>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</section>

<!-- MODALLAR -->
@foreach (var item in Model.Products)
{
<div class="modal fade" id="imageModal-@item.Id" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(20px);">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 350px;">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0 position-relative">

                <!-- KAPATMA BUTONU -->
                <button type="button" class="btn rounded-circle d-flex align-items-center justify-content-center position-absolute"
                        style="top: -20px; right: -20px; width: 55px; height: 55px; background: rgba(11,7,5,0.9); backdrop-filter: blur(10px); border: 2px solid #CBA258; color: #CBA258; z-index: 9999; box-shadow: 0 5px 20px rgba(0,0,0,0.8); transition: all 0.3s ease;"
                        onmouseover="this.style.background='#CBA258'; this.style.color='#0b0705'; this.style.transform='rotate(90deg) scale(1.1)';"
                        onmouseout="this.style.background='rgba(11,7,5,0.9)'; this.style.color='#CBA258'; this.style.transform='rotate(0) scale(1)';"
                        data-bs-dismiss="modal">
                    <i class="fas fa-times fs-4"></i>
                </button>

                <img src="~/img/@item.MainImage" class="modal-custom-img" alt="@item.Name">
            </div>
        </div>
    </div>
</div>
}

<script>
    // FİLTRELEME İŞLEMİ
    document.addEventListener("DOMContentLoaded", function () {
        const filterButtons = document.querySelectorAll(".category-filter");
        const products = document.querySelectorAll(".product-wrapper");

        filterButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                filterButtons.forEach(btn => btn.classList.remove("active"));
                this.classList.add("active");
                const selectedCategoryId = this.getAttribute("data-id").toString();

                products.forEach(product => {
                    const productCategoryId = product.getAttribute("data-category").toString();
                    if (selectedCategoryId === "all" || selectedCategoryId === productCategoryId) {
                        product.classList.remove("d-none");
                        product.style.animation = 'none';
                        product.offsetHeight; // trigger reflow
                        product.style.animation = 'fadeInScale 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards';
                    } else {
                        product.classList.add("d-none");
                    }
                });
            });
        });
    });
</script>