@model ProductVCVM

<style>
    /* =========================================
       ZARA / EDITORIAL MINIMALIST TASARIM SİSTEMİ
       ========================================= */
    #products-section {
        background-color: #ffffff;
        color: #000000;
        padding-top: 60px;
        padding-bottom: 120px;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    /* KATEGORİ FİLTRE MENÜSÜ (Minimalist & Typographic) */
    .filter-bar {
        border-bottom: 1px solid #e5e5e5;
        padding-bottom: 15px;
        margin-bottom: 50px;
        display: flex;
        justify-content: center;
    }

    .filter-bar ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 2.5rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .category-filter {
        color: #767676 !important;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 2px;
        text-decoration: none;
        text-transform: uppercase;
        padding: 8px 0;
        position: relative;
        transition: color 0.3s ease;
    }

    .category-filter::after {
        content: '';
        position: absolute;
        bottom: -16px;
        left: 0;
        width: 0%;
        height: 1px;
        background-color: #000000;
        transition: width 0.3s ease;
    }

    .category-filter:hover,
    .category-filter.active {
        color: #000000 !important;
        font-weight: 600;
    }

    .category-filter:hover::after,
    .category-filter.active::after {
        width: 100%;
    }

    /* ÜRÜN KARTLARI (Sharp Geometry & High Aspect Ratio) */
    .editorial-product-card {
        background: #ffffff;
        border: none;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .product-image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 3 / 4; /* Dikdörtgen editoryal moda görünümü */
        background-color: #f5f5f5;
        overflow: hidden;
        cursor: pointer;
    }

    .product-image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .editorial-product-card:hover .product-image-container img {
        transform: scale(1.04);
    }

    .img-hover-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: #ffffff;
        font-size: 1.5rem;
    }

    .product-image-container:hover .img-hover-overlay {
        opacity: 1;
    }

    /* BİLGİ VE BÜTÜNLEŞİK BUTON */
    .product-info-wrapper {
        padding-top: 15px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        text-align: left; /* Zara genellikle bilgileri sola yaslar */
    }

    .card-product-title {
        color: #000000;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .card-product-price {
        color: #000000;
        font-size: 0.85rem;
        font-weight: 400;
        margin-bottom: 15px;
    }

    /* KESKİN SİYAH ADD BUTONU */
    .btn-add-editorial {
        border: 1px solid #000000;
        color: #000000;
        border-radius: 0; /* Keskin köşeler */
        padding: 10px 0;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 2px;
        background: transparent;
        transition: all 0.3s ease;
        text-transform: uppercase;
        width: 100%; /* Tam genişlik buton */
        margin-top: auto;
    }

    .btn-add-editorial:hover {
        background: #000000 !important;
        color: #ffffff !important;
    }

    /* ANİMASYON */
    @@keyframes fadeUpGrid {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .product-wrapper {
        animation: fadeUpGrid 0.5s ease forwards;
    }

    /* KESKİN MİNİMALİST MODAL */
    .modal-editorial-content {
        border-radius: 0 !important;
        border: none;
    }

    .modal-editorial-img {
        width: 100%;
        height: auto;
        max-height: 85vh;
        object-fit: cover;
        border-radius: 0;
    }

    .btn-modal-close {
        position: absolute;
        top: 15px;
        right: 15px;
        background: transparent;
        border: none;
        color: #000;
        font-size: 1.5rem;
        z-index: 10;
        transition: transform 0.3s ease;
    }

    .btn-modal-close:hover {
        transform: scale(1.1);
    }
</style>

<section id="products-section">
    <!-- Fluid container ile ekranın tamamına yayılma (Zara hissi) -->
    <div class="container-fluid px-4 px-md-5">

        <!-- KATEGORİ FİLTRE MENÜSÜ -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="filter-bar">
                    <ul>
                        <li><a href="javascript:void(0)" data-id="all" class="category-filter active">ALL</a></li>
                        @foreach (var item in Model.Categories)
                        {
                            <li><a href="javascript:void(0)" data-id="@item.Id" class="category-filter">@item.Name</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- ÜRÜN KARTLARI IZGARASI -->
        <div class="row gx-2 gx-md-4 gy-5" id="product-list">
            @foreach (var item in Model.Products)
            {
                <!-- Mobilde 2, tablette 3, desktopta 4 kolonlu sıkı grid -->
                <div class="col-6 col-md-4 col-lg-3 product-wrapper" data-category="@item.CategoryId">
                    <div class="editorial-product-card">
                        
                        <!-- DİKDÖRTGEN GÖRSEL ALANI -->
                        <div class="product-image-container" data-bs-toggle="modal" data-bs-target="#imageModal-@item.Id">
                            <img src="~/img/@item.MainImage" alt="@item.Name" loading="lazy">
                            <div class="img-hover-overlay">
                                <i class="fas fa-plus"></i>
                            </div>
                        </div>

                        <!-- BİLGİ VE AKSİYON -->
                        <div class="product-info-wrapper">
                            <h6 class="card-product-title">@item.Name</h6>
                            <span class="card-product-price">@item.Price USD</span>
                            
                            <!-- Orijinal `data-id` ve `basket-add-btn` class'ı korundu -->
                            <button data-id="@item.Id" class="btn btn-add-editorial basket-add-btn">
                                ADD TO BAG
                            </button>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- MODALLAR -->
@foreach (var item in Model.Products)
{
    <div class="modal fade" id="imageModal-@item.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content modal-editorial-content">
                <div class="modal-body p-0 position-relative">
                    <button type="button" class="btn-modal-close" data-bs-dismiss="modal" aria-label="Close">
                        <i class="fas fa-times"></i>
                    </button>
                    <img src="~/img/@item.MainImage" class="modal-editorial-img" alt="@item.Name">
                </div>
            </div>
        </div>
    </div>
}

<script>
    // FİLTRELEME İŞLEMİ (Mantık birebir korundu, sadece animasyon ismi güncellendi)
    document.addEventListener("DOMContentLoaded", function () {
        const filterButtons = document.querySelectorAll(".category-filter");
        const products = document.querySelectorAll(".product-wrapper");

        filterButtons.forEach(button => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                filterButtons.forEach(btn => btn.classList.remove("active"));
                this.classList.add("active");
                const selectedCategoryId = this.getAttribute("data-id").toString();

                products.forEach(product => {
                    const productCategoryId = product.getAttribute("data-category").toString();
                    if (selectedCategoryId === "all" || selectedCategoryId === productCategoryId) {
                        product.classList.remove("d-none");
                        product.style.animation = 'none';
                        product.offsetHeight; // trigger reflow
                        product.style.animation = 'fadeUpGrid 0.5s ease forwards';
                    } else {
                        product.classList.add("d-none");
                    }
                });
            });
        });
    });
</script>