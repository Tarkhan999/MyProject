@model SliderVCVM
@{
    // Videonun her zaman ilk slayt olarak gelmesini garantiler
    var orderedSliders = Model.Sliders.OrderByDescending(s => !string.IsNullOrEmpty(s.Video)).ToList();
}

<style>
    .hero-slider-section {
        position: relative;
        width: 100%;
        height: 100vh;
        background-color: #050505;
        overflow: hidden;
        font-family: 'Helvetica Neue', Arial, sans-serif;
    }

    .hero-slider-section .owl-carousel,
    .hero-slider-section .owl-carousel .owl-stage-outer,
    .hero-slider-section .owl-carousel .owl-stage,
    .hero-slider-section .owl-carousel .owl-item {
        height: 100vh !important;
    }

    /* VİDEO VE FOTOĞRAFLAR İÇİN ORTAK MEDYA SINIFI */
    .slider-media {
        width: 100% !important;
        height: 100vh !important;
        object-fit: cover !important;
        object-position: center !important;
        display: block;
        opacity: 0.85;
    }

    .vignette-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(0,0,0,0) 30%, rgba(5,5,5,0.85) 100%);
        z-index: 2;
        pointer-events: none;
    }

    .slider-context {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        transform: translateY(-50%);
        z-index: 10;
        pointer-events: none;
    }

    .slider-context * {
        pointer-events: auto;
    }

    .glass-text-box {
        background: rgba(10, 10, 10, 0.4);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-radius: 130px;
        padding: 30px;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-left: 6px solid #00704A; 
        transform: translateX(-50px);
        opacity: 0;
        animation: slideInLeft 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.5s;
    }

    @@keyframes slideInLeft {
        to { transform: translateX(0); opacity: 1; }
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 600;
        letter-spacing: -1.5px;
        color: #ffffff;
        text-shadow: 0 10px 30px rgba(0,0,0,0.8);
        margin-bottom: 15px;
        line-height: 1.1;
    }

    .hero-subtitle {
        font-size: 1.3rem;
        font-weight: 300;
        letter-spacing: 0.5px;
        color: #d1d1d1;
        margin-bottom: 40px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 25px;
    }

    .signature-frame {
        position: relative;
        width: 350px;
        height: 250px; 
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        background: #000;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .signature-frame::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border-radius: 20px;
        border: 2px solid transparent;
        background: linear-gradient(135deg, #00704A, #CBA258) border-box;
        -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: destination-out;
        mask-composite: exclude;
        opacity: 0.7;
    }

    .signature-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease;
    }

    .signature-frame:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 30px 50px rgba(0, 112, 74, 0.3);
    }

    .signature-frame:hover img {
        transform: scale(1.1);
    }

    .btn-play-glass {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

    .btn-play-glass:hover {
        background: rgba(0, 112, 74, 0.7);
        border-color: #00704A;
        transform: scale(1.1);
        color: #CBA258;
    }

    .hero-socials {
        position: absolute;
        right: 40px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        display: flex;
        flex-direction: column;
        gap: 25px;
        align-items: center;
        opacity: 0;
        animation: fadeIn 1.5s ease forwards 1s;
    }

    .hero-socials a {
        color: rgba(255,255,255,0.4);
        font-size: 1.4rem;
        transition: all 0.3s ease;
    }

    .hero-socials a:hover {
        color: #CBA258;
        transform: scale(1.3) translateY(-3px);
    }

    .social-line {
        width: 1px;
        height: 80px;
        background: linear-gradient(to bottom, rgba(255,255,255,0.3), transparent);
    }

    .scroll-indicator {
        position: absolute;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: rgba(255,255,255,0.5);
        font-size: 0.75rem;
        letter-spacing: 3px;
        text-transform: uppercase;
        opacity: 0;
        animation: fadeIn 1.5s ease forwards 1.2s;
    }

    .mouse-icon {
        width: 24px;
        height: 40px;
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 20px;
        position: relative;
        margin-bottom: 10px;
    }

    .mouse-wheel {
        width: 4px;
        height: 8px;
        background: #00704A;
        border-radius: 2px;
        position: absolute;
        top: 6px;
        left: 50%;
        transform: translateX(-50%);
        animation: scrollWheel 2s infinite cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes scrollWheel {
        0% { transform: translate(-50%, 0); opacity: 1; }
        100% { transform: translate(-50%, 18px); opacity: 0; }
    }

    @@keyframes fadeIn {
        to { opacity: 1; }
    }
</style>

<section class="hero-slider-section">

    <!-- KENAR KARARTMA -->
    <div class="vignette-overlay"></div>

    <!-- OWL CAROUSEL -->
    <div class="owl-carousel slider h-100 position-relative" style="z-index: 3;">
        @foreach (var item in Model.Sliders)
        {
            <!-- 1. Eğer video varsa ilk slayt olarak ekle -->
            @if (!string.IsNullOrEmpty(item.Video))
            {
                <div class="item h-100 w-100 position-relative">
                    <video autoplay loop muted playsinline class="slider-media video-slide">
                        <source src="~/img/@item.Video" type="video/mp4">
                    </video>
                </div>
            }
            
            <!-- 2. Eğer fotoğraf varsa onu da sonraki slayt olarak ekle -->
            @if (!string.IsNullOrEmpty(item.Image))
            {
                <div class="item h-100 w-100 position-relative">
                    <img src="~/img/@item.Image" alt="Hero Image" class="slider-media">
                </div>
            }
        }
    </div>
    
    <!-- İÇERİK KARTI -->
    <div class="slider-context">
        <div class="container ps-lg-5 ms-lg-4">
            <div class="row">
                <div class="col-xl-6 col-lg-7 col-md-9">
                    <div class="glass-text-box">
                        <h1 class="hero-title">@Model.SliderInfo.Title</h1>
                        <p class="hero-subtitle d-none d-sm-block">@Model.SliderInfo.Description</p>
                        
                        <!-- PORTRE VE VİDEO KONTROL BUTONU YAN YANA -->
                        <div class="d-flex align-items-center gap-4 mt-2">
                            @if (!string.IsNullOrEmpty(Model.SliderInfo.SignImage))
                            {
                                <div class="signature-frame">
                                    <img src="~/img/@Model.SliderInfo.SignImage" alt="Signature Highlight">
                                </div>
                            }
                            
                            <div class="video-controls d-flex flex-column align-items-center">
                                <button id="videoToggleBtn" type="button" class="btn-play-glass" aria-label="Play/Pause Video">
                                    <i class="bi bi-pause-fill" id="videoToggleIcon"></i>
                                </button>
                                <span id="videoToggleText" class="mt-2 text-white-50 fw-bold" style="font-size: 0.75rem; letter-spacing: 2px;">DURDUR</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SOSYAL MEDYA İKONLARI -->
    <div class="hero-socials d-none d-lg-flex">
        <a href="#"><i class="bi bi-instagram"></i></a>
        <a href="#"><i class="bi bi-twitter-x"></i></a>
        <a href="#"><i class="bi bi-youtube"></i></a>
        <div class="social-line"></div>
    </div>

    <!-- AŞAĞI KAYDIR ANİMASYONU -->
    <div class="scroll-indicator d-none d-sm-flex">
        <div class="mouse-icon">
            <div class="mouse-wheel"></div>
        </div>
        Keşfet
    </div>
</section>

<!-- SCRIPT ALANI -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("videoToggleBtn");
        const icon = document.getElementById("videoToggleIcon");
        const text = document.getElementById("videoToggleText");

        if (btn) {
            btn.addEventListener("click", function () {
                const activeVideo = document.querySelector(".owl-item.active .video-slide");
                if (activeVideo) {
                    if (activeVideo.paused) {
                        activeVideo.play();
                        icon.classList.replace("bi-play-fill", "bi-pause-fill");
                        text.textContent = "DURDUR";
                    } else {
                        activeVideo.pause();
                        icon.classList.replace("bi-pause-fill", "bi-play-fill");
                        text.textContent = "OYNAT";
                    }
                }
            });
        }
    });

    if (typeof jQuery !== "undefined") {
        $(document).ready(function(){
            $(".owl-carousel").owlCarousel({
                items: 1,
                loop: true,
                autoplay: true,
                autoplayTimeout: 6000, // 6 saniyede bir diğerine geçer
                smartSpeed: 800, // Kayma animasyonu hızı
                nav: false,
                dots: false,
                mouseDrag: false,
                touchDrag: false
            });
        });
    }
</script>