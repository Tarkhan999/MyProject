@model SliderVCVM

<style>
    /* 1. ID Çakışmasını önlemek için id="slider" yerine class kullanıyoruz */
    .hero-slider-section {
        position: relative;
        width: 100%;
        height: 100vh; /* Kapsayıcıyı tam ekran yap */
        overflow: hidden; 
    }

    /* 2. ESAS SORUN BURADAYDI: max-height ve 60vh kısıtlamaları kaldırıldı */
    .slider-image {
        width: 100vw !important; /* Ekran genişliği */
        height: 110vh !important; /* Ekran yüksekliği (60vh ve 600px kısıtlaması iptal) */
        object-fit: cover !important; 
        object-position: center !important; 
        filter: brightness(0.6); 
        display: block;
    }

    .slider-context {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        transform: translateY(-50%); 
        z-index: 10; 
        pointer-events: none; 
    }
    
    .slider-context * {
        pointer-events: auto; 
    }
</style>

<!-- SLIDER START (id yerine class kullanıldı) -->
<section class="hero-slider-section">
    <div class="owl-carousel slider h-100">
        @foreach (var item in Model.Sliders)
        {
            <div class="h-100">
                <img src="~/img/@item.Image" alt="Slider Image" class="slider-image">
            </div>
        }
    </div>
    
    <!-- Yazı Alanı (Overlay) -->
    <div class="slider-context">
        <div class="container pl-lg-5 ml-lg-3">
            <div class="row">
                <div class="col-lg-6 col-md-8">
                    <div class="text">
                        <h1 class="text-white" style="text-shadow: 2px 2px 5px rgba(0,0,0,0.7); font-weight: bold;">
                            @Model.SliderInfo.Title
                        </h1>

                        <p class="text-white d-none d-sm-block mt-3" style="font-size: 1.1rem; line-height: 1.6; text-shadow: 1px 1px 4px rgba(0,0,0,0.7);">
                            @Model.SliderInfo.Description
                        </p>
                    </div>
                    <div class="img mt-4">
                        <img src="~/img/@Model.SliderInfo.SignImage" alt="Signature" class="img-fluid" style="max-width: 150px; height: auto;">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- SLIDER END -->
