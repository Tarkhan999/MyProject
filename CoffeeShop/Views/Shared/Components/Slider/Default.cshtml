@model SliderVCVM
@{
    // Videonun her zaman ilk slayt olarak gelmesini garantiler
    var orderedSliders = Model.Sliders.OrderByDescending(s => !string.IsNullOrEmpty(s.Video)).ToList();
}

<style>
    /* =========================================
       ZARA / EDITORIAL HERO SLIDER SYSTEM
       ========================================= */
    .hero-slider-section {
        position: relative;
        width: 100%;
        height: 100vh;
        background-color: #000000;
        overflow: hidden;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    /* Owl Carousel Yükseklikleri (display: block zorlaması kaldırıldı) */
    .hero-slider-section .owl-carousel,
    .hero-slider-section .owl-carousel .owl-stage-outer,
    .hero-slider-section .owl-carousel .owl-stage,
    .hero-slider-section .owl-carousel .owl-item {
        height: 100vh !important;
    }

    /* MEDIA */
    .slider-media {
        width: 100% !important;
        height: 100vh !important;
        object-fit: cover !important;
        object-position: center !important;
        display: block;
        filter: grayscale(20%);
    }

    /* MINIMALIST OVERLAY */
    .editorial-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        z-index: 2;
        pointer-events: none;
    }

    /* CONTEXT BOX */
    .slider-context {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        transform: translateY(-50%);
        z-index: 10;
        pointer-events: none;
    }

    .slider-context * {
        pointer-events: auto;
    }

    /* ZARA TYPOGRAPHY */
    .hero-editorial-title {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 3.5rem;
        font-weight: 400;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: #ffffff;
        margin-bottom: 15px;
        line-height: 1.1;
        opacity: 0;
        transform: translateY(20px);
        animation: fadeUp 1s ease forwards 0.5s;
    }

    .hero-editorial-subtitle {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #e0e0e0;
        margin-bottom: 40px;
        opacity: 0;
        transform: translateY(20px);
        animation: fadeUp 1s ease forwards 0.7s;
    }

    /* SHARP PORTRAIT FRAME */
    .signature-frame {
        position: relative;
        width: 250px;
        height: 350px;
        border: 1px solid #ffffff;
        background: #000000;
        overflow: hidden;
        transition: transform 0.6s ease;
        opacity: 0;
        transform: translateY(20px);
        animation: fadeUp 1s ease forwards 0.9s;
    }

    .signature-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
        transition: filter 0.6s ease, transform 0.6s ease;
    }

    .signature-frame:hover {
        transform: scale(1.02);
    }

    .signature-frame:hover img {
        filter: grayscale(0%);
    }

    /* SHARP BUTTONS */
    .btn-editorial-square {
        width: 50px;
        height: 50px;
        background: transparent;
        border: 1px solid #ffffff;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        opacity: 0;
        transform: translateY(20px);
        animation: fadeUp 1s ease forwards 1.1s;
    }

    .btn-editorial-square:hover {
        background: #ffffff;
        color: #000000;
    }

    #videoToggleText {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 2px;
        color: #ffffff;
        opacity: 0;
        animation: fadeUp 1s ease forwards 1.2s;
    }

    /* SOCIALS - MINIMALIST */
    .hero-socials {
        position: absolute;
        right: 40px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: center;
        opacity: 0;
        animation: fadeIn 1.5s ease forwards 1s;
    }

    .hero-socials a {
        color: #ffffff;
        font-size: 1.1rem;
        transition: opacity 0.3s ease;
    }

    .hero-socials a:hover {
        opacity: 0.5;
    }

    .social-line {
        width: 1px;
        height: 60px;
        background: #ffffff;
    }

    /* SCROLL INDICATOR - SHARP LINE */
    .scroll-indicator {
        position: absolute;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #ffffff;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        opacity: 0;
        animation: fadeIn 1.5s ease forwards 1.2s;
    }

    .scroll-line-container {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.3);
        position: relative;
        margin-bottom: 15px;
        overflow: hidden;
    }

    .scroll-line {
        width: 100%;
        height: 100%;
        background: #ffffff;
        position: absolute;
        top: -100%;
        left: 0;
        animation: scrollLine 2s infinite ease-in-out;
    }

    /* KEYFRAMES */
    @@keyframes fadeUp {
        to { transform: translateY(0); opacity: 1; }
    }

    @@keyframes fadeIn {
        to { opacity: 1; }
    }

    @@keyframes scrollLine {
        0% { top: -100%; }
        50% { top: 0; }
        100% { top: 100%; }
    }
</style>

<section class="hero-slider-section">

    <!-- EDITORIAL OVERLAY -->
    <div class="editorial-overlay"></div>

    <!-- OWL CAROUSEL (id="heroSliderCarousel" eklendi) -->
    <div id="heroSliderCarousel" class="owl-carousel slider h-100 position-relative" style="z-index: 3;">
        @foreach (var item in orderedSliders)
        {
            @if (!string.IsNullOrEmpty(item.Video))
            {
                <div class="item h-100 w-100 position-relative">
                    <video autoplay loop muted playsinline class="slider-media video-slide">
                        <source src="~/img/@item.Video" type="video/mp4">
                    </video>
                </div>
            }
            @if (!string.IsNullOrEmpty(item.Image))
            {
                <div class="item h-100 w-100 position-relative">
                    <img src="~/img/@item.Image" alt="Editorial Image" class="slider-media">
                </div>
            }
        }
    </div>

    <!-- İÇERİK KARTI -->
    <div class="slider-context">
        <div class="container px-md-5">
            <div class="row">
                <div class="col-xl-7 col-lg-8 col-md-10">
                    <h1 class="hero-editorial-title">@Model.SliderInfo?.Title</h1>
                    <p class="hero-editorial-subtitle d-none d-sm-block">@Model.SliderInfo?.Description</p>

                    <div class="d-flex align-items-end gap-5 mt-5">
                        @if (Model.SliderInfo != null && !string.IsNullOrEmpty(Model.SliderInfo.SignImage))
                        {
                            <div class="signature-frame">
                                <img src="~/img/@Model.SliderInfo.SignImage" alt="Signature Detail">
                            </div>
                        }

                        <div class="video-controls d-flex flex-column align-items-center mb-3">
                            <button id="videoToggleBtn" type="button" class="btn-editorial-square" aria-label="Play/Pause Video">
                                <i class="bi bi-pause-fill" id="videoToggleIcon"></i>
                            </button>
                            <span id="videoToggleText" class="mt-3">DURDUR</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SOSYAL MEDYA İKONLARI -->
    <div class="hero-socials d-none d-lg-flex">
        <a href="#"><i class="bi bi-instagram"></i></a>
        <a href="#"><i class="bi bi-twitter-x"></i></a>
        <a href="#"><i class="bi bi-youtube"></i></a>
        <div class="social-line"></div>
    </div>

    <!-- AŞAĞI KAYDIR ANİMASYONU -->
    <div class="scroll-indicator d-none d-sm-flex">
        <div class="scroll-line-container">
            <div class="scroll-line"></div>
        </div>
        KEŞFET
    </div>
</section>

<!-- SCRIPT ALANI -->
<script>
    window.addEventListener('load', function () {
        const btn = document.getElementById("videoToggleBtn");
        const icon = document.getElementById("videoToggleIcon");
        const text = document.getElementById("videoToggleText");

        if (btn) {
            btn.addEventListener("click", function () {
                const activeVideo = document.querySelector("#heroSliderCarousel .owl-item.active .video-slide");
                if (activeVideo) {
                    if (activeVideo.paused) {
                        activeVideo.play();
                        icon.classList.replace("bi-play-fill", "bi-pause-fill");
                        text.textContent = "DURDUR";
                    } else {
                        activeVideo.pause();
                        icon.classList.replace("bi-pause-fill", "bi-play-fill");
                        text.textContent = "OYNAT";
                    }
                }
            });
        }

        if (window.jQuery && window.jQuery.fn.owlCarousel) {
            window.jQuery("#heroSliderCarousel").owlCarousel({
                items: 1,
                loop: true,
                autoplay: true,
                autoplayTimeout: 6000,
                smartSpeed: 1000,
                nav: false,
                dots: false,
                mouseDrag: true,
                touchDrag: true
            });
        }
    });
</script>