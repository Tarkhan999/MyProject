@model HeaderVM

<style>
    /* =========================================
       ZARA / EDITORIAL HEADER SYSTEM
       ========================================= */
    header.editorial-header {
        background-color: #ffffff;
        border-bottom: 1px solid #000000;
        padding: 15px 0;
        box-shadow: none;
        position: sticky;
        top: 0;
        z-index: 1050;
        width: 100%;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    .header-left-group {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .phone-badge {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .phone-badge span {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.5px;
        color: #000000;
        text-transform: uppercase;
    }

    /* --- MASAÜSTÜ MENÜ LİNKLERİ --- */
    .editorial-nav-link {
        color: #000000 !important;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 8px 16px !important;
        transition: opacity 0.3s ease;
    }

    .editorial-nav-link:hover {
        opacity: 0.5;
    }

    /* --- HESAP (ACCOUNT) DROPDOWN --- */
    .account-wrapper {
        position: relative;
    }

    .account-trigger {
        color: #000000;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding: 8px 16px;
        transition: opacity 0.3s ease;
    }

    .account-trigger:hover {
        opacity: 0.5;
    }

    .account-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        background-color: #ffffff;
        border: 1px solid #000000;
        border-radius: 0;
        min-width: 150px;
        padding: 0;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        box-shadow: none;
        margin-top: 10px;
    }

    .account-wrapper:hover .account-dropdown-menu {
        opacity: 1;
        visibility: visible;
        margin-top: 0;
    }

    .account-dropdown-menu a {
        display: block;
        padding: 12px 20px;
        color: #000000 !important;
        font-size: 10px;
        font-weight: 600;
        text-decoration: none;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        border-bottom: 1px solid #000000;
        transition: all 0.3s ease;
    }

    .account-dropdown-menu a:last-child {
        border-bottom: none;
    }

    .account-dropdown-menu a:hover {
        background-color: #000000;
        color: #ffffff !important;
    }

    /* --- SEPET (CART) BUTONU --- */
    .cart-btn-editorial {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #ffffff;
        border: 1px solid #000000;
        padding: 8px 20px;
        border-radius: 0;
        text-decoration: none !important;
        transition: all 0.3s ease;
    }

    .cart-btn-editorial:hover {
        background: #000000;
    }

    .cart-btn-editorial:hover .cart-icon-wrapper i,
    .cart-btn-editorial:hover .cart-text,
    .cart-btn-editorial:hover .cart-price {
        color: #ffffff;
    }

    .cart-btn-editorial:hover .cart-badge {
        background: #ffffff;
        color: #000000;
    }

    .cart-icon-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .cart-icon-wrapper i {
        font-size: 14px;
        color: #000000;
        transition: color 0.3s ease;
    }

    .cart-badge {
        position: absolute;
        top: -8px;
        right: -12px;
        background: #000000;
        color: #ffffff;
        font-size: 9px;
        font-weight: 600;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0;
        transition: all 0.3s ease;
    }

    .cart-text {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        color: #000000;
        transition: color 0.3s ease;
    }

    .cart-price {
        color: #000000;
        margin-left: 4px;
        transition: color 0.3s ease;
    }

    /* --- MOBİL MENÜ & ANİMASYON --- */
    .mobile-navbar-editorial {
        background: #ffffff;
        border-left: 1px solid #000000;
        z-index: 2000;
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
        display: block !important;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    .mobile-navbar-editorial.menu-active {
        transform: translateX(0);
    }

    .mobile-navbar-editorial a {
        color: #000000 !important;
        font-size: 13px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        transition: opacity 0.3s ease;
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 10px;
    }

    .mobile-navbar-editorial a:hover {
        opacity: 0.5;
    }

    /* --- MOBİL MENÜ ARKA PLAN KARARTMASI (OVERLAY) --- */
    .mobile-menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        z-index: 1999;
        opacity: 0;
        visibility: hidden;
        transition: all 0.4s ease;
    }

    .mobile-menu-overlay.overlay-active {
        opacity: 1;
        visibility: visible;
    }
</style>

<header class="editorial-header">
    <div class="container px-md-5">
        <nav class="navbar navbar-expand-lg d-flex align-items-center justify-content-between p-0">
            <!-- Sol Grup: Logo ve Telefon -->
            <div class="header-left-group">
                <a class="navbar-brand m-0 p-0" asp-controller="Home" asp-action="Index">
                    <img src="~/img/@Model?.Setting?.HeaderLogo" alt="Editorial Logo" style="height: 30px; width: auto; object-fit: contain; filter: grayscale(100%);">
                </a>

                <div class="d-none d-md-flex phone-badge">
                    <i class="bi bi-telephone" style="color: #000000; font-size: 12px;"></i>
                    <span>@Model?.Setting?.Phone</span>
                </div>
            </div>

            <!-- Mobil Menü Açma Butonu -->
            <button class="navbar-toggler" type="button" id="mobile-navbar-show" aria-label="Mobil menüyü aç" style="border: none; outline: none; padding: 0;">
                <i class="bi bi-list" style="color: #000000; font-size: 28px;"></i>
            </button>

            <!-- Masaüstü Navigasyon -->
            <div class="collapse navbar-collapse d-none d-lg-block">
                <ul class="navbar-nav ml-auto align-items-center gap-1">
                    <li class="nav-item"><a class="nav-link editorial-nav-link" asp-controller="Home" asp-action="Index">HOME</a></li>
                    
                    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
                    {
                        <li class="nav-item">
                            <a class="nav-link editorial-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">ADMIN</a>
                        </li>
                    }
                    
                    <li class="nav-item"><a class="nav-link editorial-nav-link" asp-controller="Blog" asp-action="Index">JOURNAL</a></li>

                    <!-- Hesap Dropdown -->
                    <li class="nav-item account-wrapper ml-3">
                        @if (User.Identity is null || !User.Identity.IsAuthenticated)
                        {
                            <div class="account-trigger">
                                ACCOUNT <i class="bi bi-chevron-down" style="font-size: 10px;"></i>
                            </div>
                            <div class="account-dropdown-menu">
                                <a asp-controller="Account" asp-action="Login">LOGIN</a>
                                <a asp-controller="Account" asp-action="Register">REGISTER</a>
                            </div>
                        }
                        else
                        {
                            <div class="account-trigger">
                                @User.Identity.Name.ToUpper() <i class="bi bi-chevron-down" style="font-size: 10px;"></i>
                            </div>
                            <div class="account-dropdown-menu">
                                <a asp-controller="Account" asp-action="Logout">LOGOUT</a>
                            </div>
                        }
                    </li>

                    <!-- Sepet Butonu -->
                    <li class="nav-item ml-4 shop-cart">
                        <a asp-controller="Basket" asp-action="Index" class="cart-btn-editorial">
                            <div class="cart-icon-wrapper">
                                <i class="bi bi-bag"></i>
                                <sup class="cart-badge">@(Model?.BasketCount ?? 0)</sup>
                            </div>
                            <span class="cart-text">BAG <span class="cart-price">[$@(Model?.ProductPrice ?? 0)]</span></span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <!-- Mobil Menü Konteyneri -->
    <div class="mobile-navbar mobile-navbar-editorial position-fixed top-0 right-0 h-100 p-4 shadow-none" style="width:280px;">
        <div class="d-flex justify-content-end mb-5">
            <i class="bi bi-x-lg" id="mobile-navbar-close" aria-label="Mobil menüyü kapat" style="cursor: pointer; color: #000000; font-size: 24px;"></i>
        </div>
        <ul class="list-unstyled d-flex flex-column" style="gap: 20px;">
            <li><a class="nav-link p-0" asp-controller="Home" asp-action="Index">HOME</a></li>
            
            @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) && !User.IsInRole("Member"))
            {
                <li><a class="nav-link p-0" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">ADMIN</a></li>
            }
            
            <li><a class="nav-link p-0" asp-controller="Blog" asp-action="Index">JOURNAL</a></li>
            
            @if (User.Identity is null || !User.Identity.IsAuthenticated)
            {
                <li><a class="nav-link p-0" asp-controller="Account" asp-action="Login">LOGIN</a></li>
                <li><a class="nav-link p-0" asp-controller="Account" asp-action="Register">REGISTER</a></li>
            }
            else
            {
                <li><a class="nav-link p-0" style="color: #767676 !important;">@User.Identity.Name.ToUpper()</a></li>
                <li><a class="nav-link p-0" asp-controller="Account" asp-action="Logout">LOGOUT</a></li>
            }
        </ul>
    </div>
</header>

<!-- MOBİL MENÜ VE OVERLAY İÇİN JAVASCRIPT KONTROLÜ -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const openBtn = document.getElementById("mobile-navbar-show");
        const closeBtn = document.getElementById("mobile-navbar-close");
        const mobileMenu = document.querySelector(".mobile-navbar-editorial");

        let overlay = document.querySelector(".mobile-menu-overlay");
        if (!overlay) {
            overlay = document.createElement("div");
            overlay.classList.add("mobile-menu-overlay");
            document.body.appendChild(overlay);
        }

        function openMobileMenu() {
            if(mobileMenu && overlay) {
                mobileMenu.classList.add("menu-active");
                overlay.classList.add("overlay-active");
                document.body.style.overflow = "hidden"; 
            }
        }

        function closeMobileMenu() {
            if(mobileMenu && overlay) {
                mobileMenu.classList.remove("menu-active");
                overlay.classList.remove("overlay-active");
                document.body.style.overflow = ""; 
            }
        }

        if (openBtn) openBtn.addEventListener("click", openMobileMenu);
        if (closeBtn) closeBtn.addEventListener("click", closeMobileMenu);
        if (overlay) overlay.addEventListener("click", closeMobileMenu);
    });
</script>