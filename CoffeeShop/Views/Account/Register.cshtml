@model RegisterVM

<style>
    /* =========================================
       ZARA / EDITORIAL REGISTER SYSTEM
       ========================================= */
    .editorial-auth-page {
        background-color: #ffffff;
        min-height: 80vh;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #000000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
    }

    .editorial-auth-container {
        width: 100%;
        max-width: 450px;
    }

    .editorial-auth-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .editorial-auth-title {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 32px;
        font-weight: 400;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 15px;
    }

    .editorial-auth-subtitle {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
    }

    /* Validation Summary */
    .editorial-validation-summary {
        margin-bottom: 30px;
    }

    .editorial-validation-summary:not(:empty) {
        border-left: 2px solid #000000;
        padding-left: 15px;
    }

    .editorial-validation-summary ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
    }

    .editorial-validation-summary li {
        color: #000000;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    /* Form Fields */
    .editorial-form-group {
        margin-bottom: 35px;
        position: relative;
    }

    .editorial-label {
        display: block;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 10px;
    }

    .editorial-input {
        width: 100%;
        background-color: transparent !important;
        border: none !important;
        border-bottom: 1px solid #e5e5e5 !important;
        color: #000000 !important;
        padding: 10px 0 !important;
        font-size: 13px;
        border-radius: 0 !important;
        transition: border-color 0.3s ease;
        box-shadow: none !important;
    }

    .editorial-input:focus {
        outline: none !important;
        border-bottom-color: #000000 !important;
        box-shadow: none !important;
    }

    .field-validation-error {
        display: block;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        color: #767676 !important;
        margin-top: 8px;
        text-transform: uppercase;
    }

    /* Button */
    .editorial-btn {
        width: 100%;
        background-color: #000000;
        color: #ffffff;
        border: 1px solid #000000;
        border-radius: 0;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        padding: 18px;
        transition: all 0.3s ease;
        margin-top: 20px;
    }

    .editorial-btn:hover {
        background-color: #ffffff;
        color: #000000;
    }

    /* Footer Links */
    .editorial-auth-footer {
        text-align: center;
        margin-top: 40px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
    }

    .editorial-auth-link {
        color: #000000;
        text-decoration: none;
        border-bottom: 1px solid #000000;
        padding-bottom: 2px;
        margin-left: 10px;
        transition: color 0.3s ease, border-color 0.3s ease;
    }

    .editorial-auth-link:hover {
        color: #767676;
        border-bottom-color: #767676;
    }
</style>

<div class="editorial-auth-page">
    <div class="editorial-auth-container">
        
        <div class="editorial-auth-header">
            <h1 class="editorial-auth-title">Register</h1>
            <div class="editorial-auth-subtitle">Create your personal account</div>
        </div>
        
        <form asp-controller="Account" asp-action="Register" method="post">
            
            <!-- VALIDATION SUMMARY -->
            <div asp-validation-summary="ModelOnly" class="editorial-validation-summary"></div>

            <!-- Full Name -->
            <div class="editorial-form-group">
                <label asp-for="FullName" class="editorial-label">Full Name</label>
                <input asp-for="FullName" class="editorial-input" autocomplete="off" />
                <span asp-validation-for="FullName"></span>
            </div>

            <!-- Username -->
            <div class="editorial-form-group">
                <label asp-for="UserName" class="editorial-label">Username</label>
                <input asp-for="UserName" class="editorial-input" autocomplete="off" />
                <span asp-validation-for="UserName"></span>
            </div>

            <!-- Email -->
            <div class="editorial-form-group">
                <label asp-for="Email" class="editorial-label">E-Mail</label>
                <input asp-for="Email" class="editorial-input" type="email" autocomplete="off" />
                <span asp-validation-for="Email"></span>
            </div>

            <!-- Password -->
            <div class="editorial-form-group">
                <label asp-for="Password" class="editorial-label">Password</label>
                <input asp-for="Password" class="editorial-input" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <!-- Confirm Password -->
            <div class="editorial-form-group">
                <label asp-for="ConfirmPassword" class="editorial-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="editorial-input" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="editorial-btn">
                Create Account
            </button>

            <div class="editorial-auth-footer">
                Already registered?
                <a asp-controller="Account" asp-action="Login" class="editorial-auth-link">
                    Log in
                </a>
            </div>
        </form>

    </div>
</div>