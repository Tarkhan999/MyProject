@model LoginVM

<style>
    /* =========================================
       ZARA / EDITORIAL LOGIN SYSTEM
       ========================================= */
    .editorial-auth-page {
        background-color: #ffffff;
        min-height: 80vh;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #000000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
    }

    .editorial-auth-container {
        width: 100%;
        max-width: 450px;
    }

    .editorial-auth-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .editorial-auth-title {
        font-family: 'Didot', 'Bodoni MT', 'Times New Roman', serif;
        font-size: 32px;
        font-weight: 400;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 15px;
    }

    .editorial-auth-subtitle {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
    }

    /* Validation Summary */
    .editorial-validation-summary {
        margin-bottom: 30px;
    }

    .editorial-validation-summary:not(:empty) {
        border-left: 2px solid #000000;
        padding-left: 15px;
    }

    .editorial-validation-summary ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
    }

    .editorial-validation-summary li {
        color: #000000;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    /* Form Fields */
    .editorial-form-group {
        margin-bottom: 35px;
        position: relative;
    }

    .editorial-label {
        display: block;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #000000;
        margin-bottom: 10px;
    }

    .editorial-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .editorial-input {
        width: 100%;
        background-color: transparent !important;
        border: none !important;
        border-bottom: 1px solid #e5e5e5 !important;
        color: #000000 !important;
        padding: 10px 30px 10px 0 !important;
        font-size: 13px;
        border-radius: 0 !important;
        transition: border-color 0.3s ease;
        box-shadow: none !important;
    }

    .editorial-input:focus {
        outline: none !important;
        border-bottom-color: #000000 !important;
        box-shadow: none !important;
    }

    .toggle-password {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        color: #767676;
        font-size: 14px;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .toggle-password:hover {
        color: #000000;
    }

    .field-validation-error {
        display: block;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        color: #767676 !important;
        margin-top: 8px;
        text-transform: uppercase;
    }

    /* Forgot Password */
    .editorial-forgot-password {
        display: block;
        text-align: right;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #767676;
        text-decoration: none;
        margin-top: -20px;
        margin-bottom: 35px;
        transition: color 0.3s ease;
    }

    .editorial-forgot-password:hover {
        color: #000000;
    }

    /* Button */
    .editorial-btn {
        width: 100%;
        background-color: #000000;
        color: #ffffff;
        border: 1px solid #000000;
        border-radius: 0;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 3px;
        text-transform: uppercase;
        padding: 18px;
        transition: all 0.3s ease;
    }

    .editorial-btn:hover {
        background-color: #ffffff;
        color: #000000;
    }

    /* Footer Links */
    .editorial-auth-footer {
        text-align: center;
        margin-top: 40px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #767676;
    }

    .editorial-auth-link {
        color: #000000;
        text-decoration: none;
        border-bottom: 1px solid #000000;
        padding-bottom: 2px;
        margin-left: 10px;
        transition: color 0.3s ease, border-color 0.3s ease;
    }

    .editorial-auth-link:hover {
        color: #767676;
        border-bottom-color: #767676;
    }
</style>

<div class="editorial-auth-page">
    <div class="editorial-auth-container">
        
        <div class="editorial-auth-header">
            <h1 class="editorial-auth-title">Log In</h1>
            <div class="editorial-auth-subtitle">Access your account</div>
        </div>
        
        <form asp-controller="Account" asp-action="Login" method="post">
            
            <!-- VALIDATION SUMMARY -->
            <div asp-validation-summary="ModelOnly" class="editorial-validation-summary"></div>

            <!-- Email or Username -->
            <div class="editorial-form-group">
                <label asp-for="EmailOrUserName" class="editorial-label">Email or Username</label>
                <input asp-for="EmailOrUserName" class="editorial-input" autocomplete="off" />
                <span asp-validation-for="EmailOrUserName"></span>
            </div>

            <!-- Password -->
            <div class="editorial-form-group">
                <label asp-for="Password" class="editorial-label">Password</label>
                <div class="editorial-input-wrapper">
                    <input asp-for="Password" class="editorial-input" type="password" id="passwordInput" autocomplete="current-password" />
                    <i class="fas fa-eye toggle-password" id="togglePasswordIcon" title="Show/Hide Password"></i>
                </div>
                <span asp-validation-for="Password"></span>
            </div>

            <!-- Forgot Password -->
            <a href="#" class="editorial-forgot-password">Forgot Password?</a>

            <!-- Submit Button -->
            <button type="submit" class="editorial-btn">
                Log In
            </button>

            <div class="editorial-auth-footer">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register" class="editorial-auth-link">
                    Register
                </a>
            </div>
        </form>

    </div>
</div>

<!-- ŞİFRE GÖSTER/GİZLE SCRİPTİ -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const togglePasswordIcon = document.getElementById("togglePasswordIcon");
        const passwordInput = document.getElementById("passwordInput");

        if (togglePasswordIcon && passwordInput) {
            togglePasswordIcon.addEventListener("click", function () {
                const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
                passwordInput.setAttribute("type", type);
                
                this.classList.toggle("fa-eye");
                this.classList.toggle("fa-eye-slash");
            });
        }
    });
</script>