@model BasketUIVM

<div class="container mt-5 mb-5">
    
    @if (Model.Items.Count > 0)
    {
        <table class="table table-bordered table-striped text-center">
            <thead class="thead-dark">
            <tr>
                <th scope="col">Image</th>
                <th scope="col">Name</th>
                <th scope="col">Count</th>
                <th scope="col">Category</th>
                <th scope="col">Price</th>
                <th scope="col">Operations</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="align-middle">
                        <img src="~/img/@item.ProductImage" style="width: 100px; height: 100px; object-fit: cover; border-radius: 5px;"/>
                    </td>
                    <td class="align-middle">@item.ProductName</td>
                    
                    <!-- COUNT KISMI -->
                    <td class="align-middle">
                        <div class="d-flex align-items-center justify-content-center">
                            <!-- Azaltma Butonu (-) -->
                            <button class="btn btn-sm btn-outline-danger decrease-basket-btn" data-id="@item.ProductId" style="width: 35px;">
                                <i class="fas fa-minus"></i>
                            </button>
                            
                            <!-- Miktar -->
                            <span class="mx-3 font-weight-bold" style="font-size: 1.1rem;">@item.ProductCount</span>
                            
                            <!-- Artırma Butonu (+) -->
                            <button class="btn btn-sm btn-outline-success increase-basket-btn" data-id="@item.ProductId" style="width: 35px;">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </td>
                    
                    <td class="align-middle">@item.CategoryName</td>
                    <td class="align-middle">$@item.ProductPrice</td>
                    <td class="align-middle">
                        <button data-id="@item.ProductId" class="btn btn-danger delete-basket-btn">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        
      
            <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded shadow-sm">
                <h3 class="m-0">Total: <span class="text-success">$@Model.Total</span></h3>
    
                <!-- Yeni Checkout Butonu -->
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-success btn-lg px-5 fw-bold rounded-pill">
                    <i class="fas fa-credit-card me-2"></i> Proceed to Checkout
                </a>
            </div>
       
    }
    else
    {
        <div class="alert alert-warning text-center" role="alert">
            Your cart is currently empty! 
            <br />
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Continue Shopping</a>
        </div>
    }
</div>
<!-- Önce jQuery yüklenmeli -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- Sonra senin kendi JavaScript dosyan yüklenmeli -->
<script src="~/js/script.js?v=2"></script>
