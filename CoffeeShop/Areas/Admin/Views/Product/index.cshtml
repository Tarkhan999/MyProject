@model IEnumerable<ProductVM>

<!-- Eğer projenizde Bootstrap Icons yoksa sayfaya dahil etmesi için bu satırı kullanabilirsiniz (Genelde _Layout.cshtml içine eklenir) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    
    <!-- Başlık ve Buton Satırı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-box-seam me-2"></i>Products
        </h2>
        <a class="btn btn-success rounded-pill px-4 shadow-sm" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> Add New Product
        </a>
    </div>

    <!-- Tablo Kartı -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 text-secondary">Image</th>
                        <th class="py-3 text-secondary">Name</th>
                        <th class="py-3 text-secondary">Description</th>
                        <th class="py-3 text-secondary">Price</th>
                        <th class="py-3 text-secondary">Category</th>
                        <th class="py-3 text-center text-secondary">Actions</th> 
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Resim -->
                        <td class="px-4 py-3">
                            <img src="~/img/@item.MainImage" 
                                 class="rounded-3 shadow-sm" 
                                 style="width: 80px; height: 80px; object-fit: cover;" 
                                 alt="@item.Name" />
                        </td>
                        
                        <!-- İsim -->
                        <td class="fw-semibold text-dark">@item.Name</td>
                        
                        <!-- Açıklama (Çok uzunsa 3 nokta koyarak kırpar) -->
                        <td class="text-muted" style="max-width: 250px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                            @item.Description
                        </td>
                        
                        <!-- Fiyat (Şık bir yeşil badge) -->
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fs-6">
                                $@item.Price
                            </span>
                        </td>
                        
                        <!-- Kategori (Mavi hap şeklinde badge) -->
                        <td>
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2">
                                @item.CategoryName
                            </span>
                        </td>
                           
                        <!-- Operasyonlar (İkonlu, birleşik buton grubu) -->
                        <td class="text-center">
                            <div class="btn-group shadow-sm rounded-pill" role="group">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark px-3" title="Detail">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3" onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?');" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        
        <!-- Eğer Ürün Yoksa Gösterilecek Boş Durum Tasarımı (Opsiyonel ama çok profesyonel durur) -->
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                <h5>No products found</h5>
                <p>Click the "Add New Product" button to get started.</p>
            </div>
        }
    </div>
</div>