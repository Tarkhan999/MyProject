@model  FiorelloBackendPractice.ViewModels.About.AboutEditVM

<div class="container mt-5">
    <h2>About Düzenle</h2>
    <hr />
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        
        <div class="mb-3">
            <label class="form-label d-block">Mevcut Görsel</label>
            <img src="~/img/@Model.ExistingImageUrl" style="width: 150px; border-radius: 10px;" class="mb-2 shadow-sm" />
            <input type="hidden" asp-for="ExistingImageUrl" />
        </div>

        <div class="mb-3">
            <label asp-for="Photo" class="form-label">Yeni Görsel Yükle (Değiştirmek istemiyorsanız boş bırakın)</label>
            <input asp-for="Photo" class="form-control" type="file" accept="image/*" />
            <span asp-validation-for="Photo" class="text-danger"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Başlık</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="HighlightedText" class="form-label">Yeşil Vurgulu Metin</label>
            <input asp-for="HighlightedText" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PointText" class="form-label">Madde Metni</label>
            <input asp-for="PointText" class="form-control" />
        </div>

        <button type="submit" class="btn btn-warning">Güncelle</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>