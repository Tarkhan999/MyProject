@model FiorelloBackendPractice.Models.About

<div class="container-fluid pt-4 px-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <h4 class="card-title mb-0 fw-bold">Hakkımızda Detay Görünümü</h4>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <i class="bi bi-arrow-left me-1"></i> Geri Dön
                </a>
            </div>

            <div class="row align-items-center mt-4">
                <!-- Sol Kısım: Görsel -->
                <div class="col-md-5 mb-4 mb-md-0">
                    <img src="~/img/@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm w-100 object-fit-cover" style="max-height: 400px; border: 1px solid #eaeaea;" alt="About Image">
                </div>
                
                <!-- Sağ Kısım: Metin Bilgileri -->
                <div class="col-md-7 ps-md-4">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle">
                            <tbody>
                                <tr>
                                    <th style="width: 140px; color: #6c757d;">Başlık:</th>
                                    <td class="fs-4 fw-bold">
                                        @Model.Title <span class="text-success">@Model.HighlightedText</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th style="color: #6c757d;">Açıklama:</th>
                                    <td class="fs-6" style="line-height: 1.8;">@Model.Description</td>
                                </tr>
                                <tr>
                                    <th style="color: #6c757d;">Öne Çıkan Not:</th>
                                    <td>
                                        <div class="d-inline-flex align-items-center bg-success bg-opacity-10 text-success px-3 py-2 rounded-3">
                                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                            <span class="fw-medium">@Model.PointText</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 pt-4 border-top">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-3 px-4">
                            <i class="bi bi-pencil me-1"></i> İçeriği Güncelle
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>