@model List<FiorelloBackendPractice.ViewModels.Expert.ExpertVM>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="card-title mb-0">Uzmanlar Listesi</h4>
            <a asp-action="Create" class="btn btn-success rounded-3"><i class="bi bi-plus-lg"></i> Yeni Uzman Ekle</a>
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                <tr>
                    <th>Resim</th>
                    <th>Ad Soyad</th>
                    <th>Pozisyon</th>
                    <th>İşlemler</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="~/img/@item.ImageUrl" style="width:50px; height:50px; object-fit:cover; border-radius:50%;" alt="@item.FullName" />
                        </td>
                        <td class="fw-bold">@item.FullName</td>
                        <td>@item.Position</td>
                        <td>
                            <!-- Detay butonu buraya eklendi -->
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white rounded-3 me-1"><i class="bi bi-eye"></i> Detay</a>
                            
                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning rounded-3 me-1">
                                <i class="bi bi-pencil"></i> Güncelle
                            </a>
                            
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger rounded-3" onclick="return confirm('Silmek istediğinize emin misiniz?');"><i class="bi bi-trash"></i> Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>