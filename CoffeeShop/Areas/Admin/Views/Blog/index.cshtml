@model List<FiorelloBackendPractice.ViewModels.Blog.BlogVM>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="card-title m-0 fw-bold text-white">BLOG LİSTESİ</h4>
            <a asp-action="Create" class="btn btn-primary rounded-3">
                <i class="bi bi-plus-lg me-1"></i> Yeni Blog Ekle
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <!-- Tablo Başlıkları Koyu Arka Plan ile Görünür Yapıldı -->
                <thead style="background-color: #191c24;">
                    <tr>
                        <th style="color: #ffffff !important;" class="fw-bold">Görsel</th>
                        <th style="color: #ffffff !important;" class="fw-bold">Başlık</th>
                        <th style="color: #ffffff !important;" class="fw-bold">Okunma</th>
                        <th style="color: #ffffff !important;" class="fw-bold">Tarih</th>
                        <th style="color: #ffffff !important;" class="fw-bold">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="~/img/@item.Image" style="width:70px; height:50px; object-fit:cover; border-radius:8px;" />
                                </td>
                                <td class="fw-bold">@item.Title</td>
                                <td>
                                    <span class="badge bg-primary px-3 py-2 fs-6">@item.ViewsCount</span>
                                </td>
                                <td>@item.DateCreated.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <!-- Detay Butonu -->
                                    <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white rounded-3 px-3 me-1">
                                        <i class="bi bi-eye-fill me-1"></i> Detay
                                    </a>
                                    
                                    <!-- Düzenle Butonu (Yazı Eklendi) -->
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark fw-bold rounded-3 px-3 me-1">
                                        <i class="bi bi-pencil-fill me-1"></i> Düzenle
                                    </a>
                                    
                                    <!-- Sil Butonu (Yazı Eklendi) -->
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger rounded-3 px-3" onclick="return confirm('Bu blogu silmek istediğinize emin misiniz?');">
                                            <i class="bi bi-trash-fill me-1"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Henüz blog eklenmedi.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>