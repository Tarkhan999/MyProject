<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    /* Modern, yumuşak geçişler ve gölgeler */
    body {
        background-color: #f8f9fa; /* Arka planı hafif gri yaparak beyaz kartları öne çıkarıyoruz */
    }
    
    .modern-hero {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border: none;
    }
    
    .hero-shape {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        z-index: 0;
    }
    
    .dashboard-card {
        background: #ffffff;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.03);
    }
    
    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.12) !important;
        border-color: rgba(0,0,0,0.08);
    }

    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        transition: transform 0.3s ease;
    }
    
    .dashboard-card:hover .icon-box {
        transform: scale(1.1);
    }

    .card-link-text {
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }
    
    .dashboard-card:hover .card-link-text i {
        transform: translateX(4px);
    }
    
    .card-link-text i {
        transition: transform 0.3s ease;
    }
</style>

<div class="container py-5">
    
    <!-- Modern Hero Section -->
    <div class="modern-hero p-5 rounded-5 shadow-lg mb-5 position-relative overflow-hidden text-white">
        <!-- Dekoratif Arka Plan Şekilleri -->
        <div class="hero-shape" style="width: 300px; height: 300px; top: -100px; right: -50px;"></div>
        <div class="hero-shape" style="width: 150px; height: 150px; bottom: -50px; left: 10%;"></div>
        
        <div class="position-relative d-flex align-items-center" style="z-index: 1;">
            <div class="bg-white bg-opacity-25 p-3 rounded-4 me-4 shadow-sm backdrop-blur">
                <i class="bi bi-grid-1x2-fill fs-1 text-white"></i>
            </div>
            <div>
                <h1 class="fw-bold mb-1 display-6">Admin Workspace</h1>
                <p class="mb-0 text-white-50 fs-5">Sistem durumunu ve içerikleri tek bir yerden yönetin.</p>
            </div>
        </div>
    </div>

    <!-- Modüler Izgara Sistemi (Grid) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        
        <!-- Products -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-success bg-opacity-10 text-success mb-3">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Products</h5>
                    <p class="text-muted small mb-4">Mağazanızdaki tüm ürünleri ekleyin, güncelleyin veya kaldırın.</p>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="mt-auto fw-bold text-success text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage Products <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Categories -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-warning bg-opacity-10 text-warning mb-3">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Categories</h5>
                    <p class="text-muted small mb-4">Ürün kategorilerini ve hiyerarşiyi düzenleyin.</p>
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="mt-auto fw-bold text-warning text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage Categories <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Slider -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-danger bg-opacity-10 text-danger mb-3">
                        <i class="bi bi-images fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Slider</h5>
                    <p class="text-muted small mb-4">Ana sayfadaki kaydırıcı görsellerini ve metinlerini yönetin.</p>
                    <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="mt-auto fw-bold text-danger text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage Slider <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- About -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-info bg-opacity-10 text-info mb-3">
                        <i class="bi bi-info-square fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">About</h5>
                    <p class="text-muted small mb-4">Hakkımızda sayfasının içeriklerini ve vizyon yazılarını güncelleyin.</p>
                    <a asp-area="Admin" asp-controller="About" asp-action="Index" class="mt-auto fw-bold text-info text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage About <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Expert -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-secondary bg-opacity-10 text-secondary mb-3">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Expert</h5>
                    <p class="text-muted small mb-4">Ekibinizdeki uzman profillerini ve yetkinliklerini düzenleyin.</p>
                    <a asp-area="Admin" asp-controller="Expert" asp-action="Index" class="mt-auto fw-bold text-secondary text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage Expert <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Subscribe Info -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-card-heading fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Subscribe Info</h5>
                    <p class="text-muted small mb-4">Bülten aboneliği bölümündeki başlık ve açıklamaları kontrol edin.</p>
                    <a asp-area="Admin" asp-controller="SubscribeInfo" asp-action="Index" class="mt-auto fw-bold text-primary text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage Section <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Subscribers -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-dark bg-opacity-10 text-dark mb-3">
                        <i class="bi bi-envelope-paper fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Subscribers</h5>
                    <p class="text-muted small mb-4">E-posta bülteninize kayıt olan kullanıcı listesini görüntüleyin.</p>
                    <a asp-area="Admin" asp-controller="Subscriber" asp-action="Index" class="mt-auto fw-bold text-dark text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage Subscribers <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Blog -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box" style="background-color: #ffe4e6; color: #e11d48; margin-bottom: 1rem;">
                        <i class="bi bi-journal-richtext fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Blog</h5>
                    <p class="text-muted small mb-4">Yeni makaleler yazın, mevcut blog gönderilerini düzenleyin.</p>
                    <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="mt-auto fw-bold text-decoration-none stretched-link card-link-text d-flex align-items-center" style="color: #e11d48;">
                        Manage Blog <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Instagram -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box text-white mb-3" style="background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);">
                        <i class="bi bi-instagram fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Instagram</h5>
                    <p class="text-muted small mb-4">Sitede sergilenen Instagram akışını ve bağlantıları yönetin.</p>
                    <a asp-area="Admin" asp-controller="Instagram" asp-action="Index" class="mt-auto fw-bold text-decoration-none stretched-link card-link-text d-flex align-items-center" style="color: #dc2743;">
                        Manage Instagram <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Site Settings -->
        <div class="col">
            <div class="card h-100 rounded-4 shadow-sm dashboard-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-gear-wide-connected fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Site Settings</h5>
                    <p class="text-muted small mb-4">Logo, iletişim bilgileri ve genel site yapılandırmasını ayarlayın.</p>
                    <a asp-area="Admin" asp-controller="Setting" asp-action="Index" class="mt-auto fw-bold text-primary text-decoration-none stretched-link card-link-text d-flex align-items-center">
                        Manage Settings <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        
    </div>
</div>