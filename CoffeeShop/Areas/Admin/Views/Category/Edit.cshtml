@model CategoryEditVM

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Form Kartı -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                
                <!-- Kart Başlığı -->
                <div class="card-header bg-primary bg-opacity-10 border-0 p-4 text-center">
                    <h3 class="fw-bold text-primary mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edit Category
                    </h3>
                </div>

                <!-- Form İçeriği -->
                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-action="Edit">
                        
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary">Category Name</label>
                            <div class="input-group input-group-lg shadow-sm">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-tag"></i>
                                </span>
                                <input asp-for="Name" class="form-control border-start-0 ps-0">
                            </div>
                            <span class="text-danger small mt-1 d-block fw-semibold" asp-validation-for="Name"></span>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex gap-3 mt-5">
                            <button type="submit" class="btn btn-primary rounded-pill w-50 py-2 shadow-sm fw-bold">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-light rounded-pill w-50 py-2 text-dark fw-semibold border">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</div>